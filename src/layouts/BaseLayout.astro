---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Vlady Yakovenko — UX Engineer, Artist, Musician',
  description = 'Portfolio of Vlady Yakovenko (polyterative) — UX engineer, generative visual artist, and electronic musician based in Bologna, Italy.',
  ogImage = '/og-default.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <nav class="nav">
        <a href="/" class="nav__logo">polyterative</a>
        <ul class="nav__links">
          <li><a href="/#patcher">Patcher</a></li>
          <li><a href="/#work">Code</a></li>
          <li><a href="/#sound">Sound</a></li>
          <li><a href="/#visuals">Visuals</a></li>
          <li><a href="/blog">Writing</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <p class="footer-copy">Vlady Yakovenko &mdash; Bologna, Italy</p>
        <ul class="footer-links">
          <li><a href="https://github.com/polyterative" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://polyterative.bandcamp.com" target="_blank" rel="noopener">Bandcamp</a></li>
          <li><a href="https://www.instagram.com/politerative/" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://patcher.xyz" target="_blank" rel="noopener">patcher.xyz</a></li>
        </ul>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-4);
    backdrop-filter: blur(8px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__logo {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .nav__links {
    display: flex;
    list-style: none;
    gap: var(--space-6);
  }

  .nav__links a {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .nav__links a:hover { color: var(--color-text); }

  .site-main { flex: 1; }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8);
    margin-top: var(--space-24);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copy {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    list-style: none;
    gap: var(--space-6);
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footer-links a:hover { color: var(--color-text); }

  @media (max-width: 600px) {
    .nav__links { display: none; }
  }
</style>
