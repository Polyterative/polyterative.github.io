---
import { getCollection } from 'astro:content';
import { apps } from '../data/apps';
import { releases } from '../data/releases';
import { sections, sectionFor, isoDots, hex } from '../lib/datum';

export interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  /** Document serial shown in the classification line, e.g. "PLY-W-019". Derived by the page from real data. */
  serial?: string;
  /** Share image path or URL. Defaults to the branded site card. */
  image?: string;
  /** Start scroll-in animations well before blocks reach the viewport (long pages). */
  revealEarly?: boolean;
  imageAlt?: string;
  /** "article" for blog posts adds article:* tags. */
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  noindex?: boolean;
  /** Breadcrumb trail for BreadcrumbList structured data, root first. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title = 'Vlady Yakovenko — Designer, engineer, musician',
  description = 'Notes, projects, and ongoing work by Vlady Yakovenko (polyterative) across software, visuals, music, and interaction design.',
  isHome = false,
  serial,
  image = '/og/default.png',
  revealEarly = false,
  imageAlt,
  type = 'website',
  publishedTime,
  tags = [],
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site).href;
const currentPath = Astro.url.pathname;
const section = sectionFor(currentPath);

// Footer readout: real counts from the repo's data files, and the build date.
const postCount = (await getCollection('blog', ({ data }) => !data.draft)).length;
const buildDate = new Date();
const buildStamp = isoDots(buildDate);
const docSerial = serial ?? `PLY-${section.code}`;

const navLinks = sections.map((s, i) => ({ ...s, index: hex(i + 1) }));

const breadcrumbSchema = breadcrumbs.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.path, Astro.site).href,
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'polyterative',
  url: 'https://polyterative.github.io',
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Vlady Yakovenko' },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vlady Yakovenko',
  alternateName: 'polyterative',
  url: 'https://polyterative.github.io',
  sameAs: [
    'https://github.com/polyterative',
    'https://polyterative.bandcamp.com',
    'https://www.instagram.com/polyterative/',
    'https://patcher.xyz',
  ],
  jobTitle: 'Product Designer',
  description: 'Designer working across software, visuals, music, and interaction systems.',
  address: { '@type': 'PostalAddress', addressLocality: 'Castelfranco Emilia', addressCountry: 'IT' },
  email: 'polyterative@outlook.com',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Vlady Yakovenko" />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={type} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:alt" content={imageAlt ?? title} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === 'article' && <meta property="article:author" content="Vlady Yakovenko" />}
  {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="polyterative" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt ?? title} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Theme color (kept in sync by the resolver below): Paper bg / Instrument bg -->
  <meta name="theme-color" content="#EDEDEA" id="theme-color-meta" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="polyterative — Writing" href="/rss.xml" />

  <!-- Fonts: Departure Mono (self-hosted, OFL) for plates ≥20px; IBM Plex Mono (OFL) for all small mono. -->
  <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" />

  <!-- Pre-paint theme resolver: follows the OS (Paper / Instrument) unless the visitor chose one.
       Runs before first paint to avoid a flash. CSS also handles the no-JS case via prefers-color-scheme. -->
  <script is:inline>
    (function () {
      try {
        var params = new URLSearchParams(location.search);
        var override = params.get('theme');
        var mode = override || localStorage.getItem('theme') || 'auto';
        if (mode !== 'auto' && mode !== 'light' && mode !== 'dark') mode = 'auto';
        var resolved = mode;
        if (mode === 'auto') {
          resolved = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        var el = document.documentElement;
        el.dataset.theme = resolved;
        el.dataset.themeMode = mode;
        var m = document.getElementById('theme-color-meta');
        if (m) m.setAttribute('content', resolved === 'dark' ? '#0A0A0A' : '#EDEDEA');
      } catch (e) {}
    })();
  </script>

  {isHome && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    </>
  )}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  <slot name="head" />

  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="container container--wide">
      <div class="classline">
        <span class="lbl classline__l">Vlady Yakovenko · Personal archive</span>
        <span class="lbl classline__r">
          <span>§{section.index} {section.label}</span>
          <span class="classline__sep" aria-hidden="true">·</span>
          <span>{docSerial}</span>
          <span class="classline__sep" aria-hidden="true">·</span>
          <span class="inv">Public</span>
        </span>
      </div>
      <div class="titleblock">
        <a href="/" class="titleblock__name" aria-label="polyterative — home">
          <span class="lbl">{hex(0)} · Index</span>
          <span class="titleblock__word">polyterative</span>
        </a>
        <nav class="titleblock__nav" aria-label="Main navigation">
          <ul class="nav__links">
            {navLinks.map(link => {
              const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={['nav__link', { 'nav__link--active': isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    <span class="lbl" aria-hidden="true">{link.index}</span>
                    <span class="nav__text">{link.label}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="titleblock__theme">
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Colour theme: follow system. Click to change.">
            <span class="lbl" aria-hidden="true">Theme</span>
            <span class="theme-toggle__val" id="theme-toggle-val">Auto</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="site-main" id="main-content" tabindex="-1" data-reveal-early={revealEarly ? "" : undefined}>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container container--wide">
      <div class="footstrip">
        <div><span class="lbl">Page</span><span class="data">{currentPath}</span></div>
        <div><span class="lbl">Section</span><span class="data">§{section.index} {section.label}</span></div>
        <div><span class="lbl">Doc</span><span class="data">{docSerial}</span></div>
        <div><span class="lbl">Built</span><span class="data"><time datetime={buildDate.toISOString().slice(0, 10)}>{buildStamp}</time></span></div>
        <div><span class="lbl">Record</span><span class="data">{postCount} posts · {apps.length} apps · {releases.length} releases</span></div>
        <div><span class="lbl">Base</span><span class="data">Castelfranco Emilia, IT</span></div>
      </div>
      <div class="footer-inner">
        <p class="footer-copy">Software, notes, music, ongoing work.</p>
        <ul class="footer-links">
          <li><a class="act" href="mailto:polyterative@outlook.com">Email</a></li>
          <li><a class="act" href="https://github.com/polyterative" target="_blank" rel="noopener">GitHub</a></li>
          <li><a class="act" href="https://polyterative.bandcamp.com" target="_blank" rel="noopener">Bandcamp</a></li>
          <li><a class="act" href="https://www.instagram.com/polyterative/" target="_blank" rel="noopener">Instagram</a></li>
          <li><a class="act" href="https://patcher.xyz" target="_blank" rel="noopener">patcher.xyz</a></li>
          <li><a class="act" href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <p class="footer-meta lbl">polyterative &copy; {buildDate.getFullYear()} · polyterative@outlook.com</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.site-main section ~ section, .site-main section section, .site-main article, .site-main .mod, .site-main li');
      if (!('IntersectionObserver' in window)) return;
      document.documentElement.classList.add('js');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: document.querySelector('[data-reveal-early]') ? '0px 0px 80% 0px' : '0px 0px -8% 0px' });
      // First screen: trace in the visible blocks child by child, in reading order.
      // Home skips this — its cover boot sequence queues the above-the-fold content itself.
      var first = document.querySelector('.site-main .container');
      if (first && !document.querySelector('.cover')) {
        var n = 0;
        Array.prototype.forEach.call(first.children, function (block) {
          if (block.getBoundingClientRect().top >= innerHeight || block.tagName === 'SCRIPT') return;
          var parts = block.children.length ? block.children : [block];
          Array.prototype.forEach.call(parts, function (el) {
            el.style.setProperty('--i', Math.min(n++, 14));
            el.setAttribute('data-reveal', '');
            el.classList.add('is-in');
          });
        });
      }
      els.forEach(function (el) {
        if (el.getBoundingClientRect().top < innerHeight || el.hasAttribute('data-reveal')) return;
        var sib = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
        el.style.setProperty('--i', Math.min(sib, 6));
        el.setAttribute('data-reveal', '');
        io.observe(el);
      });
    })();
  </script>

  <script is:inline>
    // Idle: the page's big index plate (0x06, No. 018, III…) re-reads itself now and then —
    // its digits cycle through their own counting system and settle back. Home has the cover instead.
    (function () {
      var el = document.querySelector('.page-head__idx, .hero__idx, .showcase-hero__idx');
      if (!el || document.querySelector('.cover')) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var text = el.textContent.trim();
      var hex = /^0x/i.test(text), roman = /^[IVXLCDM]+$/.test(text);
      var start = hex ? 2 : 0;
      function pool(c) {
        if (hex) return '0123456789ABCDEF';
        if (roman) return 'IVXLC';
        return /[0-9]/.test(c) ? '0123456789' : null;
      }
      function reread() {
        var frame = 0, total = 14;
        var id = setInterval(function () {
          frame++;
          el.textContent = text.split('').map(function (c, i) {
            var p = i >= start && pool(c);
            if (!p || frame > total * (i + 1) / text.length) return c;
            return p[(Math.random() * p.length) | 0];
          }).join('');
          if (frame >= total) { clearInterval(id); el.textContent = text; }
        }, 45);
      }
      function loop() {
        if (!document.hidden) reread();
        setTimeout(loop, 8000 + Math.random() * 5000);
      }
      setTimeout(loop, 3500);
    })();
  </script>

  <script is:inline>
    (function () {
      var order = ['auto', 'light', 'dark'];
      var names = { auto: 'Auto', light: 'Paper', dark: 'Instrument' };
      var btn = document.getElementById('theme-toggle');
      var val = document.getElementById('theme-toggle-val');
      if (!btn) return;
      var el = document.documentElement;
      var meta = document.getElementById('theme-color-meta');
      var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

      function resolve(mode) {
        if (mode !== 'auto') return mode;
        return mq && mq.matches ? 'dark' : 'light';
      }
      function apply(mode) {
        var resolved = resolve(mode);
        el.dataset.theme = resolved;
        el.dataset.themeMode = mode;
        if (val) val.textContent = names[mode];
        btn.setAttribute('aria-label', 'Colour theme: ' + (mode === 'auto' ? 'follow system (' + names[resolved] + ')' : names[mode]) + '. Click to change.');
        if (meta) meta.setAttribute('content', resolved === 'dark' ? '#0A0A0A' : '#EDEDEA');
      }
      apply(el.dataset.themeMode || 'auto');

      if (mq) {
        var onChange = function () { if ((el.dataset.themeMode || 'auto') === 'auto') apply('auto'); };
        if (mq.addEventListener) mq.addEventListener('change', onChange); else if (mq.addListener) mq.addListener(onChange);
      }

      btn.addEventListener('click', function () {
        var current = el.dataset.themeMode || 'auto';
        var next = order[(order.indexOf(current) + 1) % order.length];
        try { localStorage.setItem('theme', next); } catch (e) {}
        apply(next);
      });
    })();
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  /* ── Header: a title block, not a sticky toolbar ── */
  .site-header { padding-top: var(--space-4); }

  .classline {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-2);
  }
  .classline__r { display: inline-flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; }
  .classline__sep { color: var(--rule-strong); }

  .titleblock {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr) auto;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .titleblock > * { min-width: 0; }

  .titleblock__name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-2) var(--space-3) var(--space-3) 0;
    border-right: 1px solid var(--rule);
  }
  .titleblock__word {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
  }
  .titleblock__name:hover .titleblock__word { color: var(--signal-text); }

  .nav__links {
    display: flex;
    list-style: none;
    height: 100%;
  }
  .nav__links li { display: flex; }
  .nav__link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2px;
    min-width: 88px;
    padding: var(--space-2) var(--space-4) var(--space-3) var(--space-3);
    border-right: 1px solid var(--rule);
    color: var(--ink-2);
    position: relative;
  }
  .nav__text {
    font-family: var(--f-grotesk);
    font-weight: 500;
    font-size: var(--fs-control);
    line-height: 1.2;
  }
  .nav__link:hover { color: var(--ink); background: var(--hover); }
  .nav__link--active { color: var(--ink); }
  .nav__link--active .lbl { color: var(--signal-text); }
  .nav__link--active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--signal);
  }

  .titleblock__theme { display: flex; border-left: 1px solid var(--rule); }
  .theme-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2px;
    min-width: 104px;
    min-height: 40px;
    padding: var(--space-2) 0 var(--space-3) var(--space-3);
    background: transparent;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
  }
  .theme-toggle__val {
    font-family: var(--f-grotesk);
    font-weight: 500;
    font-size: var(--fs-control);
    line-height: 1.2;
  }
  .theme-toggle:hover { background: var(--hover); }

  .site-main { flex: 1; }

  /* ── Footer strip: fixed position, real metadata ── */
  .site-footer { margin-top: var(--space-24); padding-bottom: var(--space-8); }
  .footstrip {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .footstrip > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-2) var(--space-3) var(--space-3);
    border-right: 1px solid var(--rule);
    min-width: 0;
  }
  .footstrip > div:first-child { padding-left: 0; }
  .footstrip > div:last-child { border-right: 0; }
  .footstrip .data { overflow-wrap: anywhere; color: var(--ink); }

  .footer-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-5);
  }
  .footer-copy { font-size: 15px; color: var(--ink-2); }
  .footer-links { display: flex; list-style: none; gap: var(--space-3) var(--space-5); flex-wrap: wrap; }
  .footer-meta { margin-top: var(--space-5); }

  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--space-4);
    z-index: var(--z-skip);
    background: var(--ink);
    color: var(--bg);
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-control);
    font-weight: 500;
  }
  .skip-link:focus { top: var(--space-4); }

  @media (max-width: 1000px) {
    .titleblock { grid-template-columns: auto minmax(0, 1fr) auto; }
    .titleblock__name { padding-right: var(--space-4); }
    .nav__link { min-width: 0; padding-inline: var(--space-3); }
  }

  @media (max-width: 760px) {
    .classline__l { display: none; }
    .classline { justify-content: flex-start; }
    .titleblock { grid-template-columns: minmax(0, 1fr) auto; }
    .titleblock__name { border-right: 0; }
    .titleblock__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      border-top: 1px solid var(--rule);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .titleblock__nav::-webkit-scrollbar { display: none; }
    .nav__link { padding: var(--space-2) var(--space-3) var(--space-3); }
    .nav__links li:first-child .nav__link { padding-left: 0; }
    .titleblock__theme { grid-column: 2; grid-row: 1; }
    .theme-toggle { min-width: 96px; }

    .footstrip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footstrip > div { border-bottom: 1px solid var(--rule); padding-left: var(--space-3); }
    .footstrip > div:nth-child(2n) { border-right: 0; }
    .footstrip > div:nth-child(2n + 1) { padding-left: 0; }
    .footstrip > div:nth-last-child(-n + 2) { border-bottom: 0; }
    .footer-inner { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  }
</style>
