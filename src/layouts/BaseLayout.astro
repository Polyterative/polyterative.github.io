---
export interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'Vlady Yakovenko — UX Engineer, Artist, Musician',
  description = 'Portfolio of Vlady Yakovenko (polyterative) — UX engineer, generative visual artist, and electronic musician based in Bologna, Italy.',
  isHome = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/projects', label: 'Projects', match: '/projects' },
  { href: '/music', label: 'Music', match: '/music' },
  { href: '/blog', label: 'Writing', match: '/blog' },
  { href: '/about', label: 'About', match: '/about' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vlady Yakovenko',
  alternateName: 'polyterative',
  url: 'https://polyterative.github.io',
  sameAs: [
    'https://github.com/polyterative',
    'https://polyterative.bandcamp.com',
    'https://www.instagram.com/polyterative/',
    'https://patcher.xyz',
  ],
  jobTitle: 'UX Engineer',
  description: 'Medium-agnostic creative exploring intersections of arts, design and code.',
  address: { '@type': 'PostalAddress', addressLocality: 'Bologna', addressCountry: 'IT' },
  email: 'polyterative@outlook.com',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Vlady Yakovenko" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="polyterative" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Theme color -->
  <meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="polyterative — Writing" href="/rss.xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  )}
  <slot name="head" />

  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="container">
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class="nav__logo">polyterative</a>
        <ul class="nav__links">
          {navLinks.map(link => {
            const isActive = link.match && currentPath.startsWith(link.match);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['nav__link', { 'nav__link--active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >{link.label}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
  </header>

  <main class="site-main" id="main-content" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <p class="footer-copy">
          polyterative &nbsp;·&nbsp; Bologna &nbsp;·&nbsp;
          <a href="mailto:polyterative@outlook.com">polyterative@outlook.com</a>
          &nbsp;·&nbsp; &copy; {new Date().getFullYear()}
        </p>
        <ul class="footer-links">
          <li><a href="https://github.com/polyterative" target="_blank" rel="noopener" aria-label="GitHub">GitHub</a></li>
          <li><a href="https://polyterative.bandcamp.com" target="_blank" rel="noopener" aria-label="Bandcamp">Bandcamp</a></li>
          <li><a href="/music">Music</a></li>
          <li><a href="https://www.instagram.com/polyterative/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a></li>
          <li><a href="https://patcher.xyz" target="_blank" rel="noopener" aria-label="Patcher">patcher.xyz</a></li>
        </ul>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-4);
    backdrop-filter: blur(8px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__logo {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .nav__links {
    display: flex;
    list-style: none;
    gap: var(--space-6);
  }

  .nav__links a,
  .nav__link {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .nav__link:hover { color: var(--color-text); }
  .nav__link--active {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-text);
  }

  .site-main { flex: 1; }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
    margin-top: var(--space-16);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .footer-copy a {
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--transition);
  }
  .footer-copy a:hover { text-decoration-color: var(--color-muted); }

  .footer-links {
    display: flex;
    list-style: none;
    gap: var(--space-6);
  }

  .footer-links a {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footer-links a:hover { color: var(--color-text); }

  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--space-4);
    z-index: 999;
    background: var(--color-text);
    color: var(--color-bg);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    text-decoration: none;
    transition: top var(--transition);
  }
  .skip-link:focus { top: var(--space-4); }

  /* Global focus styles */
  :focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .nav__links {
      gap: var(--space-3);
    }
    .nav__links a {
      font-size: 0.8rem;
    }
  }
  @media (max-width: 480px) {
    /* Show only most important links on smallest screens */
    .nav__links li:nth-child(n+4) { display: none; }
  }
  @media (max-width: 360px) {
    .nav__links { display: none; }
  }
  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-links {
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }</style>
