---
import Icon from '../components/Icon.astro';

export interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'Vlady Yakovenko — Designer, engineer, musician',
  description = 'Notes, projects, and ongoing work by Vlady Yakovenko (polyterative) across software, visuals, music, and interaction design.',
  isHome = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/apps', label: 'Apps', match: '/apps' },
  { href: '/projects', label: 'Projects', match: '/projects' },
  { href: '/music', label: 'Music', match: '/music' },
  { href: '/blog', label: 'Writing', match: '/blog' },
  { href: '/about', label: 'About', match: '/about' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vlady Yakovenko',
  alternateName: 'polyterative',
  url: 'https://polyterative.github.io',
  sameAs: [
    'https://github.com/polyterative',
    'https://polyterative.bandcamp.com',
    'https://www.instagram.com/polyterative/',
    'https://patcher.xyz',
  ],
  jobTitle: 'Product Designer',
  description: 'Designer working across software, visuals, music, and interaction systems.',
  address: { '@type': 'PostalAddress', addressLocality: 'Bologna', addressCountry: 'IT' },
  email: 'polyterative@outlook.com',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Vlady Yakovenko" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="polyterative" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Theme color (kept in sync by the resolver below) -->
  <meta name="theme-color" content="#f6f6f4" id="theme-color-meta" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="polyterative — Writing" href="/rss.xml" />

  <!-- Pre-paint theme resolver: light by default, dark in the evening or by choice. Runs before first paint to avoid a flash. -->
  <script is:inline>
    (function () {
      try {
        var params = new URLSearchParams(location.search);
        var override = params.get('theme');
        var mode = override || localStorage.getItem('theme') || 'auto';
        var resolved = mode;
        if (mode === 'auto') {
          var h = new Date().getHours();
          resolved = (h >= 19 || h < 7) ? 'dark' : 'light';
        }
        var el = document.documentElement;
        el.dataset.theme = resolved;
        el.dataset.themeMode = mode;
        var m = document.getElementById('theme-color-meta');
        if (m) m.setAttribute('content', resolved === 'dark' ? '#15202b' : '#f6f6f4');
      } catch (e) {}
    })();
  </script>

  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  )}
  <slot name="head" />

  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="container container--wide">
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class="nav__logo">polyterative</a>
        <ul class="nav__links">
          {navLinks.map(link => {
            const isActive = link.match && currentPath.startsWith(link.match);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['nav__link', { 'nav__link--active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >{link.label}</a>
              </li>
            );
          })}
          <li>
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme" title="Theme: auto">
              <span class="theme-toggle__ic theme-toggle__ic--auto"><Icon name="monitor" size={16} /></span>
              <span class="theme-toggle__ic theme-toggle__ic--light"><Icon name="sun" size={16} /></span>
              <span class="theme-toggle__ic theme-toggle__ic--dark"><Icon name="moon" size={16} /></span>
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="site-main" id="main-content" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container container--wide">
      <div class="footer-inner">
        <div class="footer-copy">
          <p class="footer-copy__title">Software, notes, music, ongoing work.</p>
          <p class="footer-copy__meta">Based in Bologna · polyterative &copy; {new Date().getFullYear()} · <a href="mailto:polyterative@outlook.com">polyterative@outlook.com</a></p>
        </div>
        <ul class="footer-links">
          <li><a class="iclink" href="mailto:polyterative@outlook.com"><Icon name="mail" size={14} />Email</a></li>
          <li><a class="iclink" href="https://github.com/polyterative" target="_blank" rel="noopener"><Icon name="github" size={14} />GitHub</a></li>
          <li><a class="iclink" href="https://polyterative.bandcamp.com" target="_blank" rel="noopener"><Icon name="music" size={14} />Bandcamp</a></li>
          <li><a class="iclink" href="https://www.instagram.com/polyterative/" target="_blank" rel="noopener"><Icon name="instagram" size={14} />Instagram</a></li>
          <li><a class="iclink" href="https://patcher.xyz" target="_blank" rel="noopener"><Icon name="external" size={14} />patcher.xyz</a></li>
        </ul>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var order = ['auto', 'light', 'dark'];
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var el = document.documentElement;
      var meta = document.getElementById('theme-color-meta');

      function resolve(mode) {
        if (mode !== 'auto') return mode;
        var h = new Date().getHours();
        return (h >= 19 || h < 7) ? 'dark' : 'light';
      }
      function apply(mode) {
        var resolved = resolve(mode);
        el.dataset.theme = resolved;
        el.dataset.themeMode = mode;
        btn.setAttribute('title', 'Theme: ' + mode);
        if (meta) meta.setAttribute('content', resolved === 'dark' ? '#15202b' : '#f6f6f4');
      }
      apply(el.dataset.themeMode || 'auto');

      btn.addEventListener('click', function () {
        var current = el.dataset.themeMode || 'auto';
        var next = order[(order.indexOf(current) + 1) % order.length];
        try { localStorage.setItem('theme', next); } catch (e) {}
        apply(next);
      });
    })();
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-4);
  }

  .nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__logo {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .nav__logo:hover { opacity: 0.6; }

  .nav__links {
    display: flex;
    list-style: none;
    gap: var(--space-5);
  }

  .nav__link {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }
  .nav__link:hover { color: var(--color-text); }
  .nav__link--active { color: var(--color-text); }

  .nav__links { align-items: center; }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .theme-toggle:hover { color: var(--color-text); border-color: var(--color-muted); }
  .theme-toggle__ic { display: none; grid-area: 1 / 1; line-height: 0; }
  :root[data-theme-mode="auto"]  .theme-toggle__ic--auto  { display: block; }
  :root[data-theme-mode="light"] .theme-toggle__ic--light { display: block; }
  :root[data-theme-mode="dark"]  .theme-toggle__ic--dark  { display: block; }
  /* pre-hydration fallback: show auto glyph */
  :root:not([data-theme-mode]) .theme-toggle__ic--auto { display: block; }

  .site-main { flex: 1; }

  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-8);
    margin-top: var(--space-24);
  }

  .footer-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-copy__title {
    font-size: var(--font-size-sm);
    max-width: 42ch;
  }
  .footer-copy__meta {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-faint);
  }
  .footer-copy__meta a:hover { color: var(--color-text); }

  .footer-links {
    display: flex;
    list-style: none;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .footer-links a {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }
  .footer-links a:hover { color: var(--color-text); }

  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--space-4);
    z-index: var(--z-skip);
    background: var(--color-text);
    color: var(--color-bg);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    font-size: var(--font-size-sm);
  }
  .skip-link:focus { top: var(--space-4); }

  @media (max-width: 460px) {
    .nav__links { gap: var(--space-4); }
    .nav__link { font-size: 0.8rem; }
  }
  @media (max-width: 640px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  }
</style>
