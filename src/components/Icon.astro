---
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  label?: string;
}
const { name, size = 16, class: cls = "", label } = Astro.props;
const px = typeof size === "number" ? `${size}px` : size;
const a11y = label
  ? { role: "img", "aria-label": label }
  : { "aria-hidden": "true" };

// stroke-based 24x24 path sets, currentColor
