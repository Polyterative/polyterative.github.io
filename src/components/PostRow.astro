---
export interface Props {
  title: string;
  date: string;
  slug: string;
  description?: string;
  tags?: string[];
}

const { title, date, slug, description, tags = [] } = Astro.props;
const dateObj = new Date(date);
const formatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="post-row">
  <time class="post-row__date" datetime={date}>{formatted}</time>
  <div class="post-row__body">
    <h2 class="post-row__title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h2>
    {description && <p class="post-row__desc">{description}</p>}
    {tags.length > 0 && (
      <ul class="post-row__tags">
        {tags.map(t => <li><span class="tag">{t}</span></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }

  .post-row:first-child { border-top: 1px solid var(--color-border); }

  .post-row__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    padding-top: 4px;
    white-space: nowrap;
  }

  .post-row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .post-row__title {
    font-size: 1.1rem;
    font-weight: 600;
  }
  .post-row__title a {
    text-decoration: none;
  }
  .post-row__title a:hover { text-decoration: underline; }

  .post-row__desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    max-width: none;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  @media (max-width: 480px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
