---
import PostCover from './PostCover.astro';
import { isoDots } from '../lib/datum';
import { tagSlug } from '../lib/posts';

export interface Props {
  title: string;
  date: string;
  slug: string;
  description?: string;
  tags?: string[];
  compact?: boolean;
  wordCount?: number;
  cover?: string;
  /** Post number in the archive, oldest = 001. */
  index?: string;
}

const { title, date, slug, description, tags = [], compact = false, wordCount, cover, index } = Astro.props;
const stamp = isoDots(date);
const readingTime = wordCount ? Math.max(1, Math.round(wordCount / 200)) : null;
---

<article class:list={['post-row', { 'post-row--compact': compact }]}>
  <div class="post-row__meta">
    {index && <span class="lbl">No. {index}</span>}
    <time class="data post-row__date" datetime={date}>{stamp}</time>
    {!compact && readingTime && <span class="data post-row__rt">{readingTime} min read</span>}
  </div>
  {!compact && (
    <a class="post-row__cover" href={`/blog/${slug}`} aria-hidden="true" tabindex="-1">
      <PostCover title={title} tags={tags} cover={cover} variant="thumb" />
    </a>
  )}
  <div class="post-row__body">
    <h3 class="post-row__title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>
    {!compact && description && <p class="post-row__desc">{description}</p>}
    {!compact && tags.length > 0 && (
      <ul class="taglist">
        {tags.map(t => <li><a href={`/blog/tags/${tagSlug(t)}`}>{t}</a></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 112px 168px minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--rule);
    align-items: start;
  }
  .post-row--compact { grid-template-columns: 112px minmax(0, 1fr); padding-block: var(--space-4); align-items: baseline; }

  .post-row__cover { display: block; }
  .post-row__cover:hover :global(.pcover) { border-color: var(--ink); }

  .post-row__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .post-row__date { color: var(--ink); white-space: nowrap; }
  .post-row__rt { color: var(--ink-3); }

  .post-row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .post-row__title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .post-row__title a:hover { color: var(--signal-text); }

  .post-row__desc {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.55;
    max-width: 60ch;
  }

  @media (max-width: 720px) {
    .post-row { grid-template-columns: 132px minmax(0, 1fr); gap: var(--space-3) var(--space-5); }
    .post-row__cover { grid-row: 1 / 3; order: -1; }
    .post-row__meta { grid-column: 2; flex-direction: row; flex-wrap: wrap; gap: var(--space-1) var(--space-3); align-items: baseline; }
    .post-row__body { grid-column: 2; }
    .post-row--compact .post-row__meta { grid-column: 1; flex-direction: column; }
  }
  @media (max-width: 480px) {
    .post-row { grid-template-columns: 1fr; gap: var(--space-3); }
    .post-row__cover, .post-row__meta, .post-row__body { grid-column: 1; }
    .post-row__cover { grid-row: auto; }
    .post-row--compact { grid-template-columns: 1fr; gap: var(--space-2); }
    .post-row--compact .post-row__meta { grid-column: 1; flex-direction: row; }
  }
</style>
