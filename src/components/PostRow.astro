---
export interface Props {
  title: string;
  date: string;
  slug: string;
  description?: string;
  tags?: string[];
  compact?: boolean;
  wordCount?: number;
}

const { title, date, slug, description, tags = [], compact = false, wordCount } = Astro.props;
const dateObj = new Date(date);
const formatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const readingTime = wordCount ? Math.max(1, Math.round(wordCount / 200)) : null;
---

<article class:list={['post-row', { 'post-row--compact': compact }]}>
  <div class="post-row__meta">
    <time class="post-row__date" datetime={date}>{formatted}</time>
    {!compact && readingTime && <span class="post-row__rt">{readingTime} min</span>}
  </div>
  <div class="post-row__body">
    <h2 class="post-row__title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h2>
    {!compact && description && <p class="post-row__desc">{description}</p>}
    {!compact && tags.length > 0 && (
      <ul class="post-row__tags">
        {tags.map(t => <li><span class="tag">{t}</span></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: var(--post-row-date) 1fr;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    align-items: start;
    transition: background var(--transition);
  }
  .post-row--compact {
    grid-template-columns: var(--post-row-date-sm) 1fr;
    padding-block: var(--space-4);
  }

  .post-row:first-child { border-top: 1px solid var(--color-border); }

  .post-row__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: 3px;
  }

  .post-row__date {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .post-row__rt {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-border);
  }

  .post-row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .post-row__title {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .post-row__title a {
    text-decoration: none;
    transition: opacity var(--transition);
  }
  .post-row__title a:hover { opacity: 0.65; }

  .post-row__desc {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: 1.55;
    max-width: none;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
  }

  @media (max-width: 480px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .post-row__meta { flex-direction: row; align-items: center; gap: var(--space-3); }
  }
</style>
