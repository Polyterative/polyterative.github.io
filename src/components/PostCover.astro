---
import Img from './Img.astro';
import Icon from './Icon.astro';

export interface Props {
  title: string;
  tags?: string[];
  cover?: string;
  variant?: 'thumb' | 'hero';
}

const { title, tags = [], cover, variant = 'thumb' } = Astro.props;

// Pick a topic icon from the tags, first match wins.
const iconRules: [RegExp, string][] = [
  [/home assistant|self-host|homelab|truenas|network|smart home/i, 'monitor'],
  [/webgpu|three\.js|generative|creative coding|rxjs|visual/i, 'layers'],
  [/music|ableton|eurorack|modular|audio|acoustic|synth|osc|av\b/i, 'music'],
  [/mcp|\bai\b|llm|claude|local ai/i, 'tool'],
  [/figma|design|color theory|interior|\bux\b|space planning/i, 'layers'],
  [/open data|civic|maps?\b/i, 'map-pin'],
  [/talon|voice coding|accessibility/i, 'message'],
  [/python|talon|stream deck|karabiner|productivity|macos|tooling|keyboard/i, 'terminal'],
  [/typescript|angular|next\.js|tailwind|javascript|open source/i, 'code'],
];
const hay = [...tags, title].join(' ');
const icon = iconRules.find(([re]) => re.test(hay))?.[1] ?? 'book';

const coverLabel = tags[0] ?? 'Post';
---

<div class:list={['pcover', `pcover--${variant}`, { 'gencover': !cover }]} role={!cover ? 'img' : undefined} aria-label={!cover ? `${title}: no cover image` : undefined}>
  {cover
    ? <Img class="pcover__img" src={cover} alt={`${title} cover`} loading={variant === 'hero' ? 'eager' : 'lazy'} />
    : (
      <>
        <Icon name={icon} size={variant === 'hero' ? 40 : 24} />
        <span class="lbl gencover__lbl">{coverLabel}</span>
      </>
    )
  }
</div>

<style>
  .pcover {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--rule);
    background-color: var(--hover);
    transition: border-color var(--transition);
  }
  .pcover--thumb { aspect-ratio: 16 / 10; }
  .pcover--hero { aspect-ratio: 21 / 9; }

  .pcover :global(.pcover__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .pcover--thumb .gencover__lbl { left: var(--space-2); bottom: var(--space-1); }
</style>
