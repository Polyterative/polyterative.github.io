---
export interface Props {
  name: string;
  description: string;
  url?: string;
  repo?: string;
  tags?: string[];
  featured?: boolean;
}

const { name, description, url, repo, tags = [], featured = false } = Astro.props;
---

<article class:list={['card', 'project-card', { 'project-card--featured': featured }]}>
  <div class="project-card__body">
    <h3 class="project-card__title">
      {url
        ? <a href={url} target="_blank" rel="noopener">{name}</a>
        : name
      }
    </h3>
    <p class="project-card__desc">{description}</p>
    {tags.length > 0 && (
      <ul class="project-card__tags">
        {tags.map(t => <li><span class="tag">{t}</span></li>)}
      </ul>
    )}
    {(url || repo) && (
      <div class="project-card__links">
        {url && <a href={url} target="_blank" rel="noopener">Live ↗</a>}
        {repo && <a href={repo} target="_blank" rel="noopener">GitHub ↗</a>}
      </div>
    )}
  </div>
</article>
</article>

<style>
  .project-card {
    position: relative;
  }

  .project-card--featured {
    border-left: 3px solid var(--color-text);
  }

  .project-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-card__title {
    font-size: 1rem;
    font-weight: 600;
  }
  .project-card__title a {
    text-decoration: none;
  }
  .project-card__title a:hover {
    text-decoration: underline;
  }

  .project-card__desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
    max-width: none;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-2);
  }

  .project-card__links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }
  .project-card__links a {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .project-card__links a:hover { color: var(--color-text); }
</style>
