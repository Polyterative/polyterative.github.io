---
import Img from './Img.astro';
import Icon from './Icon.astro';

export interface Props {
  name: string;
  description: string;
  url?: string;
  repo?: string;
  /** Internal link to a dedicated app/story page. Title prefers this. */
  details?: string;
  tags?: string[];
  featured?: boolean;
  image?: string;
  icon?: string;
  /** Position in the list it belongs to, e.g. "01". Rendered as a plate. */
  index?: string;
}

const { name, description, url, repo, details, tags = [], featured = false, image, icon = 'code', index } = Astro.props;
const urlIsExternal = url?.startsWith('http');
const titleHref = details ?? url;
const titleIsExternal = titleHref?.startsWith('http');
---

<article class:list={['project', { 'project--featured': featured }]}>
  <header class="project__head">
    {index && <span class="plate project__idx">{index}</span>}
    {tags[0] && <span class="lbl">{tags[0]}</span>}
  </header>
  <div class="project__cover crop">
    {image
      ? <Img class="project__img" src={image} alt={`${name} preview`} loading="lazy" />
      : (
        <div class="gencover project__gen" role="img" aria-label={`${name}: no screenshot`}>
          <Icon name={icon} size={32} />
          <span class="lbl gencover__lbl">No image</span>
        </div>
      )
    }
  </div>
  <h3 class="project__title">
    {titleHref
      ? <a href={titleHref} target={titleIsExternal ? '_blank' : undefined} rel={titleIsExternal ? 'noopener' : undefined}>{name}</a>
      : name
    }
  </h3>
  <p class="project__desc">{description}</p>
  {tags.length > 0 && (
    <ul class="taglist">
      {tags.map(t => <li>{t}</li>)}
    </ul>
  )}
  {(url || repo || details) && (
    <div class="project__links">
      {details && <a class="act" href={details}>Details<Icon name="arrow-right" size={13} /></a>}
      {url && <a class="act" href={url} target={urlIsExternal ? '_blank' : undefined} rel={urlIsExternal ? 'noopener' : undefined}>{urlIsExternal ? 'Live' : 'Details'}<Icon name={urlIsExternal ? 'arrow-up-right' : 'arrow-right'} size={13} /></a>}
      {repo && <a class="act" href={repo} target="_blank" rel="noopener">Source<Icon name="arrow-up-right" size={13} /></a>}
    </div>
  )}
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-8);
    border-top: 1px solid var(--rule);
    height: 100%;
  }

  .project__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    min-height: 16px;
  }
  .project__idx { font-size: 24px; color: var(--ink); }

  .project__cover {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--rule);
    background: var(--hover);
    margin: var(--space-2) 0 var(--space-1);
  }
  .project--featured .project__cover { aspect-ratio: 21 / 9; }

  .project :global(.project__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .project__gen { width: 100%; height: 100%; }

  .project__title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .project__title a:hover { color: var(--signal-text); }

  .project__desc {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.55;
    max-width: 56ch;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: auto;
    padding-top: var(--space-2);
  }
</style>
