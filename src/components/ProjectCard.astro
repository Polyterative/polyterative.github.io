---
export interface Props {
  name: string;
  description: string;
  url?: string;
  repo?: string;
  tags?: string[];
  featured?: boolean;
}

const { name, description, url, repo, tags = [], featured = false } = Astro.props;
---

<article class:list={['card', 'project-card', { 'project-card--featured': featured }]}>
  <div class="project-card__body">
    <h3 class="project-card__title">
      {url
        ? <a href={url} target="_blank" rel="noopener">{name}</a>
        : name
      }
    </h3>
    <p class="project-card__desc">{description}</p>
    {tags.length > 0 && (
      <ul class="project-card__tags">
        {tags.map(t => <li><span class="tag">{t}</span></li>)}
      </ul>
    )}
  </div>
  {repo && (
    <a class="project-card__link" href={repo} target="_blank" rel="noopener" aria-label={`View ${name} on GitHub`}>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
    </a>
  )}
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .project-card--featured {
    border-left: 3px solid var(--color-text);
  }

  .project-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-card__title {
    font-size: 1rem;
    font-weight: 600;
  }
  .project-card__title a {
    text-decoration: none;
  }
  .project-card__title a:hover {
    text-decoration: underline;
  }

  .project-card__desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
    max-width: none;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-2);
  }

  .project-card__link {
    flex-shrink: 0;
    color: var(--color-muted);
    text-decoration: none;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
    margin-top: 2px;
  }
  .project-card__link:hover {
    color: var(--color-text);
    background: var(--color-accent-soft);
  }
</style>
