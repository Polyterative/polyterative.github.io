---
export interface Props {
  /** Kept for API compatibility; Datum quotes are monochrome. */
  accentHue?: number;
}
---

<figure class="pull-quote">
  <blockquote>
    <slot />
  </blockquote>
</figure>

<style>
  /* `figure.` prefix matches the specificity of the .app-story figure/blockquote rules
     so this component's own styling wins the cascade. */
  figure.pull-quote {
    margin: clamp(var(--space-8), 5vw, var(--space-10)) 0 0;
    padding: var(--space-3) 0 0 var(--space-5);
    border: 0;
    border-left: 1px solid var(--ink);
    background: none;
    max-width: 56ch;
  }
  figure.pull-quote blockquote {
    margin: 0;
    border: 0;
    padding: 0;
    font-size: var(--fs-lead);
    line-height: 1.4;
    letter-spacing: -0.015em;
    font-weight: 500;
    text-wrap: balance;
  }
</style>
