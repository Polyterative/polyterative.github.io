---
export interface Props {
  eyebrow?: string;
  heading: string;
  reverse?: boolean;
}

const { eyebrow, heading, reverse = false } = Astro.props;
const headingId = `fr-${heading.slice(0, 12).replace(/\s+/g, '-').toLowerCase()}`;
---

<section class:list={['feature-row', { 'feature-row--reverse': reverse }]} aria-labelledby={headingId}>
  <div class="feature-row__copy">
    {eyebrow && <span class="label">{eyebrow}</span>}
    <h2 id={headingId}>{heading}</h2>
    <div class="feature-row__body"><slot /></div>
  </div>
  <div class="feature-row__visual">
    <slot name="visual" />
  </div>
</section>

<style>
  .feature-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-6), 4vw, var(--space-12));
    align-items: start;
  }
  .feature-row--reverse .feature-row__copy { order: 2; }
  .feature-row--reverse .feature-row__visual { order: 1; }

  .feature-row__copy > .label {
    display: block;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .feature-row__copy h2 { margin-bottom: var(--space-4); }
  .feature-row__body :global(p) { line-height: 1.6; }
  .feature-row__body :global(p + p) { margin-top: var(--space-4); }
  .feature-row__body :global(strong) { font-weight: 600; }

  /* Screenshots: flat, on a concrete ground, hairline edge, mono caption. */
  .feature-row__visual :global(figure) { margin: 0; }
  .feature-row__visual :global(figure img) {
    width: 100%;
    display: block;
    border: 1px solid var(--rule);
    background: var(--hover);
  }
  .feature-row__visual :global(.two-up) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .feature-row__visual :global(figcaption) {
    font-family: var(--f-mono);
    font-size: var(--fs-meta);
    color: var(--ink-2);
    padding-top: var(--space-2);
  }

  @media (max-width: 780px) {
    .feature-row { grid-template-columns: 1fr; }
    .feature-row--reverse .feature-row__copy,
    .feature-row--reverse .feature-row__visual { order: initial; }
    .feature-row__visual :global(.two-up) { grid-template-columns: 1fr; }
  }
</style>
