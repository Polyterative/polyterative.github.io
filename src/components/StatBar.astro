---
export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  stats: Stat[];
  /** Kept for API compatibility; Datum readouts are monochrome. */
  accentHue?: number;
  heading?: string;
}

const { stats, heading } = Astro.props;
---

<section class="readout" aria-label="Measurements">
  <div class="readout__head">
    <span class="lbl">Readout</span>
    {heading && <p class="data readout__note">{heading}</p>}
  </div>
  <dl class="readout__grid">
    {stats.map((stat, i) => (
      <div class="readout__item">
        <dt class="lbl"><span class="readout__n">{String(i + 1).padStart(2, '0')}</span>{stat.label}</dt>
        <dd class="plate readout__value">{stat.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  /* An instrument readout: label above value, hairline cells, Departure numerals. */
  .readout {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .readout__head {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    flex-wrap: wrap;
    padding-block: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .readout__note { max-width: 70ch; }
  .readout__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
  }
  .readout__item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4) var(--space-4);
    border-right: 1px solid var(--rule);
  }
  .readout__item:first-child { padding-left: 0; }
  .readout__item:last-child { border-right: 0; }
  .readout__n { color: var(--ink-3); margin-right: 6px; }
  .readout__value {
    font-size: clamp(28px, 3.4vw, 40px);
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .readout__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .readout__item { padding-left: var(--space-3); }
    .readout__item:nth-child(2n + 1) { padding-left: 0; }
    .readout__item:nth-child(2n) { border-right: 0; }
    .readout__item:nth-child(-n + 2) { border-bottom: 1px solid var(--rule); }
  }
</style>
