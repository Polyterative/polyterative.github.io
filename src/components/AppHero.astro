---
import Icon from './Icon.astro';
import { apps, type AppEntry, type AppLink } from '../data/apps';
import { pad, parseStatus, pillClass } from '../lib/datum';

export interface Props {
  app: AppEntry;
  primaryCta: AppLink;
  secondaryCta?: AppLink;
  /** A measured result shown as an inverted label on the screenshot. */
  shotBadge?: string;
}

const { app, primaryCta, secondaryCta, shotBadge } = Astro.props;
const status = parseStatus(app.status);
const position = `${pad(apps.indexOf(app) + 1)}/${pad(apps.length)}`;

const isExternal = (href: string) => href.startsWith('http');
---

<header class="showcase-hero">
  <div class="showcase-hero__copy">
    <div class="showcase-hero__kicker">
      <span class="plate showcase-hero__idx" title="Position in the applications registry">{position}</span>
      <div class="showcase-hero__state">
        <span class="lbl">{app.platform}</span>
        <span class="showcase-hero__status">
          <span class={pillClass(status.tone)}>{status.head}</span>
          {status.rest && <span class="data">{status.rest}</span>}
        </span>
      </div>
    </div>
    <h1>{app.name}</h1>
    <p class="showcase-hero__tagline">{app.tagline}</p>
    <p class="showcase-hero__pitch">{app.pitch}</p>

    <div class="showcase-hero__ctas">
      <a
        class="btn btn--primary"
        href={primaryCta.href}
        target={isExternal(primaryCta.href) ? '_blank' : undefined}
        rel={isExternal(primaryCta.href) ? 'noopener' : undefined}
      >
        {primaryCta.label}
        <Icon name={isExternal(primaryCta.href) ? 'arrow-up-right' : 'arrow-right'} size={14} />
      </a>
      {secondaryCta && (
        <a
          class="btn"
          href={secondaryCta.href}
          target={isExternal(secondaryCta.href) ? '_blank' : undefined}
          rel={isExternal(secondaryCta.href) ? 'noopener' : undefined}
        >
          {secondaryCta.label}
          <Icon name={secondaryCta.icon} size={14} />
        </a>
      )}
    </div>

    <ul class="taglist showcase-hero__tags">
      {app.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>

  <figure class="showcase-hero__shot">
    {app.hero ? (
      <>
        <div class="showcase-hero__frame crop">
          <img src={app.hero} alt={app.heroAlt} loading="eager" decoding="async" />
          {shotBadge && <span class="inv showcase-hero__badge">{shotBadge}</span>}
        </div>
        <figcaption class="figcap"><span class="lbl">Fig. 01</span><span>{app.heroAlt}</span></figcaption>
      </>
    ) : (
      <div class="gencover showcase-hero__gen crop" role="img" aria-label={`${app.name}: no screenshot`}>
        <Icon name={app.icon ?? 'code'} size={40} />
        <span class="lbl gencover__lbl">{app.platform}</span>
      </div>
    )}
  </figure>
</header>

<style>
  .showcase-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(var(--space-8), 5vw, var(--space-16));
    align-items: start;
  }

  .showcase-hero__copy { max-width: 60ch; }

  .showcase-hero__kicker {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--rule);
  }
  .showcase-hero__idx { font-size: 32px; color: var(--ink); }
  .showcase-hero__state { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .showcase-hero__status { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }

  .showcase-hero h1 { font-size: clamp(2.8rem, 6vw, 4.5rem); }
  .showcase-hero__tagline {
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    margin-top: var(--space-4);
    text-wrap: balance;
  }
  .showcase-hero__pitch {
    margin-top: var(--space-4);
    color: var(--ink-2);
    line-height: 1.6;
  }

  .showcase-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .showcase-hero__tags { margin-top: var(--space-6); }

  .showcase-hero__frame {
    position: relative;
    border: 1px solid var(--rule);
    background: var(--hover);
  }
  .showcase-hero__frame img { width: 100%; }
  .showcase-hero__badge {
    position: absolute;
    left: 0;
    bottom: 0;
    font-size: var(--fs-meta);
    padding: 4px 8px;
  }

  .showcase-hero__gen { min-height: clamp(220px, 28vw, 340px); border: 1px solid var(--rule); }

  @media (max-width: 860px) {
    .showcase-hero { grid-template-columns: 1fr; }
    .showcase-hero__copy { max-width: none; }
  }
</style>
