---
import Icon from './Icon.astro';
import type { AppEntry, AppLink } from '../data/apps';

export interface Props {
  app: AppEntry;
  primaryCta: AppLink;
  secondaryCta?: AppLink;
  shotBadge?: string;
}

const { app, primaryCta, secondaryCta, shotBadge } = Astro.props;
const isPre = app.status.toLowerCase().includes('pre-release');

const isExternal = (href: string) => href.startsWith('http');
---

<header class="showcase-hero" style={`--app-h:${app.accentHue}`}>
  <div class="showcase-hero__copy">
    <p class="showcase-hero__kicker">
      <span class="label">{app.platform}</span>
      <span class:list={['showcase-hero__status', { 'showcase-hero__status--pre': isPre }]}>{app.status}</span>
    </p>
    <h1>{app.name}</h1>
    <p class="showcase-hero__tagline">{app.tagline}</p>
    <p class="showcase-hero__pitch">{app.pitch}</p>

    <div class="showcase-hero__ctas">
      <a
        class="btn btn--primary"
        href={primaryCta.href}
        target={isExternal(primaryCta.href) ? '_blank' : undefined}
        rel={isExternal(primaryCta.href) ? 'noopener' : undefined}
      >
        {primaryCta.label}
        <Icon name={primaryCta.icon} size={14} />
      </a>
      {secondaryCta && (
        <a
          class="btn btn--secondary"
          href={secondaryCta.href}
          target={isExternal(secondaryCta.href) ? '_blank' : undefined}
          rel={isExternal(secondaryCta.href) ? 'noopener' : undefined}
        >
          {secondaryCta.label}
          <Icon name={secondaryCta.icon} size={14} />
        </a>
      )}
    </div>

    <ul class="showcase-hero__tags">
      {app.tags.map((tag) => <li><span class="tag">{tag}</span></li>)}
    </ul>
  </div>

  <figure class="showcase-hero__shot" class:list={[{ 'showcase-hero__shot--gen': !app.hero }]}>
    {app.hero ? (
      <div class="window-frame">
        <div class="window-frame__bar">
          <span class="window-frame__dot"></span>
          <span class="window-frame__dot"></span>
          <span class="window-frame__dot"></span>
        </div>
        <img src={app.hero} alt={app.heroAlt} loading="eager" decoding="async" />
        {shotBadge && <span class="showcase-hero__badge">{shotBadge}</span>}
      </div>
    ) : (
      <div class="showcase-hero__gen" role="img" aria-label={`${app.name} — generated cover`}>
        <Icon name={app.icon ?? 'code'} size={44} />
        <span class="showcase-hero__gen-name">{app.name}</span>
        <span class="showcase-hero__gen-tag">{app.platform}</span>
      </div>
    )}
  </figure>
</header>

<style>
  .showcase-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(var(--space-8), 5vw, var(--space-16));
    align-items: center;
  }

  .showcase-hero__copy { max-width: 60ch; }

  .showcase-hero__kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .showcase-hero__status {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }
  .showcase-hero__status::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 6px;
    background: hsl(145 60% 42%);
    vertical-align: 1px;
  }
  .showcase-hero__status--pre::before { background: hsl(38 90% 50%); }

  .showcase-hero h1 { font-size: clamp(2.4rem, 5.5vw, 3.8rem); }
  .showcase-hero__tagline {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    margin-top: var(--space-3);
    color: var(--color-text);
    text-wrap: balance;
  }
  .showcase-hero__pitch {
    margin-top: var(--space-4);
    color: var(--color-muted);
    line-height: 1.65;
  }

  .showcase-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    padding: 0.7em 1.15em;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: background-color var(--transition), border-color var(--transition), color var(--transition), transform var(--transition);
  }
  .btn:hover { transform: translateY(-1px); }
  .btn--primary {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .btn--primary:hover { background: var(--color-accent-ink); border-color: var(--color-accent-ink); color: #fff; }
  .btn--secondary {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }
  .btn--secondary:hover { border-color: var(--color-accent); color: var(--color-accent-ink); }

  .showcase-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-6);
  }

  /* ── Screenshot side ── */
  .showcase-hero__shot { position: relative; }
  .window-frame {
    position: relative;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    overflow: visible;
    background: var(--color-surface);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.4);
  }
  .window-frame__bar,
  .window-frame img { border-radius: 0; }
  .window-frame__bar { border-top-left-radius: calc(var(--radius-sm) - 1px); border-top-right-radius: calc(var(--radius-sm) - 1px); }
  .window-frame img:last-of-type { border-bottom-left-radius: calc(var(--radius-sm) - 1px); border-bottom-right-radius: calc(var(--radius-sm) - 1px); }
  .window-frame::before {
    content: '';
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 60%;
    background: radial-gradient(60% 100% at 30% 0%, hsl(var(--app-h) 65% 55% / 0.35), transparent 70%);
    z-index: -1;
    filter: blur(20px);
  }
  .window-frame__bar {
    display: flex;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .window-frame__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border);
  }
  .window-frame img { width: 100%; }

  .showcase-hero__badge {
    position: absolute;
    right: var(--space-5);
    bottom: calc(-1 * var(--space-4));
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    letter-spacing: 0.02em;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.45);
  }

  .showcase-hero__shot--gen { padding: 0; }
  .showcase-hero__gen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: clamp(220px, 28vw, 340px);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(120% 140% at 15% 0%, hsl(var(--app-h) 65% 58% / 0.85), transparent 62%),
      linear-gradient(135deg, hsl(var(--app-h) 52% 40%), hsl(calc(var(--app-h) + 42) 52% 30%));
  }
  .showcase-hero__gen :global(.icon) { color: rgba(255, 255, 255, 0.92); }
  .showcase-hero__gen-name {
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.95);
  }
  .showcase-hero__gen-tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 860px) {
    .showcase-hero { grid-template-columns: 1fr; }
    .showcase-hero__copy { max-width: none; }
  }
</style>
