---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { letter, lroman } from '../lib/datum';

const sectionIcons: Record<string, string> = {
  code: 'code',
  sound: 'music',
  visuals: 'layers',
  talks: 'message',
};

const archiveSections = [
  {
    id: 'code',
    label: 'Code',
    title: 'Engineering & Tools',
    projects: [
      {
        name: 'Patcher',
        description: 'Free, open-source workspace for Eurorack musicians — patch editor, rack planner, and community module database. Actively maintained since 2021, currently v6.5.',
        url: 'https://patcher.xyz',
        repo: 'https://github.com/polyterative/Patcher',
        details: '/apps/patcher',
        tags: ['Angular', 'TypeScript', 'Supabase', 'PostgreSQL', 'Eurorack'],
        image: '/projects/patcher.jpg',
        featured: true,
      },
      {
        name: 'Impulse',
        description: 'Node-based generative visual engine for live AV performance — built on WebGPU and TypeScript as a transparent, version-controllable, AI-friendly alternative to TouchDesigner.',
        details: '/apps/impulse',
        tags: ['WebGPU', 'TypeScript', 'Three.js', 'MIDI', 'Live Performance', 'Creative Coding'],
        featured: true,
      },
      {
        name: 'Kinetip',
        description: 'Native macOS utility that drives a pen tablet in absolute mode with click/drag pass-through and context-aware inertial pan-scrolling — aware of whether the pen landed on scrollable content or controls.',
        details: '/apps/kinetip',
        tags: ['macOS', 'Swift', 'Pen Tablet', 'UX', 'Accessibility'],
      },
      {
        name: 'Local AI Toolkit',
        description: 'mini-tagger, mini-renamer, and lms-guard — small macOS utilities for living with local LLMs: AI-assisted file tagging and renaming via LM Studio, plus a daemon that unloads idle models to reclaim RAM.',
        details: '/apps/local-ai-toolkit',
        tags: ['Python', 'Local AI', 'LM Studio', 'macOS', 'Tooling'],
      },
      {
        name: 'METRON Preset Tool',
        description: 'Terminal viewer and manager for WMD METRON .WMD preset files — unofficial and reverse-engineered. A code ↔ Eurorack crossover.',
        repo: 'https://github.com/Polyterative/metron-preset-tool',
        details: '/apps/metron-preset-tool',
        tags: ['Python', 'Eurorack', 'Reverse Engineering', 'CLI'],
      },
      {
        name: 'CostaMeno',
        description: 'Mobile-first fuel price finder built on Italian Ministry open data — open a URL at the pump and see the cheapest station nearby. No login, no ads, no tracking.',
        url: 'https://costameno.vercel.app',
        details: '/apps/costameno',
        tags: ['Next.js', 'TypeScript', 'Open Data', 'Civic Tech'],
      },
      {
        name: 'Poly Highlights',
        description: 'Luminance-corrected syntax highlighting for JetBrains IDEs — every token at a calibrated perceptual brightness.',
        repo: 'https://github.com/polyterative/Poly-highlights',
        tags: ['JetBrains', 'Design', 'Color Theory', 'Tooling'],
      },
      {
        name: 'POLY_REACTIVE_VISUALS',
        description: 'Angular + Three.js + RxJS scaffold for audio-reactive generative visuals with OSC hardware integration.',
        url: 'https://reactive-visuals.vercel.app',
        repo: 'https://github.com/polyterative/POLY_REACTIVE_VISUALS',
        tags: ['Three.js', 'RxJS', 'Angular', 'OSC', 'Creative Coding'],
      },
      {
        name: 'Angular Reactive p5.js',
        description: 'p5.js inside Angular + RxJS — sketch state as Observable streams, rendering decoupled from app logic.',
        url: 'https://reactive-p5.vercel.app',
        repo: 'https://github.com/polyterative/AngularReactiveP5',
        tags: ['p5.js', 'Angular', 'RxJS', 'Generative Art'],
      },
      {
        name: 'thear',
        description: 'Sonification of AI coding activity. Python daemon that turns Claude Code activity into real-time OSC messages for Ableton Live.',
        repo: 'https://github.com/polyterative/thear',
        details: '/apps/thear',
        tags: ['Python', 'OSC', 'Ableton', 'AI', 'Claude'],
      },
      {
        name: 'Poly Talon Scripts',
        description: 'Talon Voice configuration for hands-free coding on Mac, Windows, and Linux — my daily driver.',
        repo: 'https://github.com/polyterative/Poly-Talon-Scripts',
        tags: ['Voice Coding', 'Python', 'Talon', 'Productivity', 'Accessibility'],
      },
      {
        name: 'Zulu',
        description: 'UI experiment exploring layout density and interaction patterns in Angular.',
        url: 'https://zulu-3506inbrr-polyterative.vercel.app/',
        repo: 'https://github.com/polyterative/Zulu',
        tags: ['Angular', 'TypeScript', 'UI Experiment'],
      },
      {
        name: 'NodeMCU Sensor',
        description: 'ESP8266 firmware for temperature and humidity sensing — an early hardware project.',
        repo: 'https://github.com/polyterative/nodemcu-sensor',
        tags: ['Arduino', 'C++', 'IoT', 'ESP8266'],
      },
    ],
  },
  {
    id: 'sound',
    label: 'Sound',
    title: 'Music & Synthesis',
    projects: [
      {
        name: 'Polyterative on Bandcamp',
        description: 'Releases under the Polyterative alias — electronic music at the intersection of modular synthesis and composition.',
        url: 'https://polyterative.bandcamp.com',
        tags: ['Electronic Music', 'Bandcamp', 'Releases'],
        image: '/music/ruled-by-code.jpg',
      },
      {
        name: 'Eurorack / Modular Synthesis',
        description: 'Semi-modular and fully modular synthesis rigs, documented in Patcher. Active in Bologna Modulare and Eurorack Italy.',
        tags: ['Eurorack', 'Modular Synthesis', 'Hardware', 'Semi-modular'],
        image: '/projects/eurorack.jpg',
      },
      {
        name: 'Ableton Live Racks',
        description: 'Personal Ableton Live effect racks and templates, shared openly.',
        repo: 'https://github.com/polyterative/poly-ableton-racks',
        tags: ['Ableton Live', 'Effect Racks', 'Production', 'Max for Live'],
        image: '/projects/ableton.jpg',
      },
      {
        name: 'OSC Audio-Visual Bridge',
        description: 'Live system connecting Eurorack hardware to Three.js visuals via OSC — physical knobs, sub-20ms latency.',
        tags: ['OSC', 'Live Performance', 'Audio-Visual', 'Real-time'],
      },
    ],
  },
  {
    id: 'visuals',
    label: 'Visuals',
    title: 'Generative Art',
    projects: [
      {
        name: 'Impulse',
        description: 'WebGPU node-based engine for real-time generative visuals in live AV sets — the tool I built to replace TouchDesigner, with a fully transparent TypeScript structure.',
        details: '/apps/impulse',
        tags: ['WebGPU', 'Generative Art', 'Real-time', 'Live Performance'],
      },
      {
        name: 'POLY_REACTIVE_VISUALS',
        description: 'Three.js scenes driven by RxJS and live OSC from hardware — open source.',
        url: 'https://reactive-visuals.vercel.app',
        repo: 'https://github.com/polyterative/POLY_REACTIVE_VISUALS',
        tags: ['Three.js', 'Generative Art', 'Real-time', 'Audio-reactive'],
      },
      {
        name: 'Angular + p5.js',
        description: 'p5.js sketch rendering paired with Angular/RxJS — each input an Observable.',
        url: 'https://reactive-p5.vercel.app',
        repo: 'https://github.com/polyterative/AngularReactiveP5',
        tags: ['p5.js', 'Generative Art', 'Creative Coding'],
      },
      {
        name: 'TouchDesigner',
        description: 'Real-time visual compositions for live VJ sets and installations, driven by modular synth via OSC — including the ongoing "dotgrid" system (2023–).',
        tags: ['TouchDesigner', 'VJ', 'Real-time', 'Installations'],
      },
      {
        name: 'Ship UI',
        description: 'Sci-fi spaceship interface design set — combat, comms, systems, and main-menu HUD screens exploring dense, legible futuristic UI.',
        tags: ['UI Design', 'Sci-Fi', 'Interface Design', 'Concept'],
      },
      {
        name: 'Blender — Environment Studies',
        description: 'Architectural and lighting studies in Blender — brutalist interiors and lamp/material experiments.',
        tags: ['Blender', '3D', 'Lighting', 'Environment Design'],
      },
    ],
  },
  {
    id: 'talks',
    label: 'Talks',
    title: 'Public Talks',
    projects: [
      {
        name: 'Angular Flex: Building with Style (2022)',
        description: 'Public workshop in Bologna on design principles and Angular Flex Layout, with a live UI build.',
        repo: 'https://github.com/polyterative/Presentations',
        tags: ['Angular', 'UI Design', 'Workshop', '2022'],
      },
    ],
  },
];

const entryCount = archiveSections.reduce((n, s) => n + s.projects.length, 0);
---

<BaseLayout
  title="Projects — Vlady Yakovenko"
  description="A public archive of projects, tools, experiments, and related work by Vlady Yakovenko."
  serial="PLY-P"
>
  <div class="container container--wide">
    <header class="page-head">
      <aside class="page-head__aside">
        <span class="plate page-head__idx">0x02</span>
        <span class="lbl">Entries</span>
        <span class="data">{entryCount}</span>
        <span class="lbl">Sections</span>
        <span class="data">{archiveSections.length}</span>
      </aside>
      <div class="page-head__main">
        <h1>Work</h1>
        <p class="page-head__lead">
          The full archive: public projects, experiments, and a few longer-running things. Not exhaustive, just the pieces that make sense to keep collected here.
        </p>
        <p class="page-head__note">
          Looking for the polished software? The <a href="/apps">applications gallery</a> has the flagship apps with stories, screenshots, and fact sheets.
        </p>
      </div>
    </header>

    <nav class="index-nav" aria-label="Jump to section">
      <a href="/apps" class="index-nav__link"><span class="lbl">A</span>Applications</a>
      {archiveSections.map((s, i) => (
        <a href={`#${s.id}`} class="index-nav__link"><span class="lbl">{letter(i + 1)}</span>{s.label}</a>
      ))}
    </nav>

    {archiveSections.map((section, si) => (
      <section class="sec domain" id={section.id} aria-labelledby={`h-${section.id}`}>
        <header class="sec__head">
          <span class="plate sec__idx">{letter(si + 1)}</span>
          <span class="lbl">{section.label}</span>
          <h2 class="sec__title" id={`h-${section.id}`}>{section.title}</h2>
          <span class="lbl">{section.projects.length} {section.projects.length === 1 ? 'entry' : 'entries'}</span>
        </header>
        <div class="sec__body">
          <ul class="grid">
            {section.projects.map((p, i) => (
              <li class:list={[{ 'grid__span': p.featured }]}>
                <ProjectCard {...p} icon={sectionIcons[section.id]} index={lroman(i + 1)} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}

  </div>
</BaseLayout>

<style>
  .index-nav {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-12);
  }
  .index-nav__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 112px;
    padding: var(--space-2) var(--space-4) var(--space-3) var(--space-3);
    border-right: 1px solid var(--rule);
    font-weight: 500;
    font-size: var(--fs-control);
    color: var(--ink);
  }
  .index-nav__link:first-child { padding-left: 0; }
  .index-nav__link:hover { background: var(--hover); color: var(--signal-text); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0 var(--space-8);
    list-style: none;
  }
  .grid__span { grid-column: 1 / -1; }

  @media (max-width: 600px) {
    .index-nav__link { min-width: 0; flex: 1 1 33%; padding-left: var(--space-3); }
  }
</style>
