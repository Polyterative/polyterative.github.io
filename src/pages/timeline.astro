---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { experience } from '../data/experience';
import { releases } from '../data/releases';
import { timelineMilestones, type TimelineCategory } from '../data/timeline';

interface TimelineItem {
  id: string;
  sortDate: string;
  year: number;
  dateLabel: string;
  category: TimelineCategory;
  title: string;
  description: string;
  href?: string;
  external?: boolean;
  image?: string;
  imageAlt?: string;
  active?: boolean;
}

const categoryMeta: Record<TimelineCategory, { label: string; icon: string }> = {
  work: { label: 'Work', icon: 'briefcase' },
  release: { label: 'Releases', icon: 'disc' },
  event: { label: 'Events', icon: 'calendar' },
  writing: { label: 'Writing', icon: 'book' },
};
const categories = Object.entries(categoryMeta) as [TimelineCategory, typeof categoryMeta[TimelineCategory]][];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).map<TimelineItem>((post) => {
  const date = new Date(post.data.date);
  return {
    id: `writing-${post.id}`,
    sortDate: date.toISOString().slice(0, 10),
    year: date.getUTCFullYear(),
    dateLabel: new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(date),
    category: 'writing',
    title: post.data.title,
    description: post.data.description,
    href: `/blog/${post.id}`,
  };
});

const workItems = experience.map<TimelineItem>((item) => ({
  id: `work-${item.startDate}-${item.org.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
  sortDate: item.startDate,
  year: Number(item.startDate.slice(0, 4)),
  dateLabel: item.period,
  category: 'work',
  title: `${item.role} · ${item.org}`,
  description: item.desc,
  href: item.orgUrl,
  external: Boolean(item.orgUrl),
  active: item.active,
}));

const releaseItems = releases.map<TimelineItem>((release) => ({
  id: `release-${release.date}-${release.title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
  sortDate: release.date,
  year: Number(release.year),
  dateLabel: release.released,
  category: 'release',
  title: release.title,
  description: release.desc ?? `${release.tracks} ${release.tracks === 1 ? 'track' : 'tracks'} released under the Polyterative alias.`,
  href: release.url,
  external: true,
  image: release.cover,
  imageAlt: `${release.title} cover artwork`,
}));

const milestoneItems = timelineMilestones.map<TimelineItem>((item) => ({
  ...item,
  year: Number(item.sortDate.slice(0, 4)),
}));

const items = [...posts, ...workItems, ...releaseItems, ...milestoneItems]
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate));

const grouped = new Map<number, TimelineItem[]>();
for (const item of items) {
  grouped.set(item.year, [...(grouped.get(item.year) ?? []), item]);
}
const groupedYears = [...grouped.entries()].sort(([a], [b]) => b - a);
const maxYear = groupedYears[0][0];
const minYear = groupedYears.at(-1)![0];
const years = Array.from({ length: maxYear - minYear + 1 }, (_, index) => maxYear - index);

const density = new Map<string, number>();
for (const item of items) {
  const key = `${item.category}-${item.year}`;
  density.set(key, (density.get(key) ?? 0) + 1);
}
---

<BaseLayout
  title="Timeline — Vlady Yakovenko"
  description="A chronological archive of work, releases, writing, and live events by Vlady Yakovenko."
  serial="PLY-T"
>
  <!--
    THESIS: One connected record, not separate portfolio buckets; stacked years replace the standard card gallery.
    OWN-WORLD: Datum Paper / Instrument, hairline strata, one signal trace, and shape-coded milestones in ink.
    STORY: Scan the full span, isolate a discipline, then follow the record from current work back to its roots.
    FIRST VIEWPORT: A large title and archive note lead directly into a four-lane chronogram and category controls.
    FORM: Archive stratigraphy, sixth in the structural set, staged as year bands; seed 08d7c57d.
  -->
  <div class="container container--wide timeline-page">
    <header class="timeline-header">
      <div class="page-head timeline-header__copy">
        <aside class="page-head__aside">
          <span class="plate page-head__idx">0x03</span>
          <span class="lbl">Span</span>
          <span class="data">{minYear}–{maxYear}</span>
          <span class="lbl">Entries</span>
          <span class="data">{items.length}</span>
        </aside>
        <div class="page-head__main">
          <h1>Everything, in time.</h1>
          <p class="page-head__lead">
            Work, releases, writing, and public moments in one continuous record.
            Dates come from the archive itself; ongoing threads stay open.
          </p>
        </div>
      </div>

      <div class="chronogram" aria-label={`Archive activity from ${minYear} to ${maxYear}`}>
        <div class="chronogram__scroll">
          <div class="chronogram__axis" style={`--year-count: ${years.length}`}>
            <span aria-hidden="true"></span>
            {years.map((year) => <a href={`#year-${year}`}>{year}</a>)}
          </div>
          <div class="chronogram__plot">
            {categories.map(([category, meta]) => (
              <div class="chronogram__row" data-chart-row={category} style={`--year-count: ${years.length}`}>
                <span class="chronogram__label lbl">{meta.label}</span>
                {years.map((year) => {
                  const count = density.get(`${category}-${year}`) ?? 0;
                  return (
                    <span class="chronogram__cell" data-chart-category={category}>
                      {count > 0 && (
                        <a
                          href={`#year-${year}`}
                          class:list={['chronogram__mark', `node--${category}`]}
                          style={`--density: ${Math.min(count, 8)}`}
                          title={`${count} ${meta.label.toLowerCase()} ${count === 1 ? 'entry' : 'entries'} in ${year}`}
                          aria-label={`Jump to ${count} ${meta.label.toLowerCase()} ${count === 1 ? 'entry' : 'entries'} in ${year}`}
                        ></a>
                      )}
                    </span>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="timeline-controls" role="group" aria-label="Filter timeline">
        <span class="lbl timeline-controls__lbl">Filter</span>
        <button class="filter filter--active" type="button" data-timeline-filter="all" aria-pressed="true">All</button>
        {categories.map(([category, meta]) => (
          <button class="filter" type="button" data-timeline-filter={category} aria-pressed="false">
            <span class:list={['filter__node', `node--${category}`]} aria-hidden="true"></span>
            {meta.label}
          </button>
        ))}
      </div>
    </header>

    <div class="timeline-archive" id="timeline-archive" aria-live="polite">
      {groupedYears.map(([year, yearItems]) => (
        <section class="timeline-year" id={`year-${year}`} data-timeline-year>
          <div class="timeline-year__stamp">
            <h2 class="plate">{year}</h2>
            <span class="lbl">{yearItems.length} {yearItems.length === 1 ? 'entry' : 'entries'}</span>
          </div>
          <div class="timeline-year__events">
            {yearItems.map((item) => {
              const meta = categoryMeta[item.category];
              const linkAttrs = item.external ? { target: '_blank', rel: 'noopener' } : {};
              return (
                <article class="timeline-event" data-timeline-event data-category={item.category}>
                  <span class:list={['timeline-event__node', `node--${item.category}`]} aria-hidden="true"></span>
                  <div class="timeline-event__date">
                    <span class="lbl timeline-event__type">{meta.label}</span>
                    <time class="data" datetime={item.sortDate}>{item.dateLabel}</time>
                    {item.active && <span class="pill pill--live">Ongoing</span>}
                  </div>
                  <div class="timeline-event__body">
                    <h3>
                      {item.href
                        ? <a class="iclink" href={item.href} {...linkAttrs}>{item.title}<Icon name={item.external ? 'arrow-up-right' : 'arrow-right'} size={14} /></a>
                        : item.title
                      }
                    </h3>
                    <p>{item.description}</p>
                  </div>
                  {item.image && (
                    <a class="timeline-event__image" href={item.href} {...linkAttrs} tabindex="-1" aria-hidden="true">
                      <img src={item.image} alt={item.imageAlt ?? ''} width="180" height="180" loading="lazy" />
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))}
      <p class="timeline-empty" hidden>No entries in this category yet.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-timeline-filter]'));
  const events = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-event]'));
  const years = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-year]'));
  const chartRows = Array.from(document.querySelectorAll<HTMLElement>('[data-chart-row]'));
  const emptyState = document.querySelector<HTMLElement>('.timeline-empty');

  function applyFilter(selected: string) {
    for (const event of events) {
      event.hidden = selected !== 'all' && event.dataset.category !== selected;
    }
    for (const year of years) {
      year.hidden = !year.querySelector('[data-timeline-event]:not([hidden])');
    }
    for (const row of chartRows) {
      row.classList.toggle('chronogram__row--muted', selected !== 'all' && row.dataset.chartRow !== selected);
    }
    for (const filter of filters) {
      const active = filter.dataset.timelineFilter === selected;
      filter.classList.toggle('filter--active', active);
      filter.setAttribute('aria-pressed', String(active));
    }
    if (emptyState) emptyState.hidden = events.some((event) => !event.hidden);
  }

  for (const filter of filters) {
    filter.addEventListener('click', () => applyFilter(filter.dataset.timelineFilter ?? 'all'));
  }
</script>

<style>
  .timeline-page { --timeline-rail: 15px; }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
    padding-bottom: var(--space-10);
  }
  .timeline-header__copy { padding-bottom: 0; }
  .timeline-header h1 {
    max-width: 10ch;
    font-size: clamp(3.2rem, 9vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  /* ── Chronogram: four lanes, one mark per year with entries ── */
  .chronogram {
    width: 100%;
    min-width: 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-3) var(--space-4);
  }
  .chronogram__scroll { width: 100%; max-width: 100%; overflow-x: auto; scrollbar-width: thin; }
  .chronogram__axis,
  .chronogram__row {
    display: grid;
    grid-template-columns: 86px repeat(var(--year-count), minmax(44px, 1fr));
    min-width: 790px;
  }
  .chronogram__axis { padding-bottom: var(--space-2); }
  .chronogram__axis a {
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    text-align: center;
  }
  .chronogram__axis a:hover { color: var(--signal-text); }

  .chronogram__plot { position: relative; overflow: hidden; }
  /* The one signal trace: the baseline of the record. Drawn once, no animation. */
  .chronogram__plot::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 86px;
    height: 1px;
    content: "";
    background: var(--signal);
  }

  .chronogram__row { min-height: 40px; }
  .chronogram__row--muted { opacity: 0.2; }
  .chronogram__label { display: inline-flex; align-items: center; }

  .chronogram__cell { position: relative; display: grid; place-items: center; }
  .chronogram__cell::before {
    position: absolute;
    right: 0;
    left: 0;
    height: 1px;
    content: "";
    background: var(--rule);
  }

  .chronogram__mark,
  .filter__node,
  .timeline-event__node {
    display: block;
    background: var(--bg);
    border: 1px solid var(--ink);
  }
  .chronogram__mark {
    z-index: 1;
    width: calc(6px + var(--density) * 1.4px);
    height: calc(6px + var(--density) * 1.4px);
    min-width: 8px;
    min-height: 8px;
  }
  .chronogram__mark:hover { z-index: 2; background: var(--ink); }

  /* Shape codes the category; colour stays ink. */
  .node--work { border-radius: 0; }
  .node--release { border-radius: 50%; }
  .node--event { transform: rotate(45deg); }
  .node--writing { border-radius: 50%; background: var(--ink); box-shadow: inset 0 0 0 2px var(--bg); }

  /* ── Filters: tabs, grotesk, one form ── */
  .timeline-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .timeline-controls__lbl { margin-right: var(--space-2); }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--f-grotesk);
    font-weight: 500;
    font-size: var(--fs-control);
    cursor: pointer;
  }
  .filter:hover { color: var(--ink); border-color: var(--ink); }
  .filter--active {
    color: var(--ink);
    border-color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--signal);
  }
  .filter__node { width: 9px; height: 9px; }
  .filter__node.node--event { width: 8px; height: 8px; }

  /* ── Archive ── */
  .timeline-archive { padding-top: var(--space-2); }

  .timeline-year {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr);
    gap: var(--space-6);
    border-top: 1px solid var(--ink);
    scroll-margin-top: var(--space-4);
  }
  .timeline-year__stamp {
    position: sticky;
    top: var(--space-4);
    align-self: start;
    padding-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .timeline-year__stamp h2 { font-size: 44px; font-weight: 400; letter-spacing: 0; line-height: 1; }

  .timeline-year__events { position: relative; }
  .timeline-year__events::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--timeline-rail);
    width: 1px;
    content: "";
    background: var(--rule-strong);
  }

  .timeline-event {
    position: relative;
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) auto;
    gap: var(--space-6);
    padding: var(--space-6) 0 var(--space-6) 54px;
    border-bottom: 1px solid var(--rule);
  }
  .timeline-event:last-child { border-bottom: 0; }
  .timeline-event[hidden],
  .timeline-year[hidden] { display: none; }

  .timeline-event::before {
    position: absolute;
    top: calc(var(--space-6) + 7px);
    left: calc(var(--timeline-rail) + 1px);
    width: 25px;
    height: 1px;
    content: "";
    background: var(--rule-strong);
  }
  .timeline-event__node {
    position: absolute;
    z-index: 1;
    top: calc(var(--space-6) + 1px);
    left: calc(var(--timeline-rail) - 6px);
    width: 13px;
    height: 13px;
  }
  .timeline-event__node.node--event { width: 11px; height: 11px; left: calc(var(--timeline-rail) - 5px); top: calc(var(--space-6) + 2px); }

  .timeline-event__date {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-2);
  }
  .timeline-event__date .data { color: var(--ink); }

  .timeline-event__body { min-width: 0; }
  .timeline-event__body h3 { font-size: 18px; }
  .timeline-event__body h3 a :global(.icon) { color: var(--ink-3); }
  .timeline-event__body h3 a:hover { color: var(--signal-text); }
  .timeline-event__body h3 a:hover :global(.icon) { color: currentColor; }
  .timeline-event__body p {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .timeline-event__image {
    width: 92px;
    height: 92px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--hover);
  }
  .timeline-event__image:hover { border-color: var(--ink); }
  .timeline-event__image img { width: 100%; height: 100%; object-fit: cover; }

  .timeline-empty { padding-block: var(--space-16); color: var(--ink-2); }

  @media (max-width: 860px) {
    .timeline-year { grid-template-columns: 72px minmax(0, 1fr); gap: var(--space-4); }
    .timeline-year__stamp h2 { font-size: 24px; }
    .timeline-event {
      grid-template-columns: 1fr auto;
      gap: var(--space-3) var(--space-4);
      padding-left: 48px;
    }
    .timeline-event__date {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
    .timeline-event__body { grid-column: 1; }
    .timeline-event__image { grid-column: 2; width: 76px; height: 76px; }
  }

  @media (max-width: 520px) {
    .timeline-page { --timeline-rail: 9px; }
    .timeline-header h1 { font-size: clamp(3rem, 15vw, 4.4rem); }
    .timeline-year { display: block; }
    .timeline-year__stamp {
      position: relative;
      top: auto;
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-4) 0 var(--space-2);
    }
    .timeline-year__stamp h2 { font-size: 32px; }
    .timeline-event {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-6) 0 var(--space-6) 38px;
    }
    .timeline-event::before { width: 18px; }
    .timeline-event__image {
      grid-column: 1;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 8;
    }
  }
</style>
