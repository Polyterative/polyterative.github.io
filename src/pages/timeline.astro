---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { experience } from '../data/experience';
import { releases } from '../data/releases';
import { timelineMilestones, type TimelineCategory } from '../data/timeline';

interface TimelineItem {
  id: string;
  sortDate: string;
  year: number;
  dateLabel: string;
  category: TimelineCategory;
  title: string;
  description: string;
  href?: string;
  external?: boolean;
  image?: string;
  imageAlt?: string;
  active?: boolean;
}

const categoryMeta: Record<TimelineCategory, { label: string; icon: string }> = {
  work: { label: 'Work', icon: 'briefcase' },
  release: { label: 'Releases', icon: 'disc' },
  event: { label: 'Events', icon: 'calendar' },
  writing: { label: 'Writing', icon: 'book' },
};
const categories = Object.entries(categoryMeta) as [TimelineCategory, typeof categoryMeta[TimelineCategory]][];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).map<TimelineItem>((post) => {
  const date = new Date(post.data.date);
  return {
    id: `writing-${post.id}`,
    sortDate: date.toISOString().slice(0, 10),
    year: date.getUTCFullYear(),
    dateLabel: new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(date),
    category: 'writing',
    title: post.data.title,
    description: post.data.description,
    href: `/blog/${post.id}`,
  };
});

const workItems = experience.map<TimelineItem>((item) => ({
  id: `work-${item.startDate}-${item.org.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
  sortDate: item.startDate,
  year: Number(item.startDate.slice(0, 4)),
  dateLabel: item.period,
  category: 'work',
  title: `${item.role} · ${item.org}`,
  description: item.desc,
  href: item.orgUrl,
  external: Boolean(item.orgUrl),
  active: item.active,
}));

const releaseItems = releases.map<TimelineItem>((release) => ({
  id: `release-${release.date}-${release.title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
  sortDate: release.date,
  year: Number(release.year),
  dateLabel: release.released,
  category: 'release',
  title: release.title,
  description: release.desc ?? `${release.tracks} ${release.tracks === 1 ? 'track' : 'tracks'} released under the Polyterative alias.`,
  href: release.url,
  external: true,
  image: release.cover,
  imageAlt: `${release.title} cover artwork`,
}));

const milestoneItems = timelineMilestones.map<TimelineItem>((item) => ({
  ...item,
  year: Number(item.sortDate.slice(0, 4)),
}));

const items = [...posts, ...workItems, ...releaseItems, ...milestoneItems]
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate));

const grouped = new Map<number, TimelineItem[]>();
for (const item of items) {
  grouped.set(item.year, [...(grouped.get(item.year) ?? []), item]);
}
const groupedYears = [...grouped.entries()].sort(([a], [b]) => b - a);
const maxYear = groupedYears[0][0];
const minYear = groupedYears.at(-1)![0];
const years = Array.from({ length: maxYear - minYear + 1 }, (_, index) => maxYear - index);

const density = new Map<string, number>();
for (const item of items) {
  const key = `${item.category}-${item.year}`;
  density.set(key, (density.get(key) ?? 0) + 1);
}
---

<BaseLayout
  title="Timeline — Vlady Yakovenko"
  description="A chronological archive of work, releases, writing, and live events by Vlady Yakovenko."
>
  <!--
    THESIS: One connected record, not separate portfolio buckets; stacked years replace the standard card gallery.
    OWN-WORLD: Warm paper or dim blue, hairline strata, one electric-blue trace, and shape-coded milestones.
    STORY: Scan the full span, isolate a discipline, then follow the record from current work back to its roots.
    FIRST VIEWPORT: A large title and archive note lead directly into a four-lane chronogram and category controls.
    FORM: Archive stratigraphy, sixth in the structural set, staged as year bands; seed 08d7c57d.
  -->
  <div class="container container--wide timeline-page">
    <header class="timeline-header">
      <div class="timeline-header__copy">
        <h1>Everything, in time.</h1>
        <p>
          Work, releases, writing, and public moments in one continuous record.
          Dates come from the archive itself; ongoing threads stay open.
        </p>
      </div>

      <div class="chronogram" aria-label={`Archive activity from ${minYear} to ${maxYear}`}>
        <div class="chronogram__scroll">
          <div class="chronogram__axis" style={`--year-count: ${years.length}`}>
            <span aria-hidden="true"></span>
            {years.map((year) => <a href={`#year-${year}`}>{year}</a>)}
          </div>
          <div class="chronogram__plot">
            {categories.map(([category, meta]) => (
              <div class="chronogram__row" data-chart-row={category} style={`--year-count: ${years.length}`}>
                <span class="chronogram__label"><Icon name={meta.icon} size={12} />{meta.label}</span>
                {years.map((year) => {
                  const count = density.get(`${category}-${year}`) ?? 0;
                  return (
                    <span class="chronogram__cell" data-chart-category={category}>
                      {count > 0 && (
                        <a
                          href={`#year-${year}`}
                          class:list={['chronogram__mark', `node--${category}`]}
                          style={`--density: ${Math.min(count, 8)}`}
                          title={`${count} ${meta.label.toLowerCase()} ${count === 1 ? 'entry' : 'entries'} in ${year}`}
                          aria-label={`Jump to ${count} ${meta.label.toLowerCase()} ${count === 1 ? 'entry' : 'entries'} in ${year}`}
                        ></a>
                      )}
                    </span>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="timeline-controls" role="group" aria-label="Filter timeline">
        <button class="filter filter--active" type="button" data-timeline-filter="all" aria-pressed="true">All</button>
        {categories.map(([category, meta]) => (
          <button class="filter" type="button" data-timeline-filter={category} aria-pressed="false">
            <span class:list={['filter__node', `node--${category}`]} aria-hidden="true"></span>
            {meta.label}
          </button>
        ))}
      </div>
    </header>

    <div class="timeline-archive" id="timeline-archive" aria-live="polite">
      {groupedYears.map(([year, yearItems]) => (
        <section class="timeline-year" id={`year-${year}`} data-timeline-year>
          <div class="timeline-year__stamp">
            <h2>{year}</h2>
            <span>{yearItems.length} {yearItems.length === 1 ? 'entry' : 'entries'}</span>
          </div>
          <div class="timeline-year__events">
            {yearItems.map((item) => {
              const meta = categoryMeta[item.category];
              const linkAttrs = item.external ? { target: '_blank', rel: 'noopener' } : {};
              return (
                <article class="timeline-event" data-timeline-event data-category={item.category}>
                  <span class:list={['timeline-event__node', `node--${item.category}`]} aria-hidden="true"></span>
                  <div class="timeline-event__date">
                    <span class="timeline-event__type"><Icon name={meta.icon} size={12} />{meta.label}</span>
                    <time datetime={item.sortDate}>{item.dateLabel}</time>
                    {item.active && <span class="timeline-event__active">Ongoing</span>}
                  </div>
                  <div class="timeline-event__body">
                    <h3>
                      {item.href
                        ? <a class="iclink" href={item.href} {...linkAttrs}>{item.title}<Icon name={item.external ? 'arrow-up-right' : 'arrow-right'} size={14} /></a>
                        : item.title
                      }
                    </h3>
                    <p>{item.description}</p>
                  </div>
                  {item.image && (
                    <a class="timeline-event__image" href={item.href} {...linkAttrs} tabindex="-1" aria-hidden="true">
                      <img src={item.image} alt={item.imageAlt ?? ''} width="180" height="180" loading="lazy" />
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))}
      <p class="timeline-empty" hidden>No entries in this category yet.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-timeline-filter]'));
  const events = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-event]'));
  const years = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-year]'));
  const chartRows = Array.from(document.querySelectorAll<HTMLElement>('[data-chart-row]'));
  const emptyState = document.querySelector<HTMLElement>('.timeline-empty');

  function applyFilter(selected: string) {
    for (const event of events) {
      event.hidden = selected !== 'all' && event.dataset.category !== selected;
    }
    for (const year of years) {
      year.hidden = !year.querySelector('[data-timeline-event]:not([hidden])');
    }
    for (const row of chartRows) {
      row.classList.toggle('chronogram__row--muted', selected !== 'all' && row.dataset.chartRow !== selected);
    }
    for (const filter of filters) {
      const active = filter.dataset.timelineFilter === selected;
      filter.classList.toggle('filter--active', active);
      filter.setAttribute('aria-pressed', String(active));
    }
    if (emptyState) emptyState.hidden = events.some((event) => !event.hidden);
  }

  for (const filter of filters) {
    filter.addEventListener('click', () => applyFilter(filter.dataset.timelineFilter ?? 'all'));
  }
</script>

<style>
  .timeline-page {
    --timeline-rail: 15px;
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
    padding-block: var(--space-24) var(--space-12);
    border-bottom: 1px solid var(--color-line);
  }

  .timeline-header__copy {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    align-items: end;
    gap: var(--space-10);
  }

  .timeline-header h1 {
    max-width: 10ch;
    font-size: clamp(3.2rem, 9vw, 5.8rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
  }

  .timeline-header__copy p {
    max-width: 48ch;
    color: var(--color-muted);
    font-size: var(--font-size-lg);
    line-height: 1.65;
  }

  .chronogram {
    width: 100%;
    min-width: 0;
    border-block: 1px solid var(--color-line);
    padding-block: var(--space-5);
  }

  .chronogram__scroll {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .chronogram__axis,
  .chronogram__row {
    display: grid;
    grid-template-columns: 86px repeat(var(--year-count), minmax(44px, 1fr));
    min-width: 790px;
  }

  .chronogram__axis {
    padding-bottom: var(--space-2);
  }

  .chronogram__axis a {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-faint);
    text-align: center;
  }

  .chronogram__axis a:hover {
    color: var(--color-text);
  }

  .chronogram__plot {
    position: relative;
    overflow: hidden;
  }

  .chronogram__plot::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 86px;
    height: 1px;
    content: "";
    background: var(--color-accent);
    opacity: 0.55;
    transform-origin: left center;
    animation: reveal-trace 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes reveal-trace {
    from { transform: scaleX(0.08); opacity: 0.15; }
    to { transform: scaleX(1); opacity: 0.55; }
  }

  .chronogram__row {
    min-height: 42px;
    transition: opacity var(--transition);
  }

  .chronogram__row--muted {
    opacity: 0.16;
  }

  .chronogram__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .chronogram__label :global(.icon) {
    color: var(--color-faint);
  }

  .chronogram__cell {
    position: relative;
    display: grid;
    place-items: center;
  }

  .chronogram__cell::before {
    position: absolute;
    right: 0;
    left: 0;
    height: 1px;
    content: "";
    background: var(--color-line);
  }

  .chronogram__mark,
  .filter__node,
  .timeline-event__node {
    display: block;
    background: var(--color-bg);
    border: 1.5px solid var(--color-accent);
  }

  .chronogram__mark {
    z-index: 1;
    width: calc(6px + var(--density) * 1.4px);
    height: calc(6px + var(--density) * 1.4px);
    min-width: 8px;
    min-height: 8px;
    transition: transform var(--transition), background var(--transition);
  }

  .chronogram__mark:hover {
    z-index: 2;
    background: var(--color-accent);
    transform: scale(1.35);
  }

  .node--work { border-radius: 1px; }
  .node--release { border-radius: 50%; }
  .node--event { transform: rotate(45deg); border-radius: 1px; }
  .node--writing {
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: inset 0 0 0 2px var(--color-bg);
  }

  .chronogram__mark.node--event:hover {
    transform: rotate(45deg) scale(1.35);
  }

  .timeline-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .filter:hover {
    color: var(--color-text);
    border-color: var(--color-muted);
  }

  .filter--active {
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
    background: var(--color-accent-weak);
  }

  .filter__node {
    width: 9px;
    height: 9px;
  }

  .timeline-archive {
    padding-top: var(--space-4);
  }

  .timeline-year {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: var(--space-8);
    scroll-margin-top: 120px;
  }

  .timeline-year__stamp {
    position: sticky;
    top: 96px;
    align-self: start;
    padding-top: var(--space-12);
  }

  .timeline-year__stamp h2 {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .timeline-year__stamp span {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-faint);
  }

  .timeline-year__events {
    position: relative;
  }

  .timeline-year__events::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--timeline-rail);
    width: 1px;
    content: "";
    background: linear-gradient(var(--color-line), var(--color-accent) 16%, var(--color-accent) 84%, var(--color-line));
  }

  .timeline-event {
    position: relative;
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) auto;
    gap: var(--space-6);
    min-height: 128px;
    padding: var(--space-10) 0 var(--space-10) 54px;
    border-bottom: 1px solid var(--color-line);
  }

  .timeline-event[hidden],
  .timeline-year[hidden] {
    display: none;
  }

  .timeline-event::before {
    position: absolute;
    top: calc(var(--space-10) + 7px);
    left: calc(var(--timeline-rail) + 1px);
    width: 25px;
    height: 1px;
    content: "";
    background: var(--color-border);
  }

  .timeline-event__node {
    position: absolute;
    z-index: 1;
    top: calc(var(--space-10) + 1px);
    left: calc(var(--timeline-rail) - 6px);
    width: 13px;
    height: 13px;
  }

  .timeline-event__date {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-faint);
  }

  .timeline-event__type {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
  }

  .timeline-event__type :global(.icon) {
    color: var(--color-accent);
  }

  .timeline-event__active {
    color: var(--color-accent-ink);
  }

  .timeline-event__active::before {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--color-accent);
    content: "";
    vertical-align: 1px;
  }

  .timeline-event__body {
    min-width: 0;
  }

  .timeline-event__body h3 {
    font-size: 1.08rem;
  }

  .timeline-event__body h3 a:hover {
    color: var(--color-accent-ink);
  }

  .timeline-event__body p {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    line-height: 1.65;
  }

  .timeline-event__image {
    width: 92px;
    height: 92px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-hover);
  }

  .timeline-event__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-event__image:hover img {
    transform: scale(1.04);
  }

  .timeline-empty {
    padding-block: var(--space-16);
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .timeline-header {
      padding-block: var(--space-16) var(--space-10);
    }

    .timeline-header__copy {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .timeline-year {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: var(--space-4);
    }

    .timeline-year__stamp {
      top: 132px;
    }

    .timeline-event {
      grid-template-columns: 1fr auto;
      gap: var(--space-4);
      padding-left: 48px;
    }

    .timeline-event__date {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }

    .timeline-event__body {
      grid-column: 1;
    }

    .timeline-event__image {
      grid-column: 2;
      width: 76px;
      height: 76px;
    }
  }

  @media (max-width: 520px) {
    .timeline-page {
      --timeline-rail: 9px;
    }

    .timeline-header h1 {
      font-size: clamp(3rem, 16vw, 4.6rem);
    }

    .timeline-year {
      display: block;
    }

    .timeline-year__stamp {
      position: relative;
      top: auto;
      z-index: 2;
      padding: var(--space-10) 0 var(--space-2);
      background: var(--color-bg);
    }

    .timeline-year__stamp span {
      display: inline;
      margin-left: var(--space-2);
    }

    .timeline-event {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-8) 0 var(--space-8) 38px;
    }

    .timeline-event::before {
      top: calc(var(--space-8) + 7px);
      width: 18px;
    }

    .timeline-event__node {
      top: calc(var(--space-8) + 1px);
    }

    .timeline-event__image {
      grid-column: 1;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 8;
    }
  }
</style>
