---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { education, experience } from '../data/experience';
import { pad } from '../lib/datum';

const currentFocus = [
  { text: 'Shipping Kinetip — a native macOS pen-tablet driver, in release hardening', href: '/apps/kinetip' },
  { text: 'Maintaining Patcher — open-source Eurorack workspace, currently v6.5', href: '/apps/patcher' },
  { text: 'Building Impulse — node-based visual engine for live AV performance', href: '/apps/impulse' },
  { text: 'Music with Ableton Live and Eurorack modular', href: 'https://polyterative.bandcamp.com' },
  { text: 'Voice-driven development with Talon Voice', href: 'https://github.com/polyterative/Poly-Talon-Scripts' },
];

const profileSnapshot = [
  { label: 'Practice', value: 'Product design, interface systems, frontend implementation, creative tooling' },
  { label: 'Background', value: 'Design and engineering, with most recent work spanning analytics software and self-initiated tools' },
  { label: 'Tools', value: 'TypeScript, Angular, RxJS, Figma, HTML/CSS, Supabase, PostgreSQL' },
  { label: 'Recurring interests', value: 'Dense software, reactive systems, audiovisual tooling, notation, workflow design' },
];

const tools = [
  { label: 'Daily languages', icon: 'code', items: ['.ts', '.html', '.scss', '.svg'] },
  { label: 'Frontend', icon: 'layers', items: ['Angular', 'RxJS', 'TypeScript', 'HTML/CSS'] },
  { label: 'Creative code', icon: 'terminal', items: ['WebGPU', 'Three.js', 'p5.js', 'OSC'] },
  { label: 'Design', icon: 'star', items: ['Figma', 'Photoshop', 'Illustrator'] },
  { label: 'Backend', icon: 'activity', items: ['Supabase', 'PostgreSQL', 'Node.js'] },
  { label: 'Music', icon: 'music', items: ['Ableton Live', 'Eurorack', 'Max for Live'] },
];

const links = [
  { label: 'Code', icon: 'github', value: 'github.com/polyterative', href: 'https://github.com/polyterative' },
  { label: 'Music', icon: 'music', value: 'polyterative.bandcamp.com', href: 'https://polyterative.bandcamp.com' },
  { label: 'Visual', icon: 'instagram', value: '@polyterative', href: 'https://www.instagram.com/polyterative/' },
  { label: 'App', icon: 'external', value: 'patcher.xyz', href: 'https://patcher.xyz' },
  { label: 'Email', icon: 'mail', value: 'polyterative@outlook.com', href: 'mailto:polyterative@outlook.com' },
];
---

<BaseLayout
  title="About — Vlady Yakovenko"
  description="Background, current work, and tools used by Vlady Yakovenko across design, software, music, and visual systems."
  serial="PLY-B"
>
  <div class="container container--wide">

    <header class="page-head">
      <aside class="page-head__aside">
        <span class="plate page-head__idx">06</span>
        <span class="lbl">Handle</span>
        <span class="data">polyterative</span>
        <span class="lbl">Base</span>
        <span class="data">Bologna, Italy</span>
        <span class="lbl">Email</span>
        <a class="data about-mail" href="mailto:polyterative@outlook.com">polyterative@outlook.com</a>
      </aside>
      <div class="page-head__main">
        <h1>Vlady Yakovenko</h1>
        <p class="page-head__lead">
          Designer with a strong engineering background, mostly interested in complex interfaces, technical systems, and tools that need both structural clarity and visual judgment.
        </p>
        <p class="page-head__note">
          I still make music and visuals, and that practice feeds back into the software work. The through-line is fairly consistent: systems, notation, timing, interaction, and tools that are shaped around how people actually work.
        </p>
      </div>
    </header>

    <section class="sec">
      <header class="sec__head">
        <span class="plate sec__idx">01</span>
        <h2 class="sec__title">Practice</h2>
        <span class="lbl">{profileSnapshot.length} fields</span>
      </header>
      <div class="sec__body">
        <dl class="htbl">
          {profileSnapshot.map((item, i) => (
            <div>
              <dt><span class="n">{pad(i + 1)}</span>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="sec">
      <header class="sec__head">
        <span class="plate sec__idx">02</span>
        <h2 class="sec__title">Now</h2>
        <span class="lbl">{currentFocus.length} active threads</span>
      </header>
      <div class="sec__body">
        <div class="planter now">
          <span class="lbl">Current focus</span>
          <ul class="now-list">
            {currentFocus.map((item, i) => {
              const ext = item.href.startsWith('http');
              return (
                <li>
                  <span class="lbl now-list__n">{pad(i + 1)}</span>
                  <a href={item.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                    {item.text}<Icon name={ext ? 'arrow-up-right' : 'arrow-right'} size={13} />
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>

    <section class="sec">
      <header class="sec__head">
        <span class="plate sec__idx">03</span>
        <h2 class="sec__title">Experience</h2>
        <span class="lbl">{experience.length} roles</span>
      </header>
      <div class="sec__body">
        <div class="rows">
          {experience.map(item => (
            <article class="row">
              <div class="row__period">
                <time class="data">{item.period}</time>
                {item.active && <span class="pill pill--live">Ongoing</span>}
              </div>
              <div class="row__body">
                <h3 class="row__role">{item.role}</h3>
                {item.orgUrl
                  ? <a class="row__org" href={item.orgUrl} target="_blank" rel="noopener">{item.org}<Icon name="arrow-up-right" size={12} /></a>
                  : <p class="row__org">{item.org}</p>
                }
                <p class="row__desc">{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec">
      <header class="sec__head">
        <span class="plate sec__idx">04</span>
        <h2 class="sec__title">Education</h2>
      </header>
      <div class="sec__body">
        <div class="rows">
          <article class="row">
            <div class="row__period"><time class="data">{education.period}</time></div>
            <div class="row__body">
              <h3 class="row__role">{education.degree}</h3>
              <p class="row__org">{education.institution}</p>
              <p class="row__desc">Final grade: {education.grade}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="sec" id="tools">
      <header class="sec__head">
        <span class="plate sec__idx">05</span>
        <h2 class="sec__title">Tools</h2>
        <span class="lbl">{tools.length} groups</span>
      </header>
      <div class="sec__body">
        <dl class="htbl tools">
          {tools.map((group, i) => (
            <div>
              <dt><span class="n">{pad(i + 1)}</span>{group.label}</dt>
              <dd>
                <ul class="taglist tools__items">
                  {group.items.map(item => <li>{item}</li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="sec">
      <header class="sec__head">
        <span class="plate sec__idx">06</span>
        <h2 class="sec__title">Find me</h2>
      </header>
      <div class="sec__body">
        <ul class="link-list">
          {links.map(l => {
            const ext = l.href.startsWith('http');
            return (
              <li>
                <a href={l.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                  <span class="lbl">{l.label}</span>
                  <span class="link-list__value">{l.value}<Icon name={ext ? 'arrow-up-right' : 'mail'} size={13} /></span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-mail { color: var(--ink); border-bottom: 1px solid var(--rule-strong); align-self: flex-start; }
  .about-mail:hover { color: var(--signal-text); border-color: currentColor; }

  /* ── Now: the one planter block on this page ── */
  .now { display: flex; flex-direction: column; gap: var(--space-3); max-width: var(--max-w); }
  .now-list { list-style: none; display: flex; flex-direction: column; }
  .now-list li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: var(--space-2);
    align-items: baseline;
    padding-block: var(--space-3);
    border-top: 1px solid color-mix(in srgb, var(--moss) 35%, transparent);
    font-size: 17px;
    line-height: 1.45;
  }
  .now-list__n { color: var(--moss); }
  .now-list a { color: var(--ink); }
  .now-list a :global(.icon) { color: var(--ink-3); margin-left: var(--space-2); }
  .now-list a:hover { color: var(--signal-text); }
  .now-list a:hover :global(.icon) { color: currentColor; }

  /* ── Experience / education rows ── */
  .rows { display: flex; flex-direction: column; border-top: 1px solid var(--ink); max-width: 860px; }
  .row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
  }
  .row__period { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .row__period .data { color: var(--ink); white-space: nowrap; }
  .row__body { display: flex; flex-direction: column; gap: var(--space-1); }
  .row__role { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
  .row__org {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    font-weight: 500;
    font-size: 15px;
    color: var(--ink-2);
  }
  a.row__org:hover { color: var(--signal-text); }
  .row__desc { font-size: 15px; color: var(--ink-2); line-height: 1.55; margin-top: var(--space-2); max-width: 62ch; }

  .htbl { max-width: 860px; }
  .tools__items li { font-size: 14px; color: var(--ink); }

  /* ── Links ── */
  .link-list { list-style: none; display: flex; flex-direction: column; border-top: 1px solid var(--ink); max-width: 860px; }
  .link-list li { border-bottom: 1px solid var(--rule); }
  .link-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 44px;
    padding-block: var(--space-3);
  }
  .link-list__value {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 15px;
    font-weight: 500;
    overflow-wrap: anywhere;
    text-align: right;
  }
  .link-list__value :global(.icon) { color: var(--ink-3); }
  .link-list a:hover .link-list__value { color: var(--signal-text); }
  .link-list a:hover :global(.icon) { color: currentColor; }

  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: var(--space-2); }
    .row__period { flex-direction: row; align-items: center; flex-wrap: wrap; }
  }
</style>
