---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    role: 'UX Engineer',
    org: 'XTEL',
    period: 'Current',
    desc: 'Building enterprise frontend for FMCG and retail — TypeScript, Angular, RxJS, SCSS, SVG. Responsible for UI architecture and component design across complex data-heavy interfaces.',
  },
  {
    role: 'Founder & Maintainer',
    org: 'Patcher — patcher.xyz',
    period: '2021 — Present',
    desc: 'Open-source workspace for Eurorack musicians. Angular + Supabase (PostgreSQL). Ships a patch editor, rack planner, and community module database. Currently v5.3.7.',
  },
  {
    role: 'Speaker',
    org: 'Public workshop (Bologna)',
    period: '2022',
    desc: '"Angular Flex: Building with Style" — design principles and a live UI build using Angular Flex Layout.',
  },
  {
    role: 'Community',
    org: 'Bologna Modulare / Eurorack Italy',
    period: '2019 — Present',
    desc: 'Active in the Italian modular synthesis community — events, jams, gear exchange, and documentation.',
  },
  {
    role: 'Open Source',
    org: 'github.com/polyterative',
    period: '2015 — Present',
    desc: '17 public repos: creative coding frameworks, developer tooling, IoT firmware, and community apps.',
  },
];

const currentFocus = [
  { text: 'Audio-reactive visuals with Angular and Three.js', href: 'https://github.com/polyterative/POLY_REACTIVE_VISUALS' },
  { text: 'Music with Ableton Live and Eurorack', href: 'https://polyterative.bandcamp.com' },
  { text: 'Maintaining Patcher', href: 'https://patcher.xyz' },
  { text: 'Voice-driven development with Talon Voice', href: 'https://github.com/polyterative/Poly-Talon-Scripts' },
];

const tools = [
  { label: 'Daily languages', items: ['.ts', '.html', '.scss', '.svg'] },
  { label: 'Frontend', items: ['Angular', 'RxJS', 'TypeScript', 'HTML/CSS'] },
  { label: 'Creative code', items: ['Three.js', 'p5.js', 'TouchDesigner', 'OSC'] },
  { label: 'Design', items: ['Figma', 'Photoshop', 'Illustrator'] },
  { label: 'Backend', items: ['Supabase', 'PostgreSQL', 'Node.js'] },
  { label: 'Music', items: ['Ableton Live', 'Eurorack', 'Max for Live'] },
];
---

<BaseLayout
  title="About — Vlady Yakovenko"
  description="Vlady Yakovenko (polyterative) — UX engineer, generative visual artist, and electronic musician based in Bologna, Italy. Background, tools, and current focus."
>
  <section class="section">
    <div class="container">

      <!-- Bio -->
      <header class="about-header">
        <span class="tag">About</span>
        <h1>Vlady Yakovenko</h1>
        <p class="about-handle">polyterative &nbsp;·&nbsp; Bologna, Italy</p>
        <p class="about-bio">
          UX engineer and polyglot artist. The same attention to systems, feedback loops,
          and craft applies whether I'm writing reactive TypeScript, patching a modular synthesizer,
          or composing a visual set. Most of what I make is free and open source.
        </p>
        <div class="about-contact">
          <span class="about-contact__label">Booking & enquiries</span>
          <a href="mailto:polyterative@outlook.com">polyterative@outlook.com</a>
        </div>
      </header>

      <hr class="divider" />

      <!-- Now -->
      <section class="about-section">
        <h2 class="about-section__title">Now</h2>
        <ul class="now-list">
          {currentFocus.map(item => (
            <li>
              <span class="now-dot">—</span>
              <a href={item.href} target="_blank" rel="noopener">{item.text}</a>
            </li>
          ))}
        </ul>
      </section>

      <hr class="divider" />

      <!-- Experience -->
      <section class="about-section">
        <h2 class="about-section__title">Experience</h2>
        <div class="timeline">
          {experience.map(item => (
            <article class="timeline-item">
              <div class="timeline-item__meta">
                <time class="timeline-item__period">{item.period}</time>
              </div>
              <div class="timeline-item__body">
                <h3 class="timeline-item__role">{item.role}</h3>
                <p class="timeline-item__org">{item.org}</p>
                <p class="timeline-item__desc">{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <hr class="divider" />

      <!-- Tools -->
      <section class="about-section" id="tools">
        <h2 class="about-section__title">Tools</h2>
        <div class="tools-grid">
          {tools.map(group => (
            <div class="tool-group">
              <h4 class="tool-group__label">{group.label}</h4>
              <ul class="tool-group__items">
                {group.items.map(item => <li><span class="tag">{item}</span></li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <hr class="divider" />

      <!-- Links -->
      <section class="about-section">
        <h2 class="about-section__title">Find me</h2>
        <div class="contact-grid">
          <a class="contact-card" href="https://github.com/polyterative" target="_blank" rel="noopener">
            <span class="contact-card__label">Code</span>
            <span class="contact-card__value">github.com/polyterative</span>
          </a>
          <a class="contact-card" href="https://polyterative.bandcamp.com" target="_blank" rel="noopener">
            <span class="contact-card__label">Music</span>
            <span class="contact-card__value">polyterative.bandcamp.com</span>
          </a>
          <a class="contact-card" href="https://www.instagram.com/politerative/" target="_blank" rel="noopener">
            <span class="contact-card__label">Visual</span>
            <span class="contact-card__value">@politerative</span>
          </a>
          <a class="contact-card" href="https://patcher.xyz" target="_blank" rel="noopener">
            <span class="contact-card__label">App</span>
            <span class="contact-card__value">patcher.xyz</span>
          </a>
          <a class="contact-card" href="mailto:polyterative@outlook.com">
            <span class="contact-card__label">Email</span>
            <span class="contact-card__value">polyterative@outlook.com</span>
          </a>
        </div>
      </section>

    </div>
  </section>
</BaseLayout>

<style>
  .about-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }
  .about-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.03em;
  }
  .about-handle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: calc(-1 * var(--space-2));
  }
  .about-bio {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-muted);
    max-width: 60ch;
  }
  .about-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }
  .about-contact__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .about-contact a {
    font-size: 0.95rem;
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-4);
  }
  .about-section__title {
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  /* Now */
  .now-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .now-list li {
    display: flex;
    gap: var(--space-3);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .now-list a {
    color: var(--color-text);
    text-decoration-color: var(--color-border);
  }
  .now-list a:hover {
    text-decoration-color: var(--color-text);
  }
  .now-dot {
    color: var(--color-muted);
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-border), transparent);
    pointer-events: none;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    position: relative;
  }
  .timeline-item:last-child { border-bottom: 1px solid var(--color-border); }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 2px;
    top: calc(var(--space-6) + 6px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
  }
  .timeline-item:first-child::before {
    background: var(--color-text);
    box-shadow: 0 0 0 1px var(--color-text);
  }

  .timeline-item__meta {
    padding-top: 3px;
  }
  .timeline-item__period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .timeline-item__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .timeline-item__role {
    font-size: 1rem;
    font-weight: 600;
  }
  .timeline-item__org {
    font-size: 0.85rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
  }
  .timeline-item__desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-top: var(--space-2);
    max-width: none;
  }

  @media (max-width: 560px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  /* Tools */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-6);
  }
  .tool-group__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }
  .tool-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  /* Links */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  .contact-card:hover {
    border-color: var(--color-muted);
    background: var(--color-accent-soft);
  }
  .contact-card__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-muted);
  }
  .contact-card__value {
    font-size: 0.9rem;
    color: var(--color-text);
    font-weight: 500;
    word-break: break-all;
  }
</style>
