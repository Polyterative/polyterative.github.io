---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const experience = [
  {
    role: 'Product Designer',
    org: 'XTEL',
    orgUrl: 'https://xtel.com',
    period: 'Aug 2024 — Present',
    desc: 'Leading redesign work for advanced analytics software, turning dense enterprise workflows into clearer product directions and a more coherent design language. My engineering background helps keep proposals realistic, implementation-aware, and developer-ready from the start.',
  },
  {
    role: 'Senior Frontend Developer',
    org: 'XTEL',
    orgUrl: 'https://xtel.com',
    period: 'Sep 2021 — Aug 2024',
    desc: 'Owned frontend architecture for promotions-optimization interfaces used in FMCG and retail contexts. Worked across Angular, RxJS, TypeScript, and SCSS while bridging data science, product, and UX on data-heavy workflows where clarity really matters.',
  },
  {
    role: 'Founder',
    org: 'Patcher.xyz',
    orgUrl: 'https://patcher.xyz',
    period: 'Mar 2020 — Present',
    desc: 'Built and continue to run an open-source product from concept to community: product direction, UX, frontend architecture, backend choices, releases, and user feedback loops. A long-running proof that I like owning hard problems end to end.',
  },
  {
    role: 'Frontend / Android / UX Engineer',
    org: 'Otre Solutions',
    period: 'Aug 2017 — Aug 2021',
    desc: 'Worked across manufacturing software for warehouse management, supply-chain planning, and production monitoring. The common thread was translating operational complexity into interfaces people could actually use day to day.',
  },
  {
    role: 'Electronic Music Producer & Live Performer',
    org: 'Freelance',
    period: '2012 — Present',
    desc: 'Long-running creative practice in experimental techno, modular synthesis, and live AV performance. It is separate from my software work, but it strongly informs how I think about systems, rhythm, interaction, and tooling.',
  },
  {
    role: 'Android Engineer',
    org: 'GESP',
    period: 'Jun 2016 — Aug 2016',
    desc: 'Early R&D work on a computer-vision project aimed at speeding up logistics data entry — a short engagement, but a useful introduction to product constraints outside straightforward CRUD apps.',
  },
];

const education = {
  institution: 'IIS Belluzzi-Fioravanti',
  degree: 'Perito Informatico — Computer Science',
  period: '2012 — 2017',
  grade: '99/100',
};

const currentFocus = [
  { text: 'Building Impulse — node-based WebGPU visual engine for live AV performance', href: 'https://github.com/polyterative/impulse' },
  { text: 'Maintaining Patcher — open-source Eurorack patch manager, currently v5.3.7', href: 'https://patcher.xyz' },
  { text: 'Music with Ableton Live and Eurorack modular', href: 'https://polyterative.bandcamp.com' },
  { text: 'Voice-driven development with Talon Voice', href: 'https://github.com/polyterative/Poly-Talon-Scripts' },
];

const profileSnapshot = [
  { label: 'Practice', value: 'Product design, interface systems, frontend implementation, creative tooling' },
  { label: 'Background', value: 'Design and engineering, with most recent work spanning analytics software and self-initiated tools' },
  { label: 'Tools', value: 'TypeScript, Angular, RxJS, Figma, HTML/CSS, Supabase, PostgreSQL' },
  { label: 'Recurring interests', value: 'Dense software, reactive systems, audiovisual tooling, notation, workflow design' },
];

const tools = [
  { label: 'Daily languages', icon: 'code', items: ['.ts', '.html', '.scss', '.svg'] },
  { label: 'Frontend', icon: 'layers', items: ['Angular', 'RxJS', 'TypeScript', 'HTML/CSS'] },
  { label: 'Creative code', icon: 'terminal', items: ['WebGPU', 'Three.js', 'p5.js', 'OSC'] },
  { label: 'Design', icon: 'star', items: ['Figma', 'Photoshop', 'Illustrator'] },
  { label: 'Backend', icon: 'activity', items: ['Supabase', 'PostgreSQL', 'Node.js'] },
  { label: 'Music', icon: 'music', items: ['Ableton Live', 'Eurorack', 'Max for Live'] },
];

const links = [
  { label: 'Code', icon: 'github', value: 'github.com/polyterative', href: 'https://github.com/polyterative' },
  { label: 'Music', icon: 'music', value: 'polyterative.bandcamp.com', href: 'https://polyterative.bandcamp.com' },
  { label: 'Visual', icon: 'instagram', value: '@polyterative', href: 'https://www.instagram.com/polyterative/' },
  { label: 'App', icon: 'external', value: 'patcher.xyz', href: 'https://patcher.xyz' },
  { label: 'Email', icon: 'mail', value: 'polyterative@outlook.com', href: 'mailto:polyterative@outlook.com' },
];
---

<BaseLayout
  title="About — Vlady Yakovenko"
  description="Background, current work, and tools used by Vlady Yakovenko across design, software, music, and visual systems."
>
  <div class="container container--wide">

    <header class="about-header">
      <h1>Vlady Yakovenko</h1>
      <p class="about-handle">polyterative — Bologna, Italy</p>
      <p class="about-bio">
        Designer with a strong engineering background, mostly interested in complex interfaces, technical systems, and tools that need both structural clarity and visual judgment.
      </p>
      <p class="about-supporting">
        I still make music and visuals, and that practice feeds back into the software work. The through-line is fairly consistent: systems, notation, timing, interaction, and tools that are shaped around how people actually work.
      </p>
      <div class="about-contact">
        <span class="label">Email</span>
        <a href="mailto:polyterative@outlook.com">polyterative@outlook.com</a>
      </div>
    </header>

    <section class="about-section about-section--first">
      <h2 class="about-section__title"><Icon name="briefcase" size={17} />Practice</h2>
      <div class="snapshot-grid">
        {profileSnapshot.map(item => (
          <article class="panel snapshot">
            <span class="label">{item.label}</span>
            <p>{item.value}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section">
      <h2 class="about-section__title"><Icon name="activity" size={17} />Now</h2>
      <ul class="now-list">
        {currentFocus.map(item => (
          <li><a class="iclink" href={item.href} target="_blank" rel="noopener"><span class="now-dot" aria-hidden="true"></span>{item.text}</a></li>
        ))}
      </ul>
    </section>

    <section class="about-section">
      <h2 class="about-section__title"><Icon name="briefcase" size={17} />Experience</h2>
      <div class="timeline">
        {experience.map(item => (
          <article class="row">
            <time class="row__period">{item.period}</time>
            <div class="row__body">
              <h3 class="row__role">{item.role}</h3>
              {item.orgUrl
                ? <a class="row__org iclink" href={item.orgUrl} target="_blank" rel="noopener">{item.org}<Icon name="arrow-up-right" size={12} /></a>
                : <p class="row__org">{item.org}</p>
              }
              <p class="row__desc">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section">
      <h2 class="about-section__title"><Icon name="book" size={17} />Education</h2>
      <div class="timeline">
        <article class="row">
          <time class="row__period">{education.period}</time>
          <div class="row__body">
            <h3 class="row__role">{education.degree}</h3>
            <p class="row__org">{education.institution}</p>
            <p class="row__desc">Final grade: {education.grade}</p>
          </div>
        </article>
      </div>
    </section>

    <section class="about-section" id="tools">
      <h2 class="about-section__title"><Icon name="tool" size={17} />Tools</h2>
      <div class="tools-grid">
        {tools.map(group => (
          <div class="tool-group panel">
            <h4 class="label label--ic"><Icon name={group.icon} size={13} />{group.label}</h4>
            <ul class="tool-group__items">
              {group.items.map(item => <li><span class="tag">{item}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section">
      <h2 class="about-section__title"><Icon name="link" size={17} />Find me</h2>
      <ul class="link-list">
        {links.map(l => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              <span class="link-list__label label label--ic"><Icon name={l.icon} size={14} />{l.label}</span>
              <span class="link-list__value">{l.value}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>

<style>
  .about-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-16) var(--space-10);
    max-width: var(--max-w);
  }
  .about-header h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .about-handle {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    margin-top: calc(-1 * var(--space-2));
  }
  .about-bio {
    font-size: var(--font-size-lg);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 56ch;
  }
  .about-supporting {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 58ch;
  }
  .about-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }
  .about-contact a { font-weight: 500; }
  .about-contact a:hover { opacity: 0.6; }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-line);
    max-width: var(--max-w);
  }
  .about-section--first { padding-top: 0; border-top: none; }
  .about-section__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.3rem;
  }
  .about-section__title .icon { color: var(--color-accent); }

  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .snapshot {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .snapshot p {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: 1.65;
  }

  .now-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .now-list li {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-line);
    font-size: var(--font-size-base);
    line-height: 1.5;
  }
  .now-list li:first-child { border-top: none; padding-top: 0; }
  .now-list a { color: var(--color-text); align-items: baseline; }
  .now-list a:hover { color: var(--color-accent-ink); }
  .now-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    transform: translateY(-1px);
  }

  .timeline { display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
  }
  .row:first-child { border-top: none; padding-top: 0; }
  .row__period {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-faint);
    white-space: nowrap;
    line-height: 1.7;
  }
  .row__body { display: flex; flex-direction: column; gap: var(--space-1); }
  .row__role { font-size: var(--font-size-base); font-weight: 600; letter-spacing: -0.01em; }
  .row__org {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }
  a.row__org:hover { color: var(--color-text); }
  .row__desc {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: 1.65;
    margin-top: var(--space-2);
    max-width: 60ch;
  }

  @media (max-width: 560px) {
    .snapshot-grid { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; gap: var(--space-2); }
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4);
  }
  .tool-group { display: flex; flex-direction: column; gap: var(--space-3); }
  .tool-group h4 .icon { color: var(--color-accent); }
  .tool-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .link-list { list-style: none; display: flex; flex-direction: column; }
  .link-list li { border-top: 1px solid var(--color-line); }
  .link-list li:first-child { border-top: none; }
  .link-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .link-list__label .icon { color: var(--color-faint); transition: color var(--transition); }
  .link-list a:hover .link-list__value { color: var(--color-accent-ink); }
  .link-list a:hover .icon { color: var(--color-accent); }
  .link-list__value {
    font-size: var(--font-size-sm);
    font-weight: 500;
    word-break: break-all;
    text-align: right;
  }
</style>
