---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import PullQuote from '../components/PullQuote.astro';
import { greek, letter, pad, sectionIndex } from '../lib/datum';
import data from '../data/showcase.generated.json';
import { intro, chapters } from '../../showcase/story.mjs';

type Shot = (typeof data.shots)[number];
const detailById = new Map((data.details ?? []).map((d) => [d.id, d]));
const byId = new Map<string, Shot>(data.shots.map((s) => [s.id, s]));
const shot = (id: string) => {
  const s = byId.get(id);
  if (!s) throw new Error(`showcase story references unknown shot "${id}"`);
  return s;
};
const appName = (key: string) => (data.apps as Record<string, { name: string }>)[key].name;

const groups = Object.entries(data.apps)
  .map(([key, app]) => ({ key, ...app, shots: data.shots.filter((s) => s.app === key) }))
  .filter((g) => g.shots.length > 0);
let fig = 0;
const nextFig = () => greek(++fig);
const total = data.shots.length;
---

<BaseLayout
  title="Showcase — Vlady Yakovenko"
  description="A design story in five macOS apps by Vlady Yakovenko (polyterative): Ledge, Spoke, Habitat, Kinetip and EvoControl, shown with screens rendered from the real interface."
  serial="PLY-S"
  image={data.shots[0]?.cover ?? '/og/default.png'}
>
  <div class="container container--wide">
    <header class="page-head">
      <aside class="page-head__aside">
        <span class="plate page-head__idx">{sectionIndex('/showcase')}</span>
        <span class="lbl">Chapters</span>
        <span class="data">{chapters.length}</span>
        <span class="lbl">Screens</span>
        <span class="data">{total}</span>
      </aside>
      <div class="page-head__main">
        <h1 class="story-title">{intro.headline}</h1>
        <p class="page-head__lead">{intro.lead}</p>
        <nav class="jump" aria-label="Chapters">
          {chapters.map((c, i) => <a class="act" href={`#${c.app}`}><span class="nocase">{pad(i + 1)}</span> {appName(c.app)}</a>)}
        </nav>
      </div>
    </header>

    {chapters.map((c, ci) => (
      <section class="chapter" id={c.app} aria-labelledby={`${c.app}-h`}>
        <header class="chapter__head">
          <span class="plate chapter__num">{pad(ci + 1)}</span>
          <div class="chapter__title">
            <span class="lbl">{appName(c.app)}</span>
            <h2 id={`${c.app}-h`}>{c.headline}</h2>
          </div>
          <div class="chapter__lede">
            <p class="chapter__problem">{c.problem}</p>
            {c.facts && (
              <dl class="facts">
                {c.facts.map(([k, v]: string[]) => <div><dt class="lbl">{k}</dt><dd class="data">{v}</dd></div>)}
              </dl>
            )}
          </div>
        </header>

        {c.blocks.map((b) => {
          if (b.type === 'hero') {
            const s = shot(b.shot);
            return (
              <figure class="hero">
                <button type="button" class="shot__open" data-full={s.webp} data-alt={s.alt} data-title={`${appName(c.app)} — ${s.title}`} data-caption={s.caption} aria-label={`Open larger: ${appName(c.app)}, ${s.title}`}>
                  <Img src={s.cover ?? s.src} alt={s.alt} sizes="(min-width: 1200px) 1100px, 100vw" loading={ci === 0 ? 'eager' : 'lazy'} />
                </button>
                <figcaption class="figcap"><span class="lbl">Fig. <span class="nocase">{nextFig()}</span></span><span>{s.caption}</span></figcaption>
              </figure>
              <PullQuote>{c.decision}</PullQuote>
            );
          }
          if (b.type === 'scene') {
            const s = shot(b.shot);
            return (
              <article class="scene">
                <div class="scene__text">
                  <span class="lbl">Fig. <span class="nocase">{nextFig()}</span></span>
                  <h3>{b.title}</h3>
                  <p>{b.text}</p>
                </div>
                <button type="button" class="shot__open scene__img" data-full={s.webp} data-alt={s.alt} data-title={`${appName(c.app)} — ${s.title}`} data-caption={s.caption} aria-label={`Open larger: ${appName(c.app)}, ${s.title}`}>
                  <Img src={s.src} alt={s.alt} sizes="(min-width: 900px) 60vw, 100vw" />
                </button>
              </article>
            );
          }
          if (b.type === 'detail') {
            const d = detailById.get(b.detail);
            if (!d) throw new Error(`showcase story references unknown detail "${b.detail}"`);
            return (
              <article class="scene detail">
                <div class="scene__text">
                  <span class="lbl">Fig. <span class="nocase">{nextFig()}</span></span>
                  <h3>{b.title}</h3>
                  <p>{b.text}</p>
                  <ol class="marks">
                    {b.marks.map((m: { text: string }, i: number) => <li><span class="pin pin--static">{i + 1}</span><span>{m.text}</span></li>)}
                  </ol>
                </div>
                <div class="detail__fig">
                  <button type="button" class="shot__open scene__img" data-full={d.webp} data-alt={d.alt} data-title={`${appName(c.app)} — ${d.title}`} data-caption={b.text} aria-label={`Open larger: ${d.title}`}>
                    <Img src={d.src} alt={d.alt} sizes="(min-width: 900px) 60vw, 100vw" />
                  </button>
                  {b.marks.map((m: { x: number; y: number }, i: number) => (
                    <span class="pin" style={`left:${d.box.x + m.x * d.box.w}%;top:${d.box.y + m.y * d.box.h}%`} aria-hidden="true">{i + 1}</span>
                  ))}
                </div>
              </article>
            );
          }
          if (b.type === 'note') {
            return <p class="note">{b.text}</p>;
          }
          if (b.type === 'pair') {
            const l = shot(b.light), d = shot(b.dark);
            return (
              <article class="pair">
                <div class="scene__text pair__text">
                  <span class="lbl">Fig. <span class="nocase">{nextFig()}</span></span>
                  <h3>{b.title}</h3>
                  <p>{b.text}</p>
                </div>
                <div class="pair__shots">
                  {[[l, 'Light'], [d, 'Dark']].map(([s, label]) => (
                    <figure>
                      <button type="button" class="shot__open" data-full={(s as Shot).webp} data-alt={(s as Shot).alt} data-title={`${appName(c.app)} — ${(s as Shot).title}`} data-caption={(s as Shot).caption} aria-label={`Open larger: ${label}`}>
                        <Img src={(s as Shot).src} alt={(s as Shot).alt} sizes="(min-width: 900px) 30vw, 50vw" />
                      </button>
                      <figcaption class="lbl">{label as string}</figcaption>
                    </figure>
                  ))}
                </div>
              </article>
            );
          }
          return null;
        })}
      </section>
    ))}

    <section class="sec group" id="all" aria-labelledby="all-h">
      <header class="sec__head">
        <h2 class="plate sec__idx" id="all-h">{letter(1)}</h2>
        <span class="sec__title">All screens</span>
        <span class="lbl">{total} captures, by app</span>
      </header>
      <div class="sec__body">
        {groups.map((g) => (
          <div class="index-group">
            <h3 class="lbl">{g.name}</h3>
            <ul class="wall">
              {g.shots.map((s) => (
                <li class="shot">
                  <button type="button" class="shot__open" data-full={s.webp} data-alt={s.alt} data-title={`${g.name} — ${s.title}`} data-caption={s.caption} aria-label={`Open larger: ${g.name}, ${s.title}`}>
                    <Img src={s.src} alt={s.alt} sizes="(min-width: 900px) 20vw, 50vw" />
                  </button>
                  <p class="figcap"><span><strong>{s.title}.</strong> {s.caption}</span></p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Screen preview">
    <form method="dialog"><button class="lightbox__close act" aria-label="Close">Close</button></form>
    <img class="lightbox__img" alt="" />
    <p class="lightbox__cap"><span class="lbl lightbox__title"></span><span class="lightbox__text"></span></p>
    <div class="lightbox__nav">
      <button type="button" class="act" data-step="-1">Previous</button>
      <button type="button" class="act" data-step="1">Next</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const openers = [...document.querySelectorAll<HTMLButtonElement>('.shot__open')];
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('.lightbox__img')!;
    const title = dlg.querySelector<HTMLElement>('.lightbox__title')!;
    const text = dlg.querySelector<HTMLElement>('.lightbox__text')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + openers.length) % openers.length;
      const d = openers[index].dataset;
      img.src = d.full ?? '';
      img.alt = d.alt ?? '';
      title.textContent = d.title ?? '';
      text.textContent = d.caption ?? '';
    };
    openers.forEach((b, i) => b.addEventListener('click', () => { show(i); dlg.showModal(); }));
    dlg.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(index + Number(b.dataset.step))));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  }
</script>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .group { scroll-margin-top: var(--space-8); margin-top: clamp(var(--space-16), 10vw, 8rem); }

  .story-title { font-size: clamp(2.25rem, 6vw, 4.5rem); line-height: 1.02; letter-spacing: -0.035em; max-width: 16ch; text-wrap: balance; }

  .chapter { margin-top: clamp(var(--space-16), 10vw, 8rem); padding-top: var(--space-8); border-top: 1px solid var(--ink); scroll-margin-top: var(--space-8); }
  .chapter__head { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-bottom: var(--space-10); }
  .chapter__num { font-size: clamp(64px, 12vw, 160px); line-height: 0.85; color: var(--signal-text); }
  .chapter__title { display: flex; flex-direction: column; gap: var(--space-2); }
  .chapter__title h2 { font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; max-width: 20ch; text-wrap: balance; }
  .chapter__lede { display: flex; flex-direction: column; gap: var(--space-5); }
  .chapter__problem { color: var(--ink-2); font-size: var(--fs-lead); max-width: 46ch; }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-8); }
  .facts div { display: flex; flex-direction: column; gap: var(--space-1); border-top: 1px solid var(--rule-strong); padding-top: var(--space-2); }
  .facts dd { margin: 0; }
  .note { margin-top: clamp(var(--space-12), 8vw, 6rem); max-width: 52ch; font-size: var(--fs-lead); line-height: 1.4; letter-spacing: -0.01em; }
  @media (min-width: 900px) { .note { margin-left: calc(var(--gutter) + var(--space-8)); } }
  @media (min-width: 900px) {
    .chapter__head { grid-template-columns: var(--gutter) 1fr; align-items: end; }
    .chapter__num { grid-row: 1 / span 2; }
    .chapter__lede { grid-column: 2; }
  }

  .hero { margin: 0; }
  .hero .shot__open { width: 100%; }

  .scene { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-top: clamp(var(--space-12), 8vw, 6rem); }
  .scene__text { display: flex; flex-direction: column; gap: var(--space-2); }
  .scene__text h3 { font-size: 1.5rem; letter-spacing: -0.02em; line-height: 1.15; }
  .scene__text p { color: var(--ink-2); max-width: 36ch; }
  .scene__img { width: 100%; max-width: 760px; }
  @media (min-width: 900px) {
    .scene { grid-template-columns: var(--gutter) 1fr; gap: var(--space-8); align-items: start; }
    .scene__text { position: sticky; top: var(--space-16); }
  }

  .detail__fig { position: relative; width: 100%; max-width: 760px; }
  .pin {
    position: absolute; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
    background: var(--signal); color: var(--on-signal); border: 1px solid var(--ink);
    font: 500 var(--fs-micro)/1 var(--f-mono); pointer-events: none;
  }
  .pin--static { position: static; transform: none; flex: none; }
  .marks { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-3); padding: 0; }
  .marks li { display: flex; gap: var(--space-3); align-items: flex-start; font-size: var(--fs-meta); color: var(--ink-2); }

  .pair { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-top: clamp(var(--space-12), 8vw, 6rem); }
  .pair__shots { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .pair__shots figure { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .pair__shots .shot__open { width: 100%; }
  @media (min-width: 900px) {
    .pair { grid-template-columns: var(--gutter) 1fr; gap: var(--space-8); align-items: start; }
    .pair__text { position: sticky; top: var(--space-16); }
  }

  .index-group { display: flex; flex-direction: column; gap: var(--space-4); }

  .wall {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: var(--space-8) var(--space-6);
    align-items: start;
  }
  .shot { display: flex; flex-direction: column; min-width: 0; }
  .shot__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--rule);
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }
  .shot__open:hover { border-color: var(--ink); }
  .shot__open:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
  .shot__open :global(img) { width: 100%; height: auto; }
  .figcap strong { color: var(--ink); font-weight: 500; }

  .lightbox {
    max-width: min(96vw, 1500px);
    max-height: 96vh;
    width: 100%;
    padding: var(--space-4);
    border: 1px solid var(--ink);
    background: var(--bg);
    color: var(--ink);
    margin: auto;
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.78); }
  .lightbox__img { width: 100%; height: auto; max-height: 78vh; object-fit: contain; }
  .lightbox__close { position: absolute; top: var(--space-3); right: var(--space-3); z-index: 1; background: var(--bg); cursor: pointer; }
  .lightbox form { display: contents; }
  .lightbox__cap { display: flex; gap: var(--space-3); align-items: baseline; padding-top: var(--space-3); font-family: var(--f-mono); font-size: var(--fs-meta); color: var(--ink-2); }
  .lightbox__nav { display: flex; justify-content: space-between; padding-top: var(--space-2); }
  .lightbox__nav .act { background: none; border: 0; border-bottom: 1px solid var(--rule-strong); cursor: pointer; }
</style>
