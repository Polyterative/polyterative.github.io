---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const releases = [
  {
    title: 'Without Us',
    year: '2025',
    released: 'Feb 28, 2025',
    cover: '/music/without-us.jpg',
    url: 'https://polyterative.bandcamp.com/album/without-us',
    genre: ['Industrial Techno', 'Modular Synthesis'],
    desc: `A brutalist, techno-futuristic landscape of corrupted digital space — a story of hyperconnectivity's collapse, built from the ground up with modular synthesis. If Ruled by Code was an introduction to this world, Without Us is the moment of its unraveling.`,
    tracks: 8,
    highlight: true,
  },
  {
    title: 'Persist',
    year: '2024',
    released: 'Mar 12, 2024',
    cover: '/music/persist.jpg',
    url: 'https://polyterative.bandcamp.com/track/persist',
    genre: ['Electronic', 'Ambient', 'Downtempo'],
    desc: null,
    tracks: 1,
  },
  {
    title: 'Is It You',
    year: '2021',
    released: 'Oct 2, 2021',
    cover: '/music/is-it-you.jpg',
    url: 'https://polyterative.bandcamp.com/track/is-it-you',
    genre: ['Electronic'],
    desc: `A swirling, ethereal exploration of the search for connection — born from a dream and composed in a single hour. Haunting melodies and unpredictable rhythms for the countless strangers we pass every day, each one asking: is it you?`,
    tracks: 1,
  },
  {
    title: 'Ruled by Code',
    year: '2020',
    released: 'Jun 15, 2020',
    cover: '/music/ruled-by-code.jpg',
    url: 'https://polyterative.bandcamp.com/album/ruled-by-code',
    genre: ['Drone', 'Ambient', 'Electronic'],
    desc: `A deep and introspective look at the digital age — five drone tracks exploring algorithmic control, identity, and the blurring line between the virtual and the real.`,
    tracks: 5,
  },
  {
    title: 'Parzialmente Nuvoloso',
    year: '2020',
    released: 'Apr 18, 2020',
    cover: '/music/parzialmente-nuvoloso.jpg',
    url: 'https://polyterative.bandcamp.com/album/parzialmente-nuvoloso',
    genre: ['Ambient', 'Electronic'],
    desc: `A sonic exploration of the human experience across three long-form pieces — Cirri, Strati, and Cumuli — an invitation to introspection and resilience.`,
    tracks: 3,
  },
  {
    title: 'Looking for Truth',
    year: '2019',
    released: 'Aug 15, 2019',
    cover: '/music/looking-for-truth.jpg',
    url: 'https://polyterative.bandcamp.com/album/looking-for-truth',
    genre: ['Electronic', 'Ambient'],
    desc: null,
    tracks: 8,
  },
  {
    title: 'Absence',
    year: '2017',
    released: 'Sep 1, 2017',
    cover: '/music/absence.jpg',
    url: 'https://polyterative.bandcamp.com/album/absence',
    genre: ['Chillstep', 'Electronic'],
    desc: `An emotional exploration of the voids within us — hauntingly beautiful chillstep written over nine months, from October 2016 to July 2017. The debut EP.`,
    tracks: null,
  },
];
---

<BaseLayout
  title="Music — Vlady Yakovenko"
  description="Discography of Polyterative (Vlady Yakovenko) — electronic music, modular synthesis, and ambient releases from 2017 to present."
>
  <div class="container container--wide">

    <div class="music-intro">
      <header class="page-header">
        <h1>Discography</h1>
        <p class="page-desc">
          Electronic music under the Polyterative alias — experimental techno, modular synthesis, ambient.
          <a href="https://polyterative.bandcamp.com" target="_blank" rel="noopener" class="bandcamp-link iclink">All releases on Bandcamp<Icon name="external" size={13} /></a>
        </p>
      </header>

      <figure class="music-hero">
        <img
          src="/peraspera-2024.jpg"
          alt="Vlady Yakovenko performing a modular synthesis live set at perAspera festival, Bologna 2024"
          width="1400"
          height="1400"
          loading="eager"
          decoding="async"
        />
        <figcaption class="music-hero__cap">
          <Icon name="music" size={12} />Live at perAspera festival — Bologna, 2024
        </figcaption>
      </figure>
    </div>

    <ul class="release-grid">
      {releases.map(r => (
        <li class:list={['release', { 'release--highlight': r.highlight }]}>
          <a class="release__cover" href={r.url ?? undefined} target={r.url ? '_blank' : undefined} rel={r.url ? 'noopener' : undefined} aria-label={r.url ? `Listen to ${r.title} on Bandcamp` : undefined}>
            <img src={r.cover} alt={`${r.title} album cover`} loading="lazy" width="600" height="600" />
          </a>
          <div class="release__body">
            <div class="release__meta">
              <time class="release__year"><Icon name="calendar" size={12} />{r.released}</time>
              {r.tracks && <span class="release__tracks"><Icon name="disc" size={12} />{r.tracks} {r.tracks === 1 ? 'track' : 'tracks'}</span>}
            </div>
            <h2 class="release__title">
              {r.url
                ? <a class="iclink accent-hover" href={r.url} target="_blank" rel="noopener">{r.title}<Icon name="arrow-up-right" size={15} /></a>
                : r.title
              }
            </h2>
            {r.desc && (
              <div class="release__desc">
                {r.desc.split('\n\n').map(para => <p>{para}</p>)}
              </div>
            )}
            <ul class="release__tags">
              {r.genre.map(g => <li><span class="tag">{g}</span></li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>

  </div>
</BaseLayout>

<style>
  .music-intro {
    display: grid;
    grid-template-columns: 1fr minmax(0, 300px);
    align-items: center;
    gap: var(--space-10);
    padding-block: var(--space-12) var(--space-8);
  }
  .music-hero {
    position: relative;
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 300px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .music-hero img {
    width: 100%;
    height: auto;
    display: block;
  }
  .music-hero__cap {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: rgba(255, 255, 255, 0.92);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
  }
  .music-hero__cap :global(.icon) { color: rgba(255, 255, 255, 0.92); }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--max-w);
  }
  .page-header h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .page-desc {
    color: var(--color-muted);
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .bandcamp-link {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }
  .bandcamp-link:hover { color: var(--color-text); }

  .release-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-10) var(--space-8);
  }

  .release { display: flex; flex-direction: column; gap: var(--space-4); }
  .release--highlight { grid-column: 1 / -1; }

  .release__cover {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-hover);
  }
  .release--highlight .release__cover { max-width: 420px; }
  .release__cover img { width: 100%; height: 100%; object-fit: cover; }
  .release__cover:hover { opacity: 0.85; }

  .release__body { display: flex; flex-direction: column; gap: var(--space-2); }
  .release__meta { display: flex; align-items: baseline; gap: var(--space-3); }
  .release__year {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-faint);
  }
  .release__tracks {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-faint);
  }
  .release__title { font-size: 1.1rem; font-weight: 600; letter-spacing: -0.02em; }
  .release__title .icon { color: var(--color-faint); }

  .release__desc {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 60ch;
  }
  .release__desc p { max-width: none; margin-bottom: 0.6em; }
  .release__desc p:last-child { margin-bottom: 0; }
  .release__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-1);
  }

  @media (max-width: 640px) {
    .music-intro {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .music-hero { justify-self: start; max-width: 220px; }
  }
  @media (max-width: 420px) {
    .release-grid { grid-template-columns: 1fr; }
  }
</style>
