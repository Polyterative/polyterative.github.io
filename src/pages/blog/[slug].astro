---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const dateObj = new Date(post.data.date);
const formatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Estimate reading time (~200 wpm)
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description ?? '',
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: 'Vlady Yakovenko',
    url: 'https://polyterative.github.io',
  },
  url: `https://polyterative.github.io/blog/${post.id}`,
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={`${post.data.title} — Vlady Yakovenko`}
  description={post.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="section post">
    <div class="container">
      <header class="post__header">
        <div class="post__meta">
          <time datetime={post.data.date}>{formatted}</time>
          <span class="meta-sep">·</span>
          <span>{readingTime} min read</span>
          {post.data.tags.length > 0 && (
            <>
              <span class="meta-sep">·</span>
              <ul class="post__tags">
                {post.data.tags.map(t => <li><span class="tag">{t}</span></li>)}
              </ul>
            </>
          )}
        </div>
        <h1 class="post__title">{post.data.title}</h1>
        {post.data.description && (
          <p class="post__desc">{post.data.description}</p>
        )}
      </header>

      <hr class="divider" />

      <div class="prose">
        <Content />
      </div>

      <hr class="divider" />

      <nav class="post-nav" aria-label="Post navigation">
        <div class="post-nav__item post-nav__item--prev">
          {prev && (
            <>
              <span class="post-nav__label">← Older</span>
              <a href={`/blog/${prev.id}`} class="post-nav__link">{prev.data.title}</a>
            </>
          )}
        </div>
        <div class="post-nav__item post-nav__item--next">
          {next && (
            <>
              <span class="post-nav__label">Newer →</span>
              <a href={`/blog/${next.id}`} class="post-nav__link">{next.data.title}</a>
            </>
          )}
        </div>
      </nav>

      <div class="post-footer-links">
        <a href="/blog">← All posts</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .meta-sep { opacity: 0.4; }

  .post__tags {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    flex-wrap: wrap;
  }

  .post__title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .post__desc {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 55ch;
  }

  /* Prose */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: var(--space-2);
  }
  .prose :global(p) {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: 68ch;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .prose :global(li) {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 65ch;
  }
  .prose :global(a) {
    color: var(--color-text);
  }
  .prose :global(code) {
    background: var(--color-tag-bg);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    font-size: 0.875em;
  }
  .prose :global(pre) {
    margin-block: var(--space-2);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.875rem;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: var(--space-4);
    color: var(--color-muted);
    font-style: italic;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-6);
  }

  /* Post navigation */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-4);
  }
  .post-nav__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .post-nav__item--next {
    text-align: right;
    align-items: flex-end;
  }
  .post-nav__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-nav__link {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    max-width: 28ch;
  }
  .post-nav__link:hover { text-decoration: underline; }

  .post-footer-links {
    padding-bottom: var(--space-8);
  }
  .post-footer-links a {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .post-footer-links a:hover { color: var(--color-text); }

  @media (max-width: 480px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav__item--next { text-align: left; align-items: flex-start; }
  }
</style>
