---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostCover from '../../components/PostCover.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const dateObj = new Date(post.data.date);
const formatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description ?? '',
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: 'Vlady Yakovenko',
    url: 'https://polyterative.github.io',
  },
  url: `https://polyterative.github.io/blog/${post.id}`,
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={`${post.data.title} — Vlady Yakovenko`}
  description={post.data.description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="post">
    <div class="container container--wide">
      <header class="post__header">
        <div class="post__meta">
          <a class="post__back iclink" href="/blog"><Icon name="arrow-left" size={13} />Writing</a>
          <span class="sep">/</span>
          <time class="post__metaitem" datetime={post.data.date}><Icon name="calendar" size={12} />{formatted}</time>
          <span class="sep">/</span>
          <span class="post__metaitem"><Icon name="book" size={12} />{readingTime} min read</span>
        </div>
        <h1 class="post__title">{post.data.title}</h1>
        {post.data.description && (
          <p class="post__desc">{post.data.description}</p>
        )}
        {post.data.tags.length > 0 && (
          <ul class="post__tags">
            {post.data.tags.map(t => <li><span class="tag">{t}</span></li>)}
          </ul>
        )}
      </header>

      <div class="post__cover">
        <PostCover title={post.data.title} tags={post.data.tags} cover={post.data.cover} variant="hero" />
      </div>

      <div class="prose">
        <Content />
      </div>

      <nav class="post-nav" aria-label="Post navigation">
        <div class="post-nav__item">
          {prev && (
            <>
              <span class="label label--ic"><Icon name="arrow-left" size={12} />Older</span>
              <a href={`/blog/${prev.id}`} class="post-nav__link accent-hover">{prev.data.title}</a>
            </>
          )}
        </div>
        <div class="post-nav__item post-nav__item--next">
          {next && (
            <>
              <span class="label label--ic">Newer<Icon name="arrow-right" size={12} /></span>
              <a href={`/blog/${next.id}`} class="post-nav__link accent-hover">{next.data.title}</a>
            </>
          )}
        </div>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .post__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-16) var(--space-10);
    border-bottom: 1px solid var(--color-line);
    max-width: var(--max-w);
  }
  .post__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }
  .post__back:hover { color: var(--color-text); }
  .post__back .icon { color: var(--color-faint); }
  .post__back:hover .icon { color: var(--color-accent); }
  .post__metaitem {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .post__metaitem .icon { color: var(--color-faint); }
  .sep { color: var(--color-faint); }

  .post__title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .post__desc {
    font-size: var(--font-size-lg);
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 54ch;
  }
  .post__tags {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    flex-wrap: wrap;
  }

  .post__cover {
    max-width: var(--max-w);
    margin-block: var(--space-8) 0;
  }

  /* ── Prose ── */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-12);
    max-width: var(--max-w);
  }
  .prose :global(h2) {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    margin-top: var(--space-3);
  }
  .prose :global(p) {
    font-size: var(--font-size-base);
    line-height: 1.8;
    max-width: 68ch;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .prose :global(li) {
    font-size: var(--font-size-base);
    line-height: 1.75;
    max-width: 65ch;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }
  .prose :global(a:hover) { text-decoration-color: var(--color-text); }
  .prose :global(code) {
    font-size: 0.85em;
    padding: 1px 5px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .prose :global(pre) { margin-block: var(--space-3); }
  .prose :global(pre code) { border: none; padding: 0; font-size: 0.875rem; }
  /* Shiki dual-theme: light values are in inline `color`/`background-color` (no override needed).
     Dark theme swaps to the --shiki-dark / --shiki-dark-bg CSS variables. */
  :root[data-theme="dark"] .prose :global(.astro-code) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
  :root[data-theme="dark"] .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-5);
    color: var(--color-muted);
    margin-block: var(--space-2);
  }
  .prose :global(blockquote p) { max-width: none; }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-line);
    margin-block: var(--space-8);
  }
  .prose :global(img) { border-radius: var(--radius); border: 1px solid var(--color-border); }
  .prose :global(.post-gallery) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: start;
  }
  .prose :global(.post-gallery figure) { margin: 0; }
  .prose :global(.post-gallery img) { width: 100%; height: auto; }

  /* ── Mind notes: personal decision-making, sprinkled through the story ── */
  .prose :global(.mind) {
    --mind: var(--color-accent);
    --mind-bg: var(--color-accent-weak);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 1px solid color-mix(in srgb, var(--mind) 38%, var(--color-border));
    border-radius: var(--radius-sm);
    background: var(--mind-bg);
    padding: var(--space-4) var(--space-5);
    margin-block: var(--space-4);
  }
  .prose :global(.mind__tag) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mind);
  }
  .prose :global(.mind__tag svg) { width: 14px; height: 14px; flex-shrink: 0; }
  .prose :global(.mind p) {
    margin: 0;
    max-width: none;
    line-height: 1.7;
  }
  .prose :global(.mind p + p) { margin-top: var(--space-2); }
  .prose :global(.mind--design) {
    --mind: #a855f7;
    --mind-bg: color-mix(in srgb, #a855f7 9%, transparent);
  }
  .prose :global(.mind--code) {
    --mind: #14b8a6;
    --mind-bg: color-mix(in srgb, #14b8a6 9%, transparent);
  }

  /* ── Post navigation ── */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-line);
    max-width: var(--max-w);
  }
  .post-nav__item { display: flex; flex-direction: column; gap: var(--space-2); }
  .post-nav__item--next { text-align: right; align-items: flex-end; }
  .post-nav__link {
    font-size: var(--font-size-sm);
    font-weight: 500;
    max-width: 28ch;
    line-height: 1.4;
  }
  .post-nav__link:hover { opacity: 0.6; }

  @media (max-width: 480px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav__item--next { text-align: left; align-items: flex-start; }
    .prose :global(.post-gallery) { grid-template-columns: 1fr; }
  }
</style>
