---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateObj = new Date(post.data.date);
const formatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={`${post.data.title} — Vlady Yakovenko`}
  description={post.data.description}
>
  <article class="section post">
    <div class="container">
      <header class="post__header">
        <div class="post__meta">
          <time datetime={post.data.date} class="post__date">{formatted}</time>
          {post.data.tags.length > 0 && (
            <ul class="post__tags">
              {post.data.tags.map(t => <li><span class="tag">{t}</span></li>)}
            </ul>
          )}
        </div>
        <h1 class="post__title">{post.data.title}</h1>
        {post.data.description && (
          <p class="post__desc">{post.data.description}</p>
        )}
      </header>

      <hr class="divider" />

      <div class="prose">
        <Content />
      </div>

      <hr class="divider" />

      <footer class="post__footer">
        <a href="/blog" class="back-link">← All posts</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .post__date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .post__tags {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    flex-wrap: wrap;
  }

  .post__title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.03em;
  }

  .post__desc {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 55ch;
  }

  /* Prose styles */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-4);
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    margin-top: var(--space-2);
  }

  .prose :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .prose :global(ul), .prose :global(ol) {
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .prose :global(li) {
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
  }
  .prose :global(a:hover) { text-decoration-color: var(--color-text); }

  .prose :global(code) {
    background: var(--color-tag-bg);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    font-size: 0.875em;
  }

  .prose :global(pre) {
    margin-block: var(--space-2);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: var(--space-4);
    color: var(--color-muted);
    font-style: italic;
  }

  .post__footer {
    padding-bottom: var(--space-8);
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .back-link:hover { color: var(--color-text); }
</style>
