---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Group by year
const byYear = allPosts.reduce<Record<string, typeof allPosts>>((acc, post) => {
  const year = new Date(post.data.date).getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Writing — Vlady Yakovenko"
  description="Posts on engineering, music, generative art, and tooling by Vlady Yakovenko (polyterative)."
>
  <section class="section">
    <div class="container">
      <header class="page-header">
        <span class="tag">Writing</span>
        <h1>Posts</h1>
        <p class="page-desc">
          Notes on code, sound, and making things.
          {allPosts.length > 0 && <span class="post-count">{allPosts.length} posts</span>}
        </p>
      </header>

      {allPosts.length > 0 ? (
        <div class="posts-by-year">
          {years.map(year => (
            <div class="year-group">
              <h2 class="year-label">{year}</h2>
              <div class="posts-list">
                {byYear[year].map(post => (
                  <PostRow
                    title={post.data.title}
                    date={post.data.date}
                    slug={post.id}
                    description={post.data.description}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty">Nothing published yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-10);
    margin-bottom: var(--space-10);
  }
  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }
  .page-desc {
    color: var(--color-muted);
    font-size: var(--font-size-base);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .post-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    background: var(--color-tag-bg);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    color: var(--color-muted);
  }

  .posts-by-year {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .year-group {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .year-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-weight: 400;
  }

  .posts-list { display: flex; flex-direction: column; }
  .year-group .post-row:first-child { border-top: none; }
  .empty { color: var(--color-muted); font-style: italic; }
</style>
