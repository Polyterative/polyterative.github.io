---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout
  title="Writing — Vlady Yakovenko"
  description="Posts on engineering, music, generative art, and tooling by Vlady Yakovenko (polyterative)."
>
  <section class="section">
    <div class="container">
      <header class="page-header">
        <span class="tag">Writing</span>
        <h1>Posts</h1>
        <p class="page-desc">
          Notes on code, sound, and making things.
          {posts.length > 0 && <span class="post-count">{posts.length} posts</span>}
        </p>
      </header>

      {posts.length > 0 ? (
        <div class="posts-list">
          {posts.map(post => (
            <PostRow
              title={post.data.title}
              date={post.data.date}
              slug={post.id}
              description={post.data.description}
              tags={post.data.tags}
            />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing published yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }
  .page-header h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .page-desc {
    color: var(--color-muted);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .post-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--color-tag-bg);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    color: var(--color-muted);
  }
  .posts-list { display: flex; flex-direction: column; }
  .empty { color: var(--color-muted); font-style: italic; }
</style>
