---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import Icon from '../../components/Icon.astro';
import { isoDots, pad } from '../../lib/datum';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Group by year
const byYear = allPosts.reduce<Record<string, typeof allPosts>>((acc, post) => {
  const year = new Date(post.data.date).getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

// Post number in the archive (oldest = 001).
const postNumber = (id: string) => pad(allPosts.length - allPosts.findIndex((p) => p.id === id), 3);
const latest = allPosts[0];
---

<BaseLayout
  title="Writing — Vlady Yakovenko"
  description="Posts on engineering, music, generative art, and tooling by Vlady Yakovenko (polyterative)."
  serial="PLY-W"
>
  <div class="container container--wide">
    <header class="page-head">
      <aside class="page-head__aside">
        <span class="plate page-head__idx">05</span>
        <span class="lbl">Posts</span>
        <span class="data">{allPosts.length}</span>
        {latest && (
          <>
            <span class="lbl">Latest</span>
            <time class="data" datetime={latest.data.date}>{isoDots(latest.data.date)}</time>
          </>
        )}
        <span class="lbl">Feed</span>
        <a class="data rss-link" href="/rss.xml"><Icon name="rss" size={12} />rss.xml</a>
      </aside>
      <div class="page-head__main">
        <h1>Writing</h1>
        <p class="page-head__lead">Notes on engineering, tooling, sound, and making things.</p>
      </div>
    </header>

    {allPosts.length > 0 ? (
      <div class="posts-by-year">
        {years.map(year => (
          <section class="sec year-group" aria-labelledby={`y-${year}`}>
            <header class="sec__head">
              <h2 class="plate sec__idx" id={`y-${year}`}>{year}</h2>
              <span class="lbl">{byYear[year].length} {byYear[year].length === 1 ? 'post' : 'posts'}</span>
            </header>
            <div class="sec__body posts-list">
              {byYear[year].map(post => (
                <PostRow
                  title={post.data.title}
                  date={post.data.date}
                  slug={post.id}
                  description={post.data.description}
                  tags={post.data.tags}
                  cover={post.data.cover}
                  index={postNumber(post.id)}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="empty">Nothing published yet — check back soon.</p>
    )}
  </div>
</BaseLayout>

<style>
  .rss-link { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--ink); align-self: flex-start; border-bottom: 1px solid var(--rule-strong); }
  .rss-link:hover { color: var(--signal-text); border-color: currentColor; }
  .rss-link :global(.icon) { color: var(--ink-3); }

  .year-group h2.sec__idx { font-weight: 400; letter-spacing: 0; }
  .posts-list { gap: 0; }
  .posts-list :global(.post-row:first-child) { border-top: 1px solid var(--ink); }
  .empty { color: var(--ink-2); }
</style>
