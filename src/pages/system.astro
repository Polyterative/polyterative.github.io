              <tr><th scope="row">Several of a set</th><td>Checkbox list</td></tr>
              <tr><th scope="row">One of 2–4, all visible</th><td>Segmented control</td></tr>
              <tr><th scope="row">One of 5+ named presets</th><td>Menu button showing the current value</td></tr>
              <tr><th scope="row">A number on a range</th><td>Slider (more than six sensible values)</td></tr>
              <tr><th scope="row">A number typed exactly</th><td>Text field with a <code>meta</code> unit after it</td></tr>
