              <tr><th scope="row">Apps in the registry</th><td>Roman</td><td><span class="data">{apps.map((_, i) => roman(i + 1)).join(' · ')}</span></td></tr>
              <tr><th scope="row">Releases</th><td>Roman</td><td><span class="data">{roman(releases.length)} ({releases.length})</span></td></tr>
              <tr><th scope="row">Posts</th><td>3-digit decimal</td><td><span class="data">No. {pad(posts, 3)}</span></td></tr>
              <tr><th scope="row">Figures</th><td>Greek</td><td><span class="data">Fig. {greek(1)} · Fig. {greek(2)} · Fig. {greek(3)}</span></td></tr>
            </tbody>
          </table>

          <p class="sec__intro">See the system applied on real interfaces in the <a class="act" href="/showcase">Showcase</a>, or read the full spec in <a class="act" href={sourceUrl} target="_blank" rel="noopener">DESIGN.md</a>.</p>
        </section>
