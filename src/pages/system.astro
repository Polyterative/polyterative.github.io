</SystemLayout>

<script>
  const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];

  // Mixed checkbox state is a property, not an attribute.
  $$<HTMLInputElement>('input[data-mixed]').forEach((i) => { i.indeterminate = true; });

  // Toggles
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const tog = t.closest<HTMLElement>('.dk-tog');
    if (tog && !tog.hasAttribute('disabled')) tog.setAttribute('aria-checked', String(tog.getAttribute('aria-checked') !== 'true'));

    // Segmented controls
    const seg = t.closest<HTMLElement>('[data-seg] button');
    if (seg) {
      seg.parentElement!.querySelectorAll('button').forEach((b) => b.setAttribute('aria-checked', String(b === seg)));
    }

    // Chips
    const x = t.closest<HTMLElement>('.dk-chip__x');
    if (x) x.closest('.dk-chip')!.setAttribute('hidden', '');
    const reset = t.closest<HTMLElement>('[data-chips-reset]');
    if (reset) reset.closest('.dk-field')!.querySelectorAll('.dk-chip').forEach((c) => c.removeAttribute('hidden'));

    // Secure field reveal
    const rev = t.closest<HTMLElement>('[data-showkey]');
    if (rev) {
      const input = rev.parentElement!.querySelector<HTMLInputElement>('[data-secure]')!;
      const show = input.type === 'password';
      setReveal(input, rev, show);
    }

    // Row select / edit
    const row = t.closest<HTMLElement>('[data-row]');
    if (row) {
      const list = row.parentElement!;
      if (t.closest('[data-edit]')) {
        list.querySelectorAll('.is-editing').forEach((r) => r.classList.remove('is-editing'));
        row.classList.add('is-editing', 'is-selected');
        openEdit(row);
      } else if (!t.closest('.dk-edit')) {
        list.querySelectorAll('.is-selected').forEach((r) => r.classList.remove('is-selected'));
        row.classList.add('is-selected');
      }
    }
    if (t.closest('[data-cancel]')) closeEdit(t.closest<HTMLElement>('[data-row]'));

    // Checklist
    const cl = t.closest<HTMLElement>('[data-checklist]');
    if (cl && t.closest('[data-all], [data-none]')) {
      const on = !!t.closest('[data-all]');
      $$<HTMLInputElement>('input', cl).forEach((i) => { i.checked = on; });
      countList(cl);
    }
  });

  document.addEventListener('change', (e) => {
    const cl = (e.target as HTMLElement).closest<HTMLElement>('[data-checklist]');
    if (cl) countList(cl);
  });
  function countList(cl: HTMLElement) {
    const boxes = $$<HTMLInputElement>('input', cl);
    const n = boxes.filter((b) => b.checked).length;
    const c = cl.querySelector('[data-count]');
    if (c) c.textContent = `${n} of ${boxes.length}`;
  }

  // Secure field: hide again on blur and after 30 seconds.
  const timers = new WeakMap<HTMLInputElement, number>();
  function setReveal(input: HTMLInputElement, btn: HTMLElement, show: boolean) {
    input.type = show ? 'text' : 'password';
    btn.setAttribute('aria-label', show ? 'Hide' : 'Show');
    btn.querySelector('[data-eye]')!.toggleAttribute('hidden', show);
    btn.querySelector('[data-eye-off]')!.toggleAttribute('hidden', !show);
    clearTimeout(timers.get(input));
    if (show) timers.set(input, window.setTimeout(() => setReveal(input, btn, false), 30000));
  }
  document.addEventListener('focusout', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.matches?.('[data-secure]') && input.type === 'text') {
      const btn = input.parentElement!.querySelector<HTMLElement>('[data-showkey]')!;
      // Ignore the move of focus onto the reveal button itself.
      requestAnimationFrame(() => { if (document.activeElement !== btn) setReveal(input, btn, false); });
    }
  });

  // In-place editing: swap the text column for fields, restore on cancel.
  const saved = new WeakMap<HTMLElement, string>();
  function openEdit(row: HTMLElement) {
    const text = row.querySelector<HTMLElement>('.dk-row__text');
    if (!text) return;
    const title = text.querySelector('.dk-title-row')?.textContent ?? '';
    saved.set(row, row.innerHTML);
    text.outerHTML = `<div class="dk-edit"><label class="dk-field"><span class="dk-label">Name</span><span class="dk-input-wrap"><input class="dk-input" type="text" value="${title.replace(/"/g, '&quot;')}" /></span></label><div class="dk-edit__actions"><button class="dk-btn dk-btn--secondary" type="button" data-cancel>Cancel</button><button class="dk-btn dk-btn--primary" type="button" data-cancel>Save</button></div></div>`;
    row.querySelector('.dk-listrow__end')?.remove();
    row.querySelector<HTMLInputElement>('input')?.focus();
  }
  function closeEdit(row: HTMLElement | null) {
    if (!row) return;
    const html = saved.get(row);
    row.classList.remove('is-editing');
    if (html) { row.innerHTML = html; saved.delete(row); }
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') $$('.is-editing').forEach((r) => closeEdit(r));
    const row = (e.target as HTMLElement).closest?.<HTMLElement>('[data-row]');
    if (row && (e.key === 'Enter') && (e.target as HTMLElement) === row && !row.classList.contains('is-editing')) row.querySelector<HTMLElement>('[data-edit]')?.click();

    // Segmented control arrows
    const seg = (e.target as HTMLElement).closest?.<HTMLElement>('[data-seg] button');
    if (seg && (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) {
      const all = $$('button', seg.parentElement!);
      const next = all[(all.indexOf(seg) + (e.key === 'ArrowRight' ? 1 : -1) + all.length) % all.length];
      next.click(); next.focus(); e.preventDefault();
    }
  });

  // Sliders
  $$('[data-slider]').forEach((wrap) => {
    const el = wrap.querySelector<HTMLElement>('.dk-slider')!;
    const thumb = wrap.querySelector<HTMLElement>('.dk-slider__thumb')!;
    const out = wrap.querySelector<HTMLElement>('[data-readout]')!;
    const ticks = $$('i', wrap);
    const { min, max, step, unit } = { min: +el.dataset.min!, max: +el.dataset.max!, step: +el.dataset.step!, unit: el.dataset.unit ?? '' };
    let value = +el.getAttribute('aria-valuenow')!;
    const set = (v: number) => {
      value = Math.min(max, Math.max(min, Math.round((v - min) / step) * step + min));
      el.setAttribute('aria-valuenow', String(value));
      thumb.style.left = `${((value - min) / (max - min)) * 100}%`;
      out.textContent = `${value}${unit}`;
      ticks.forEach((t) => t.classList.toggle('is-on', +t.dataset.v! <= value));
    };
    const fromPointer = (ev: PointerEvent) => {
      const r = el.getBoundingClientRect();
      set(min + ((ev.clientX - r.left) / r.width) * (max - min));
    };
    el.addEventListener('pointerdown', (ev) => { el.setPointerCapture(ev.pointerId); el.focus(); fromPointer(ev); });
    el.addEventListener('pointermove', (ev) => { if (el.hasPointerCapture(ev.pointerId)) fromPointer(ev); });
    el.addEventListener('keydown', (ev) => {
      const k = ev.key, big = ev.shiftKey ? 10 : 1;
      if (k === 'ArrowRight' || k === 'ArrowUp') set(value + step * big);
      else if (k === 'ArrowLeft' || k === 'ArrowDown') set(value - step * big);
      else if (k === 'Home') set(min);
      else if (k === 'End') set(max);
      else return;
      ev.preventDefault();
    });
  });

  // Scroll-spy for the contents list.
  const links = $$<HTMLAnchorElement>('[data-spy]');
  const targets = links.map((a) => document.getElementById(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.find((a) => a.dataset.spy === en.target.id)?.setAttribute('aria-current', 'location');
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>
