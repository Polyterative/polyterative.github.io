---
import Img from '../../components/Img.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { apps, featuredApps, moreApps } from '../../data/apps';
import { roman, greek, parseStatus, pillClass, sectionIndex } from '../../lib/datum';

const position = (slug: string) => roman(apps.findIndex((a) => a.slug === slug) + 1);
const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout
  title="Applications — Vlady Yakovenko"
  description="Software applications designed, built, and maintained by Vlady Yakovenko (polyterative): Patcher, Kinetip, and more. Each with its story, screenshots, and a fact sheet for publishers."
  serial="PLY-A"
>
  <div class="container container--wide">
    <header class="page-head">
      <aside class="page-head__aside">
        <span class="plate page-head__idx">{sectionIndex('/apps')}</span>
        <span class="lbl">Registry</span>
        <span class="data">{apps.length} applications</span>
        <span class="lbl">Flagships</span>
        <span class="data">{featuredApps.map((a) => a.name).join(' · ')}</span>
      </aside>
      <div class="page-head__main">
        <h1>Applications</h1>
        <p class="page-head__lead">
          Software I design, build, and maintain end-to-end — from the first sketch of the problem
          to the release pipeline. Each application has a dedicated page with the story behind it,
          screenshots, and a fact sheet.
        </p>
        <p class="page-head__note">
          Publisher or distributor? Every page ends with the details you need, and
          <a href="mailto:polyterative@outlook.com">my inbox is open</a>.
        </p>
      </div>
    </header>

    <section class="gallery" aria-label="Application gallery">
      {featuredApps.map((app, i) => {
        const status = parseStatus(app.status);
        return (
          <article class="showcase">
            <div class="showcase__media">
              <a class="showcase__frame crop" href={`/apps/${app.slug}`} aria-label={`${app.name} — view application page`}>
                <Img src={app.hero} alt={app.heroAlt} loading={i === 0 ? 'eager' : 'lazy'} />
              </a>
              <p class="figcap"><span class="lbl">Fig. <span class="nocase">{greek(i + 1)}</span></span><span>{app.heroAlt}</span></p>
            </div>
            <div class="showcase__body">
              <div class="showcase__kicker">
                <span class="plate showcase__idx">{position(app.slug)}</span>
                <div class="showcase__state">
                  <span class="lbl">{app.platform}</span>
                  <span class="showcase__status">
                    <span class={pillClass(status.tone)}>{status.head}</span>
                    {status.rest && <span class="data">{status.rest}</span>}
                  </span>
                </div>
              </div>
              <h2 class="showcase__name">
                <a href={`/apps/${app.slug}`}>{app.name}</a>
              </h2>
              <p class="showcase__tagline">{app.tagline}</p>
              <p class="showcase__pitch">{app.pitch}</p>
              <ul class="taglist">
                {app.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <div class="showcase__links">
                <a class="act" href={`/apps/${app.slug}`}>Story & fact sheet<Icon name="arrow-right" size={13} /></a>
                {app.links.map((link) => (
                  <a
                    class="act"
                    href={link.href}
                    target={isExternal(link.href) ? '_blank' : undefined}
                    rel={isExternal(link.href) ? 'noopener' : undefined}
                  >{link.label}<Icon name={isExternal(link.href) ? 'arrow-up-right' : 'arrow-right'} size={13} /></a>
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </section>

    <section class="sec minor" aria-labelledby="more-apps">
      <header class="sec__head">
        <span class="lbl">Also shipping</span>
        <h2 class="sec__title" id="more-apps">More applications</h2>
        <span class="lbl">{moreApps.length} entries</span>
      </header>
      <div class="sec__body">
        <p class="sec__intro">
          Smaller in scope, real in use — tools I built, shipped, and still stand behind.
        </p>
        <ul class="minor__grid">
          {moreApps.map((app) => {
            const status = parseStatus(app.status);
            return (
              <li class="minor__card">
                <div class="minor__kicker">
                  <span class="plate minor__idx">{position(app.slug)}</span>
                  <span class={pillClass(status.tone)}>{status.head}</span>
                </div>
                <span class="lbl">{app.platform}</span>
                <h3 class="minor__name"><a href={`/apps/${app.slug}`}>{app.name}</a></h3>
                <p class="minor__tagline">{app.tagline}</p>
                <p class="minor__pitch">{app.pitch}</p>
                <ul class="taglist">
                  {app.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <div class="minor__links">
                  <a class="act" href={`/apps/${app.slug}`}>Story & fact sheet<Icon name="arrow-right" size={13} /></a>
                  {app.links.map((link) => (
                    <a
                      class="act"
                      href={link.href}
                      target={isExternal(link.href) ? '_blank' : undefined}
                      rel={isExternal(link.href) ? 'noopener' : undefined}
                    >{link.label}<Icon name={isExternal(link.href) ? 'arrow-up-right' : 'arrow-right'} size={13} /></a>
                  ))}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <aside class="more">
      <p>Looking for the experiments, tools, and everything in between?</p>
      <a class="act" href="/projects">Browse all projects<Icon name="arrow-right" size={13} /></a>
    </aside>
  </div>
</BaseLayout>

<style>
  .gallery { display: flex; flex-direction: column; }

  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(var(--space-6), 4vw, var(--space-12));
    align-items: start;
    padding-block: var(--space-6) var(--space-16);
    border-top: 1px solid var(--ink);
  }
  .showcase:nth-child(even) .showcase__media { order: 2; }

  .showcase__frame {
    display: block;
    border: 1px solid var(--rule);
    background: var(--hover);
  }
  .showcase__frame:hover { border-color: var(--ink); }
  .showcase__frame :global(img) { width: 100%; }

  .showcase__body { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .showcase__kicker {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }
  .showcase__idx { font-size: 44px; color: var(--ink); }
  .showcase__state { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .showcase__status { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
  .showcase__name { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.035em; }
  .showcase__name a:hover { color: var(--signal-text); }
  .showcase__tagline { font-size: var(--fs-lead); line-height: 1.35; letter-spacing: -0.015em; text-wrap: balance; }
  .showcase__pitch { font-size: 15px; color: var(--ink-2); line-height: 1.6; max-width: 52ch; }
  .showcase__links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); margin-top: var(--space-3); }

  .minor__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    list-style: none;
  }
  .minor__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background-color: var(--bg);
    padding: var(--space-4) var(--space-4) var(--space-5);
  }
  .minor__kicker { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2); }
  .minor__idx { font-size: 28px; color: var(--ink); }
  .minor__name { font-size: 22px; letter-spacing: -0.02em; }
  .minor__name a:hover { color: var(--signal-text); }
  .minor__tagline { font-size: 16px; line-height: 1.4; }
  .minor__pitch { font-size: 15px; color: var(--ink-2); line-height: 1.55; }
  .minor__links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); margin-top: auto; padding-top: var(--space-3); }

  .more {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }
  .more p { color: var(--ink-2); font-size: 15px; }

  @media (max-width: 860px) {
    .showcase { grid-template-columns: 1fr; }
    .showcase:nth-child(even) .showcase__media { order: 0; }
    .showcase__idx { font-size: 32px; }
  }
</style>
