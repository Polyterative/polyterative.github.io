---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const projects = [
  {
    name: 'Poly Highlights',
    description: 'Luminance-corrected syntax highlighting for JetBrains IDEs.',
    repo: 'https://github.com/polyterative/Poly-highlights',
    tags: ['JetBrains', 'Design', 'Tooling'],
  },
  {
    name: 'POLY_REACTIVE_VISUALS',
    description: 'Angular + Three.js + RxJS scaffold for audio-reactive generative visuals with OSC support.',
    url: 'https://reactive-visuals.vercel.app',
    repo: 'https://github.com/polyterative/POLY_REACTIVE_VISUALS',
    tags: ['Three.js', 'RxJS', 'OSC'],
  },
  {
    name: 'thear',
    description: 'Translates Claude Code activity into real-time OSC messages for Ableton Live.',
    repo: 'https://github.com/polyterative/thear',
    tags: ['Python', 'OSC', 'AI'],
  },
  {
    name: 'Poly Talon Scripts',
    description: 'Talon Voice configuration for hands-free coding across JetBrains, terminal, and browser.',
    repo: 'https://github.com/polyterative/Poly-Talon-Scripts',
    tags: ['Voice Coding', 'Python', 'Talon'],
  },
];
---

<BaseLayout isHome={true}>
  <div class="container container--wide">

    <!-- Hero -->
    <section class="hero">
      <p class="label label--ic"><Icon name="map-pin" size={13} />Bologna, Italy</p>
      <h1 class="hero__title">UX Engineer.<br />Visual Artist.<br />Electronic Musician.</h1>
      <p class="hero__bio">
        Medium-agnostic creative at the intersection of software, generative art, and modular synthesis.
      </p>
      <ul class="hero__links">
        <li><a class="iclink" href="/projects"><Icon name="code" size={14} />Projects</a></li>
        <li><a class="iclink" href="/music"><Icon name="music" size={14} />Music</a></li>
        <li><a class="iclink" href="/blog"><Icon name="book" size={14} />Writing</a></li>
        <li><a class="iclink" href="/about"><Icon name="activity" size={14} />About</a></li>
      </ul>
    </section>

    <!-- Featured: Patcher -->
    <section class="featured-wrap" id="patcher">
      <div class="panel featured">
        <div class="featured__head">
          <span class="label label--ic"><Icon name="star" size={13} />Featured</span>
          <span class="label">Active — v5.3.7</span>
        </div>
        <h2 class="featured__title">
          <a class="iclink accent-hover" href="https://patcher.xyz" target="_blank" rel="noopener">Patcher<Icon name="arrow-up-right" size={22} /></a>
        </h2>
        <p class="featured__desc">
          A free, open-source workspace for Eurorack musicians — patch editor, rack planner,
          and community module database in one place.
        </p>
        <ul class="featured__bullets">
          <li><Icon name="arrow-right" size={14} />Plan and document your patches — never lose a setup again</li>
          <li><Icon name="arrow-right" size={14} />Drag-and-drop rack builder with a searchable module database</li>
          <li><Icon name="arrow-right" size={14} />Browse the community database without creating an account</li>
        </ul>
        <ul class="featured__stats">
          <li class="stat"><Icon name="star" size={13} />35 stars</li>
          <li class="stat"><Icon name="calendar" size={13} />since 2021</li>
          <li class="stat"><Icon name="code" size={13} />open source</li>
        </ul>
        <div class="featured__actions">
          <a class="btn iclink" href="https://patcher.xyz" target="_blank" rel="noopener">Open app<Icon name="arrow-up-right" size={14} /></a>
          <a class="btn-text iclink" href="https://github.com/polyterative/Patcher" target="_blank" rel="noopener"><Icon name="github" size={13} />Source</a>
          <a class="btn-text iclink" href="https://discord.gg/N6Z32xJR" target="_blank" rel="noopener"><Icon name="message" size={13} />Discord</a>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="block" id="work">
      <header class="block__head">
        <h2 class="block__title"><Icon name="layers" size={18} />Projects</h2>
      </header>
      <ul class="grid">
        {projects.map(p => <li><ProjectCard {...p} /></li>)}
      </ul>
      <a href="/projects" class="more iclink">All projects<Icon name="arrow-right" size={13} /></a>
    </section>

    <!-- Recent writing -->
    {posts.length > 0 && (
      <section class="block" id="writing">
        <header class="block__head">
          <h2 class="block__title"><Icon name="book" size={18} />Recent posts</h2>
        </header>
        <div class="rows">
          {posts.map(post => (
            <PostRow
              title={post.data.title}
              date={post.data.date}
              slug={post.id}
              description={post.data.description}
              tags={post.data.tags}
              compact={true}
            />
          ))}
        </div>
        <a href="/blog" class="more iclink">All posts<Icon name="arrow-right" size={13} /></a>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding-block: var(--space-24) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }
  .hero__title {
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .hero__bio {
    font-size: var(--font-size-lg);
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 42ch;
  }
  .hero__links {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .hero__links a {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }
  .hero__links a:hover { color: var(--color-text); }

  /* ── Featured (filled panel) ── */
  .featured-wrap {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-line);
  }
  .featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--max-w);
    padding: var(--space-8);
  }
  .featured__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .featured__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
  }
  .featured__title .icon { color: var(--color-faint); }
  .featured__desc {
    font-size: var(--font-size-base);
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 52ch;
  }
  .featured__bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .featured__bullets li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: 1.55;
  }
  .featured__bullets .icon { color: var(--color-accent); flex: none; }
  .featured__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-1);
  }
  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }

  /* ── Buttons ── */
  .btn {
    font-size: var(--font-size-sm);
    font-weight: 500;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    border-radius: var(--radius-pill);
    transition: border-color var(--transition), background var(--transition);
  }
  .btn:hover { border-color: var(--color-text); background: var(--color-hover); }
  .btn .icon { color: var(--color-faint); }
  .btn:hover .icon { color: var(--color-text); }
  .btn-text {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }
  .btn-text:hover { color: var(--color-text); }

  /* ── Blocks ── */
  .block {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-line);
  }
  .block:last-child { border-bottom: none; }
  .block__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .block__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .block__title .icon { color: var(--color-accent); }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-8);
    list-style: none;
    max-width: var(--max-w);
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }
  .rows { display: flex; flex-direction: column; }

  .more {
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }
  .more:hover { color: var(--color-text); }
  .more .icon { color: var(--color-faint); }
  .more:hover .icon { color: var(--color-accent); }

  @media (max-width: 560px) {
    .featured { padding: var(--space-5); }
  }
</style>
