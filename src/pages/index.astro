---
import Img from '../components/Img.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { apps } from '../data/apps';
import { italy, europe } from '../data/map-italy';
import { releases } from '../data/releases';
import { pad, isoDots, hex, roman, greek, letter, sections, parseStatus, pillClass } from '../lib/datum';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
;

const featuredPostIds = [
  'the-loop-directing-a-swarm-of-agents',
  'impulse-webgpu-generative-visual-engine',
  'home-assistant-infrastructure',
];

const featuredPosts = featuredPostIds
  .map((id) => allPosts.find((post) => post.id === id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

// Post number in the archive (oldest = 001), so the index carries real position.
const postNumber = (id: string) => pad(allPosts.length - allPosts.findIndex((p) => p.id === id), 3);

// Home copy for the selected work. Order = rack order, left to right (flagships first).
const selectedProjects = [
  {
    name: 'Patcher',
    description: 'Founder-built product for Eurorack musicians: patch editor, rack planner, and community module database shaped around a real workflow pain point.',
    url: 'https://patcher.xyz',
    repo: 'https://github.com/polyterative/Patcher',
    details: '/apps/patcher',
    tags: ['Product', 'Angular', 'TypeScript', 'Supabase', 'Open Source'],
    image: '/projects/patcher.jpg',
    featured: true,
  },
  {
    name: 'Kinetip',
    description: 'A native macOS driver that makes a pen tablet a first-class pointing device — absolute positioning and context-aware inertial scrolling, built in Swift.',
    details: '/apps/kinetip',
    tags: ['macOS', 'Swift', 'Realtime', 'Accessibility'],
    featured: true,
  },
  {
    name: 'CostaMeno',
    description: 'Mobile-first utility that turns Italian fuel-price open data into a fast, trustworthy tool with no login, no ads, and no tracking.',
    url: 'https://costameno.vercel.app',
    details: '/apps/costameno',
    tags: ['Next.js', 'TypeScript', 'Open Data', 'Civic Tech'],
  },
  {
    name: 'Impulse',
    description: 'A node-based WebGPU visual engine for live AV performance, built as a transparent TypeScript alternative to opaque proprietary creative tools.',
    details: '/apps/impulse',
    tags: ['WebGPU', 'TypeScript', 'Creative Tooling', 'Systems Design'],
  },
];

// ── Rack modules: every value comes from src/data/apps.ts ──
const fact = (slug: string, label: string) =>
  apps.find((a) => a.slug === slug)?.facts.find((f) => f.label === label)?.value;

const modules = selectedProjects.map((p) => {
  const slug = p.details.replace('/apps/', '');
  const app = apps.find((a) => a.slug === slug)!;
  const status = parseStatus(app.status);
  const writeUp = app.links.find((l) => l.href.startsWith('/blog/'));
  return {
    ...p,
    slug,
    registry: roman(apps.indexOf(app) + 1),
    platform: app.platform,
    status,
    version: fact(slug, 'Current version'),
    since: fact(slug, 'First release'),
    writeUp: writeUp?.href,
    writeUpId: writeUp?.href.replace('/blog/', ''),
  };
});

// A post is patched to a module only when apps.ts links that app to that post.
const relatedApp = (postId: string) =>
  modules.find((m) => m.writeUpId === postId);

// ── Record (growth line): one node per year, one leaf per release or post ──
const chrono = [
  ...releases.map((r) => ({ kind: 'release' as const, date: r.date })),
  ...allPosts.map((p) => ({ kind: 'post' as const, date: p.data.date })),
].sort((a, b) => a.date.localeCompare(b.date));

const y0 = Number(chrono[0].date.slice(0, 4));
const y1 = Math.max(Number(chrono.at(-1)!.date.slice(0, 4)), new Date().getFullYear());
const years = Array.from({ length: y1 - y0 + 1 }, (_, i) => y0 + i);
const byYear = years.map((y) => ({
  year: y,
  items: chrono.filter((c) => Number(c.date.slice(0, 4)) === y),
}));

const GW = 1000;
const GH = 196;
const base = 184;
const r1 = (n: number) => Math.round(n * 10) / 10;
const cx = (i: number) => ((i + 0.5) / years.length) * GW;
const waveY = (x: number) => base - Math.sin((x / GW) * Math.PI * 3) * 4;
let trunk = `M0 ${r1(waveY(0))}`;
for (let i = 1; i <= 80; i++) {
  const x = (i / 80) * GW;
  trunk += ` L${r1(x)} ${r1(waveY(x))}`;
}
const STEP = 11;
const plants = byYear.map((y, i) => {
  const x = cx(i);
  const by = waveY(x);
  const n = y.items.length;
  if (n === 0) return { year: y.year, x: r1(x), y: r1(by), empty: true as const };
  const h = 16 + n * STEP;
  const lean = 7;
  const stem = `M${r1(x)} ${r1(by)} C ${r1(x)} ${r1(by - h * 0.5)}, ${r1(x + lean)} ${r1(by - h * 0.75)}, ${r1(x + lean)} ${r1(by - h)}`;
  const leaves = y.items.map((it, k) => {
    const t = (k + 1) / (n + 0.6);
    const ly = by - 10 - k * STEP;
    const lx = x + lean * t * t;
    const right = k % 2 === 0;
    const d = right
      ? `M${r1(lx)} ${r1(ly)} c 6 -1, 11 -6, 12 -13 c -7 1, -11 6, -12 13 z`
      : `M${r1(lx)} ${r1(ly)} c -6 -1, -11 -6, -12 -13 c 7 1, 11 6, 12 13 z`;
    return { d, kind: it.kind };
  });
  return { year: y.year, empty: false as const, stem, leaves };
});
const releaseCount = releases.length;
const postCount = allPosts.length;

// ── Cover marks ──
const serial = 'PLY-IDX';
const bits = [...serial].flatMap((ch) => [...ch.charCodeAt(0).toString(2).padStart(8, '0')]);
const latestPost = allPosts[0];
// Cover stub: where I am, drawn as a hairline instrument map from real coordinates.
// Equirectangular, longitude scaled by cos(44.5°); 1° of latitude = 100 units.
const home = { name: 'Castelfranco Emilia', lat: 44.5967, lon: 11.0525 };
const kx = 100 * Math.cos((home.lat * Math.PI) / 180);
const proj = (lat: number, lon: number) => ({ x: (lon - home.lon) * kx, y: (home.lat - lat) * 100 });
const mapW = 1200, mapH = 420;
// Graticule every 5°, wide enough to cover the zoomed-out Europe view.
const meridians = Array.from({ length: 21 }, (_, i) => -40 + i * 5).map((lon) => proj(0, lon).x);
const parallels = Array.from({ length: 11 }, (_, i) => 25 + i * 5).map((lat) => proj(lat, 0).y);
const gridExtent = 6000;
const coord = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(4)}° ${v >= 0 ? pos : neg}`;

// Boot log shown while the cover powers on. Every figure is real.
const bootLog = [
  [`${serial} · cold start`, 'v0.3'],
  ['mount /software', 'ok'],
  ['mount /visuals', 'ok'],
  ['mount /sound', 'ok'],
  [`index ${postCount} posts · ${apps.length} apps · ${releaseCount} releases`, 'ok'],
  [`locate ${home.lat.toFixed(4)} N ${home.lon.toFixed(4)} E`, 'ok'],
  ['ready', '▮'],
];

// Title word materials. visuals: each letter has a geometric alter ego it passes through.
const geo = ['circle', 'square', 'diamond', 'pill', 'square', 'circle', 'diamond'];
const visualLetters = [...'visuals'].map((c, i) => ({ c, shape: geo[i % geo.length] }));
// sound: a waveform of bars under the letters. Amplitudes follow a spoken-word envelope
// (two syllable humps) with a deterministic wobble, so the shape is the same every build.
const waveBars = Array.from({ length: 32 }, (_, i) => {
  const t = i / 31;
  const env = Math.max(Math.sin(Math.PI * Math.min(1, t / 0.55)), 0.6 * Math.sin(Math.PI * Math.max(0, (t - 0.45) / 0.55)));
  const wob = 0.55 + 0.45 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6));
  return { a: (0.12 + 0.88 * env * wob).toFixed(2), b: (0.12 + 0.7 * env * (1 - wob * 0.6)).toFixed(2) };
});

const contents = sections.map((s, i) => ({ ...s, index: hex(i + 1) }));
---

<BaseLayout
  title="Vlady Yakovenko — Notes, work, and ongoing systems"
  description="A personal blog and work archive by Vlady Yakovenko, spanning software, tools, visuals, and technical notes."
  isHome={true}
  serial={serial}
>
  <div class="container container--wide home">

    <!-- ── 00 · Cover ── -->
    <!-- Boot runs on every visit to home, before the cover paints; skipped for reduced motion. -->
    <script is:inline>
      (function () {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement, timer;
        function boot() {
          clearTimeout(timer);
          root.classList.remove('booting');
          void root.offsetWidth;
          root.classList.add('booting');
          timer = setTimeout(function () { root.classList.remove('booting'); }, 7600);
        }
        boot();
        // Coming back via the browser's back button restores a frozen page; boot it again.
        window.addEventListener('pageshow', function (e) { if (e.persisted) boot(); });
      })();
    </script>
    <section class="cover" aria-labelledby="cover-title">
      <div class="field">
        <ol class="boot" aria-hidden="true">
          {bootLog.map((l, n) => (
            <li style={`--n:${n}`}><span>{l[0]}</span><i></i><span>{l[1]}</span></li>
          ))}
        </ol>
        <div class="field__top">
          <span class="lbl">Vlady Yakovenko · Personal archive</span>
          <span class="lbl">§{hex(0)} Index · {serial}</span>
        </div>
        <h1 class="field__title" id="cover-title">
          <span class="visually-hidden">Designer working across software, visuals, and sound.</span>
          <span aria-hidden="true">Designer working across <span class="w"><span class="w--code" data-word="software">software</span>,</span> <span class="w"><span class="w--motion">{visualLetters.map((l, i) => (
            <span class="g" style={`--i:${i}`}><span class="g__c">{l.c}</span><i class:list={['g__s', `g__s--${l.shape}`]}></i></span>
          ))}</span>,</span> and <span class="w"><span class="w--sound"><span class="s__txt">sound</span><span class="s__wave">{waveBars.map((b, i) => (
            <i style={`--i:${i};--a:${b.a};--b:${b.b}`}></i>
          ))}</span></span>.</span></span>
        </h1>
        <div class="field__word" aria-hidden="true"><span>Polyterative</span></div>
        <div class="stub">
          <div class="stub__id">
            <span class="lbl">Based in</span>
            <span class="stub__place">Castelfranco Emilia, Italy</span>
            <span class="lbl">{coord(home.lat, 'N', 'S')} · {coord(home.lon, 'E', 'W')}</span>
            <span class="lbl">Local <time class="stub__clock" id="local-time">--:--</time></span>
          </div>
          <svg class="stub__map" viewBox={`${-mapW / 2} ${-mapH / 2} ${mapW} ${mapH}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label="Map of Italy with Castelfranco Emilia marked; hover to zoom out to Europe">
            <defs>
              <radialGradient id="map-fade" cx="50%" cy="50%" r="50%">
                <stop offset="55%" stop-color="#fff" />
                <stop offset="100%" stop-color="#fff" stop-opacity="0" />
              </radialGradient>
              <mask id="map-mask" maskUnits="userSpaceOnUse" x={-mapW / 2} y={-mapH / 2} width={mapW} height={mapH}>
                <rect x={-mapW / 2} y={-mapH / 2} width={mapW} height={mapH} fill="url(#map-fade)" />
              </mask>
            </defs>
            <g mask="url(#map-mask)" class="map__reveal">
              <g class="map__pan">
                <g class="map__zoom">
                  <g class="map__grid">
                    {meridians.map((x) => <line x1={x} x2={x} y1={-gridExtent} y2={gridExtent} />)}
                    {parallels.map((y) => <line x1={-gridExtent} x2={gridExtent} y1={y} y2={y} />)}
                  </g>
                  <path class="map__europe" d={europe} />
                  <path class="map__italy" d={italy} />
                </g>
                <g class="map__home">
                  <circle r="1" class="map__ping" />
                  <g class="map__cross">
                    <circle r="22" class="map__ring" />
                    <line x1="-32" x2="-10" y1="0" y2="0" /><line x1="10" x2="32" y1="0" y2="0" />
                    <line y1="-32" y2="-10" x1="0" x2="0" /><line y1="10" y2="32" x1="0" x2="0" />
                    <rect x="-2.5" y="-2.5" width="5" height="5" />
                  </g>
                  <polyline class="map__leader" points="16,-16 44,-44 292,-44" pathLength="1" />
                  <text class="map__label" x="50" y="-54">Castelfranco Emilia</text>
                </g>
              </g>
            </g>
          </svg>
        </div>
      </div>

      <figure class="slab plate-fig">
        <div class="plate-fig__hd">
          <span class="lbl">Fig. <span class="nocase">{greek(1)}</span></span>
          <span class="lbl">Portrait</span>
        </div>
        <Img
          src="/vlady.jpg"
          alt="Portrait of Vlady Yakovenko, 2023"
          loading="eager"
        />
        <figcaption class="plate-fig__cap">
          <span class="data">Portrait, 2023</span>
          <span class="lbl">Latest entry <time datetime={latestPost.data.date}>{isoDots(latestPost.data.date)}</time></span>
        </figcaption>
        <div class="plate-fig__strip" aria-hidden="true">
          {bits.map((b, n) => <i class:list={{ on: b === '1' }} style={`--n:${n}`}></i>)}
        </div>
        <span class="lbl plate-fig__serial">{serial} · {bits.length} bits</span>
      </figure>
    </section>

    <!-- ── Intro: who, what, where to go ── -->
    <section class="intro" aria-label="Introduction">
      <aside class="intro__aside">
        <span class="lbl">Base</span>
        <span class="data">Castelfranco Emilia, Italy</span>
        <span class="lbl">Practice</span>
        <ul class="intro__facts">
          <li class="stat">design</li>
          <li class="stat">code</li>
          <li class="stat">sound</li>
        </ul>
      </aside>
      <div class="intro__bio">
        <p class="intro__lead">
          I work at the intersection of design and engineering: interfaces that hold up structurally and read clearly, built with the same care at the system level as at the pixel level.
        </p>
        <p class="intro__body">
          Years of making music, visuals, and interactive work taught me composition, timing, and systems thinking — and all of it feeds back into how I design software.
        </p>
      </div>
      <nav class="contents" aria-label="Sections">
        <span class="lbl contents__hd">Contents</span>
        <ol>
          {contents.map((s) => (
            <li><a href={s.href}><span class="lbl">{s.index}</span><span class="contents__t">{s.label}</span><Icon name="arrow-right" size={13} /></a></li>
          ))}
          <li><a href="mailto:polyterative@outlook.com"><span class="lbl">Mail</span><span class="contents__t">Email</span><Icon name="mail" size={13} /></a></li>
        </ol>
      </nav>

      <div class="record">
        <div class="record__hd">
          <span class="lbl">Record · {y0}–{y1}</span>
          <span class="data">{releaseCount} releases and {postCount} posts, one leaf each</span>
          <span class="record__key lbl" aria-hidden="true">
            <svg width="10" height="12" viewBox="0 0 12 14"><path class="leaf" d="M0 14 c 6 -1, 11 -6, 12 -13 c -7 1, -11 6, -12 13 z" /></svg>Release
            <svg width="10" height="12" viewBox="0 0 12 14"><path class="leaf leaf--post" d="M0 14 c 6 -1, 11 -6, 12 -13 c -7 1, -11 6, -12 13 z" /></svg>Post
          </span>
        </div>
        <svg class="growth" viewBox={`0 0 ${GW} ${GH}`} role="img" aria-labelledby="growth-desc">
          <desc id="growth-desc">Releases and posts per year, {y0} to {y1}: {byYear.map((y) => `${y.year}: ${y.items.length}`).join(', ')}.</desc>
          <path class="stem" d={trunk} vector-effect="non-scaling-stroke" />
          {plants.map((p) => p.empty
            ? <circle class="bud" cx={p.x} cy={p.y} r="3" vector-effect="non-scaling-stroke" />
            : <>
                <path class="stem" d={p.stem} vector-effect="non-scaling-stroke" />
                {p.leaves.map((l) => <path class:list={['leaf', { 'leaf--post': l.kind === 'post' }]} d={l.d} vector-effect="non-scaling-stroke" />)}
              </>
          )}
        </svg>
        <ol class="record__axis" style={`--n:${years.length}`}>
          {byYear.map((y) => (
            <li>
              <span class="lbl">{y.year}</span>
              <span class="data">{y.items.length}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="patchbay" data-patchbay>

      <!-- ── 01 · Selected work, as a rack ── -->
      <section class="sec sec--rack" id="work">
        <header class="sec__head">
          <span class="plate sec__idx">{letter(1)}</span>
          <h2 class="sec__title">A few things I've made</h2>
          <span class="lbl">{selectedProjects.length} of {apps.length} applications</span>
        </header>
        <div class="sec__body">
          <p class="sec__intro">
            Not a complete list. Just a few recurring artifacts — each with its full story in the applications gallery.
          </p>
        </div>

        <ul class="rack">
          {modules.map((m) => (
            <li class:list={['mod', { 'mod--wide': m.featured }]}>
              <i class="screw tl" aria-hidden="true"></i><i class="screw tr" aria-hidden="true"></i>
              <i class="screw bl" aria-hidden="true"></i><i class="screw br" aria-hidden="true"></i>

              <div class="mod__hd">
                <span class="mod__reg"><span class="plate">{m.registry}</span></span>
                <span class={pillClass(m.status.tone)}>{m.status.head}</span>
              </div>

              <h3 class="mod__name"><a href={m.details}>{m.name}</a></h3>
              <p class="mod__desc">{m.description}</p>

              <dl class="mod__specs">
                <div><dt class="lbl">Platform</dt><dd class="data">{m.platform}</dd></div>
                {m.version && <div><dt class="lbl">Ver</dt><dd class="data">{m.version}</dd></div>}
                {m.since && <div><dt class="lbl">Since</dt><dd class="data">{m.since}</dd></div>}
                {m.status.rest && <div class="mod__state"><dt class="lbl">Stat</dt><dd class="data">{m.status.rest}</dd></div>}
              </dl>

              <ul class="taglist mod__tags">{m.tags.map((t) => <li>{t}</li>)}</ul>

              <div class="mod__jacks">
                {m.url && (
                  <a class="jack" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name}: open ${new URL(m.url).host} (new tab)`}>
                    <span class="lbl">Url</span><i aria-hidden="true"></i>
                  </a>
                )}
                {m.repo && (
                  <a class="jack" href={m.repo} target="_blank" rel="noopener" aria-label={`${m.name}: source on GitHub (new tab)`}>
                    <span class="lbl">Src</span><i aria-hidden="true"></i>
                  </a>
                )}
                {m.writeUp && (
                  <a class="jack" href={m.writeUp} aria-label={`${m.name}: read the write-up`}>
                    <span class="lbl">Doc</span><i aria-hidden="true" data-patch-from={m.writeUpId}></i>
                  </a>
                )}
                <a class="jack jack--out" href={m.details} aria-label={`${m.name}: full story`}>
                  <span class="inv">Out</span><i aria-hidden="true"></i>
                </a>
              </div>
            </li>
          ))}
        </ul>

        <div class="more sec__more">
          <a href="/apps" class="btn btn--primary">Browse the applications<Icon name="arrow-right" size={14} /></a>
          <a href="/projects" class="act">See the full archive<Icon name="arrow-right" size={13} /></a>
        </div>
      </section>

      <!-- ── 02 · Featured writing ── -->
      {featuredPosts.length > 0 && (
        <section class="sec" id="writing">
          <header class="sec__head">
            <span class="plate sec__idx">{letter(2)}</span>
            <h2 class="sec__title">Writing</h2>
            <span class="lbl">{featuredPosts.length} of {allPosts.length} posts</span>
          </header>
          <div class="sec__body">
            <p class="sec__intro">A few places to begin.</p>
            <ol class="entries">
              {featuredPosts.map((post) => {
                const rel = relatedApp(post.id);
                return (
                  <li class="entry">
                    <div class="entry__no">
                      <span class="lbl">No.</span>
                      <span class="plate">{postNumber(post.id)}</span>
                    </div>
                    <div class="entry__body">
                      <time class="data entry__date" datetime={post.data.date}>{isoDots(post.data.date)}</time>
                      <h3 class="entry__title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                      {post.data.description && <p class="entry__desc">{post.data.description}</p>}
                      {post.data.tags.length > 0 && <ul class="taglist">{post.data.tags.map((t) => <li>{t}</li>)}</ul>}
                    </div>
                    <div class="entry__rel">
                      {rel && (
                        <a class="jack jack--in" href={rel.details} aria-label={`Related app: ${rel.name}`}>
                          <span class="lbl">App · {rel.name}</span><i aria-hidden="true" data-patch-to={post.id}></i>
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
            <div class="more"><a href="/blog" class="act">All posts<Icon name="arrow-right" size={13} /></a></div>
          </div>
        </section>
      )}

      <svg class="patch" aria-hidden="true"></svg>
    </div>

  </div>
</BaseLayout>

<script>
  // Patch lines: one curved hairline per real app ↔ post link (apps.ts `links`),
  // drawn between the two jack rings. Recomputed on resize; hidden on narrow screens.
  function drawPatches() {
    const bay = document.querySelector<HTMLElement>('[data-patchbay]');
    const svg = bay?.querySelector<SVGSVGElement>('svg.patch');
    if (!bay || !svg) return;
    svg.innerHTML = '';
    if (!window.matchMedia('(min-width: 900px)').matches) return;
    const bb = bay.getBoundingClientRect();
    svg.setAttribute('width', String(bb.width));
    svg.setAttribute('height', String(bb.height));
    svg.setAttribute('viewBox', `0 0 ${bb.width} ${bb.height}`);
    const centre = (el: Element) => {
      const r = el.getBoundingClientRect();
      return [r.left - bb.left + r.width / 2, r.top - bb.top + r.height / 2];
    };
    const ns = 'http://www.w3.org/2000/svg';
    bay.querySelectorAll('[data-patch-from]').forEach((from) => {
      const key = from.getAttribute('data-patch-from');
      const to = bay.querySelector(`[data-patch-to="${key}"]`);
      if (!to) return;
      const [x1, y1] = centre(from);
      const [x2, y2] = centre(to);
      const dy = Math.max(60, (y2 - y1) * 0.55);
      const path = document.createElementNS(ns, 'path');
      path.setAttribute('d', `M${x1} ${y1} C ${x1} ${y1 + dy}, ${x2} ${y2 - dy}, ${x2} ${y2}`);
      svg.appendChild(path);
      for (const [x, y] of [[x1, y1], [x2, y2]]) {
        const dot = document.createElementNS(ns, 'circle');
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', String(y));
        dot.setAttribute('r', '3.5');
        svg.appendChild(dot);
      }
    });
  }
  drawPatches();
  window.addEventListener('resize', drawPatches);
  document.fonts?.ready.then(drawPatches);
  window.addEventListener('load', drawPatches);
</script>

<script is:inline>
  // One sequencer plays the three title words in turn: software → visuals → sound.
  (function () {
    var code = document.querySelector('.w--code');
    var motion = document.querySelector('.w--motion');
    var sound = document.querySelector('.w--sound');
    if (!code || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
    var word = code.dataset.word, glyphs = '01{}<>/=;_#$';

    function play(el, ms) {
      el.classList.remove('is-playing');
      void el.offsetWidth;
      el.classList.add('is-playing');
      setTimeout(function () { el.classList.remove('is-playing'); }, ms);
    }
    function scramble() {
      var frame = 0, total = 18;
      play(code, 1300);
      var id = setInterval(function () {
        frame++;
        code.textContent = word.split('').map(function (c, i) {
          return frame > total * (i + 1) / word.length ? c : glyphs[(Math.random() * glyphs.length) | 0];
        }).join('');
        if (frame >= total) { clearInterval(id); code.textContent = word; }
      }, 45);
    }

    // Each word gets its turn, then hands over; a longer rest closes the bar.
    var step = 0;
    var steps = [scramble, function () { play(motion, 2800); }, function () { play(sound, 2900); }];
    var gaps = [1600, 3000, 5000];
    function tick() {
      if (!document.hidden) steps[step % 3]();
      setTimeout(tick, gaps[step % 3]);
      step++;
    }
    setTimeout(tick, document.documentElement.classList.contains('booting') ? 2750 : 1000);
  })();
</script>

<script is:inline>
  (function () {
    var el = document.getElementById('local-time');
    if (!el) return;
    var fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Rome', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
    function tick() { el.textContent = fmt.format(new Date()); }
    tick();
    setInterval(tick, 15000);
  })();
</script>

<style>
  /* ═══ Cover ═══════════════════════════════════════════════════════════
     The one loud surface: a signal field with ink grain (DESIGN.md §14),
     butted against an ink slab. Nothing on the field gets another colour. */
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    margin-top: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 580px;
    padding: var(--space-3) var(--space-6) 0;
    overflow: hidden;
    container-type: inline-size;
    background-color: var(--signal);
    background-image: var(--ink-on-fill);
    background-size: 220px 220px;
    color: var(--on-signal);
  }
  .field .lbl { color: var(--on-signal); }

  .field__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--on-signal);
  }

  .field__title {
    margin-top: clamp(var(--space-8), 6cqw, var(--space-16));
    font-size: clamp(2.4rem, 10cqw, 6.6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.05em;
    max-width: 9.6em;
    text-wrap: balance;
  }

  /* Title words: three materials, one sequencer (see script).
     Each word rests in the material of its medium and, on its turn, shows the medium at work.
     Same tempo and easing family throughout, one word at a time — a single instrument.
     software → code:   rests in mono; glyphs scramble and resolve left to right.
     visuals  → vector: rests as an outline; letters dissolve into geometric primitives that
                        turn and morph, then resolve back into type.
     sound    → signal: rests as letters cut from waveform bars; the letters fall away into a
                        live waveform that swells and decays, then the word re-forms. */
  .w { display: inline-block; white-space: nowrap; }
  .w--code { display: inline-block; position: relative; font-family: var(--f-plate); font-weight: 400; letter-spacing: -0.06em; font-size: 0.9em; margin-right: -0.02em; }
  @keyframes caret { 50% { opacity: 0; } }

  /* visuals — glyph and primitive cross-dissolve, so there is never an empty frame. */
  .w--motion { display: inline-block; }
  .g { position: relative; display: inline-block; }
  .g__c { display: inline-block; color: transparent; -webkit-text-stroke: 0.024em var(--on-signal); }
  .g__s {
    position: absolute;
    left: 50%;
    top: 0.34em;
    width: 0.34em;
    height: 0.34em;
    margin-left: -0.17em;
    border: 0.024em solid var(--on-signal);
    opacity: 0;
    pointer-events: none;
  }
  .g__s--circle  { border-radius: 50%; }
  .g__s--diamond { rotate: 45deg; scale: 0.82; }
  .g__s--pill    { border-radius: 0.17em; width: 0.18em; margin-left: -0.09em; }
  .w--motion.is-playing .g__c,
  .w--motion.is-playing .g__s { animation-duration: 2200ms; animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1); animation-fill-mode: both; animation-delay: calc(var(--i) * 70ms); }
  .w--motion.is-playing .g__c { animation-name: geo-glyph; }
  .w--motion.is-playing .g__s { animation-name: geo-shape; }
  @keyframes geo-glyph {
    0%, 100% { opacity: 1; transform: none; filter: blur(0); }
    22%, 74% { opacity: 0; transform: scale(0.82); filter: blur(0.02em); }
  }
  @keyframes geo-shape {
    0%   { opacity: 0; transform: scale(1.5); }
    24%  { opacity: 1; transform: scale(1); }
    50%  { transform: rotate(90deg) scale(1); }
    72%  { opacity: 1; transform: rotate(90deg) scale(1); }
    100% { opacity: 0; transform: rotate(90deg) scale(0.6); }
  }

  /* sound — the letters dissolve left to right into the waveform that drew them, and
     re-form in the same direction as the signal decays. */
  .w--sound { position: relative; display: inline-block; }
  .s__txt {
    display: inline-block;
    color: transparent;
    background: repeating-linear-gradient(90deg, var(--on-signal) 0 0.045em, transparent 0.045em 0.08em);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-mask-size: 400% 100%;
    mask-size: 400% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .s__wave {
    position: absolute;
    inset: 0.16em 0.02em 0.1em;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }
  .s__wave i { width: 0.04em; height: 100%; background: var(--on-signal); opacity: 0; transform: scaleY(0.5); }
  .w--sound.is-playing .s__txt { animation: wave-txt 2400ms cubic-bezier(0.45, 0, 0.55, 1) both; }
  .w--sound.is-playing .s__wave i { animation: wave-bar 2400ms cubic-bezier(0.45, 0, 0.55, 1) both; animation-delay: calc(var(--i) * 14ms); }
  /* One mask, slid right to left: ink | gap | ink. The gap enters from the left (letters
     dissolve), holds while the waveform plays, then the left ink follows (letters re-form). */
  .w--sound.is-playing .s__txt {
    -webkit-mask-image: linear-gradient(90deg, #000 25%, transparent 28% 72%, #000 75%);
    mask-image: linear-gradient(90deg, #000 25%, transparent 28% 72%, #000 75%);
  }
  @keyframes wave-txt {
    0%       { -webkit-mask-position: 100% 0; mask-position: 100% 0; }
    28%, 72% { -webkit-mask-position: 50% 0; mask-position: 50% 0; }
    100%     { -webkit-mask-position: 0% 0; mask-position: 0% 0; }
  }
  @keyframes wave-bar {
    0%   { opacity: 0; transform: scaleY(0.5); }
    12%  { opacity: 1; transform: scaleY(0.5); }
    32%  { transform: scaleY(var(--a)); }
    50%  { transform: scaleY(var(--b)); }
    68%  { transform: scaleY(calc(var(--a) * 0.75)); }
    86%  { opacity: 1; transform: scaleY(0.5); }
    100% { opacity: 0; transform: scaleY(0.5); }
  }

  /* Cover stub: an ink strip torn off the bottom of the field, holding the location map. */
  .stub {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: stretch;
    margin-inline: calc(var(--space-6) * -1);
    background-color: var(--on-signal);
    background-image: var(--ink-on-ink);
    color: var(--signal);
  }
  .field .stub .lbl { color: color-mix(in srgb, var(--signal) 70%, transparent); }
  .stub__id {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-6);
    border-right: 1px solid color-mix(in srgb, var(--signal) 35%, transparent);
  }
  .stub__place { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; color: var(--signal); margin-bottom: var(--space-1); }
  .stub__clock { font-variant-numeric: tabular-nums; }
  .stub__map { display: block; width: 100%; height: 190px; }
  /* Zoom: Italy at rest, Europe on hover. Registered so the values interpolate. */
  @property --z { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ty { syntax: '<number>'; inherits: true; initial-value: 0; }
  .stub__map { --z: 1; --ty: 0; transition: --z 1100ms cubic-bezier(0.65, 0, 0.35, 1), --ty 1100ms cubic-bezier(0.65, 0, 0.35, 1); cursor: zoom-out; }
  .stub__map:hover { --z: 0.16; --ty: 88; }
  .map__pan { transform: translateY(calc(var(--ty) * 1px)); }
  .map__zoom { transform: scale(var(--z)); }

  .map__grid line { stroke: var(--signal); stroke-opacity: 0.1; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .map__europe, .map__italy { stroke: var(--signal); stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .map__europe { fill: none; stroke-opacity: 0.22; stroke-width: 1; }
  .map__italy { fill: color-mix(in srgb, var(--signal) 8%, transparent); stroke-opacity: 0.9; stroke-width: 1.25; }

  .map__home line, .map__ring, .map__leader { stroke: var(--signal); stroke-width: 1; fill: none; vector-effect: non-scaling-stroke; }
  .map__ring { stroke-dasharray: 2 5; stroke-opacity: 0.35; }
  .map__cross line { stroke-opacity: 0.55; }
  .map__leader { stroke-opacity: 0.6; }
  .map__home rect { fill: var(--signal); }
  .map__label { fill: var(--signal); font-family: var(--f-grotesk); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }

  /* ═══ Boot sequence ═════════════════════════════════════════════════
     Every visit to home. The field powers on like a tube: a point, a line, the plane,
     a flicker. A boot log mounts the three disciplines, the title prints row by row,
     the name is stamped (filled, then hollowed), the stub unfolds and the map locates
     home with a ping. Times are absolute from first paint. */
  .boot { display: none; }
  :global(html.booting) .boot {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: absolute;
    z-index: 3;
    top: 64px;
    left: var(--space-6);
    right: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    pointer-events: none;
    animation: boot-out 1ms linear 2150ms forwards;
  }
  .boot li { display: flex; gap: var(--space-2); align-items: baseline; max-width: 520px; animation: cut-in 140ms steps(6, end) both; animation-delay: calc(950ms + var(--n) * 150ms); }
  .boot li i { flex: 1; border-bottom: 1px dotted currentColor; opacity: 0.5; transform: translateY(-3px); }
  .boot li:last-child span:last-child { animation: caret 0.5s steps(1) infinite; }
  @keyframes boot-out { from, to { visibility: hidden; opacity: 0; } }

  :global(html.booting) .field { animation: power-on 900ms cubic-bezier(0.7, 0, 0.2, 1) both; }
  @keyframes power-on {
    0%   { clip-path: inset(49.6% 50% 49.6% 50%); filter: brightness(2.2); }
    30%  { clip-path: inset(49.6% 0 49.6% 0); filter: brightness(2.2); }
    70%  { clip-path: inset(0 0 0 0); filter: brightness(1); }
    76%  { filter: brightness(0.55); }
    82%  { filter: brightness(1.25); }
    88%  { filter: brightness(0.85); }
    100% { clip-path: inset(0 0 0 0); filter: none; }
  }
  :global(html.booting) .field__top { animation: cut-in 450ms steps(14, end) 850ms both; }
  :global(html.booting) .field__title { animation: rows 520ms steps(3, end) 2200ms both; }
  @keyframes rows { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 -10% 0); } }
  :global(html.booting) .field__word { animation: cut-in 1ms linear 2700ms both; }
  :global(html.booting) .field__word span { animation: cut-in 700ms steps(12, end) 2700ms both, stamp 700ms ease-out 3450ms both; }
  @keyframes stamp { from { color: var(--on-signal); } to { color: transparent; } }

  :global(html.booting) .stub { animation: unfold 450ms cubic-bezier(0.7, 0, 0.2, 1) 3150ms both; }
  @keyframes unfold { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  :global(html.booting) .stub__id > * { animation: cut-in 260ms steps(8, end) both; }
  :global(html.booting) .stub__id > :nth-child(1) { animation-delay: 3450ms; }
  :global(html.booting) .stub__id > :nth-child(2) { animation-delay: 3550ms; }
  :global(html.booting) .stub__id > :nth-child(3) { animation-delay: 3650ms; }
  :global(html.booting) .stub__id > :nth-child(4) { animation-delay: 3750ms; }
  :global(html.booting) .map__reveal { animation: radar 1300ms cubic-bezier(0.3, 0, 0.2, 1) 3700ms both; }
  @keyframes radar { from { clip-path: circle(0% at 50% 50%); } to { clip-path: circle(75% at 50% 50%); } }
  .map__ping { fill: none; stroke: var(--signal); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0; }
  :global(html.booting) .map__ping { animation: ping 1300ms cubic-bezier(0.3, 0, 0.2, 1) 3700ms both; }
  @keyframes ping { 0% { transform: scale(1); opacity: 0.3; } 100% { transform: scale(500); opacity: 0; } }
  :global(html.booting) .map__cross { animation: lock 700ms ease-out 4400ms both; }
  @keyframes lock { from { transform: scale(1.25); opacity: 0; } to { transform: none; opacity: 1; } }
  .map__leader { stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(html.booting) .map__leader { animation: draw 300ms ease-out 5000ms both; }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  :global(html.booting) .map__label { animation: flicker-in 420ms linear 5250ms both; }
  @keyframes flicker-in { 0% { opacity: 0; } 20% { opacity: 0.7; } 35% { opacity: 0.1; } 55% { opacity: 0.9; } 70% { opacity: 0.4; } 100% { opacity: 1; } }

  :global(html.booting) .plate-fig { animation: settle 800ms cubic-bezier(0.2, 0.8, 0.2, 1) 3000ms both; }
  :global(html.booting) .plate-fig__strip i { animation: bit 1ms linear backwards; animation-delay: calc(3600ms + var(--n) * 22ms); }
  @keyframes bit { from, to { visibility: hidden; } }

  /* ═══ System load: the rest of the page ═════════════════════════════
     After the cover has booted, everything else comes up with the site-wide tron-in
     (global.css). Kept quiet on purpose; the cover is the event, this is the system settling. */
  /* Above the fold: queued behind the cover, group by group, item by item. */
  :global(html.booting) .intro > * > * { animation: tron-in 800ms linear both; animation-delay: calc(4700ms + var(--g, 0) * 220ms + var(--k, 0) * 80ms); }
  .intro > :nth-child(2) { --g: 1; }
  .intro > :nth-child(3) { --g: 2; }
  .intro > :nth-child(4) { --g: 3; }
  .intro > * > :nth-child(2) { --k: 1; }
  .intro > * > :nth-child(3) { --k: 2; }
  .intro > * > :nth-child(4) { --k: 3; }
  .intro > * > :nth-child(5) { --k: 4; }
  .intro > * > :nth-child(6) { --k: 5; }
  /* Below the fold the global scroll reveal (global.css) carries the same signal. */

  /* Title card: the name set huge across the bottom of the field. */
  .field__word {
    margin-top: auto;
    margin-inline: calc(var(--space-6) * -1);
    padding-inline: var(--space-6);
    padding-block: 0.06em 0.1em;
    border-top: 1px solid var(--on-signal);
    font-size: calc((100cqw - var(--space-6) * 2) / 6.7);
  }
  /* Outlined: the name as a stencil, the grain showing through. */
  .field__word span {
    display: block;
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: clamp(1px, 0.018em, 2px) var(--on-signal);
    text-transform: uppercase;
    letter-spacing: -0.055em;
    line-height: 1;
    margin-top: -0.02em;
    margin-left: -0.05em;
    white-space: nowrap;
  }
  @keyframes cut-in {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  /* Ink slab: portrait plate. Text here is bg-coloured; secondary is a mix of the two. */
  .plate-fig {
    --slab-2: color-mix(in srgb, var(--bg) 64%, var(--ink));
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .plate-fig .lbl { color: var(--slab-2); }
  .plate-fig__hd { display: flex; justify-content: space-between; border-bottom: 1px solid var(--slab-2); padding-bottom: var(--space-2); }
  .plate-fig :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .plate-fig__cap { display: flex; flex-direction: column; gap: 2px; }
  .plate-fig__cap .data { color: var(--bg); font-size: 15px; }
  .plate-fig__strip {
    display: flex;
    height: 36px;
    margin-top: auto;
  }
  .plate-fig__strip i { flex: 1; }
  .plate-fig__strip i.on { flex: 2; background: var(--bg); }
  .plate-fig__serial { margin-top: calc(var(--space-1) * -1); }

  /* ═══ Intro ═══ */
  .intro {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr) 300px;
    gap: var(--space-8) var(--space-6);
    padding-block: var(--space-10) var(--space-16);
  }
  .intro__aside { display: flex; flex-direction: column; gap: var(--space-1); }
  .intro__aside .data { margin-bottom: var(--space-3); color: var(--ink); }
  .intro__facts { display: flex; gap: var(--space-2); list-style: none; flex-wrap: wrap; }

  .intro__bio { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  .intro__lead { font-size: var(--fs-lead); line-height: 1.4; letter-spacing: -0.012em; color: var(--ink); }
  .intro__body { font-size: var(--fs-body); color: var(--ink-2); padding-top: 3px; }

  .contents { display: flex; flex-direction: column; }
  .contents__hd { padding-bottom: var(--space-2); }
  .contents ol { list-style: none; border-top: 1px solid var(--ink); }
  .contents a {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    min-height: 40px;
    border-bottom: 1px solid var(--rule);
    font-weight: 500;
    font-size: var(--fs-control);
    color: var(--ink);
  }
  .contents a :global(.icon) { color: var(--ink-3); }
  .contents a:hover { color: var(--signal-text); background: var(--hover); }
  .contents a:hover :global(.icon) { color: currentColor; }

  /* Record: the moss growth line (DESIGN.md §9). Moss stays thin and small here. */
  .record { grid-column: 2 / -1; display: flex; flex-direction: column; gap: var(--space-3); }
  .record__hd { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-4); border-top: 1px solid var(--rule); padding-top: var(--space-2); }
  .record__hd > .lbl:first-child { color: var(--moss); }
  .record__key { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; }
  .record__key svg { margin-left: var(--space-2); }
  .growth { display: block; width: 100%; height: auto; overflow: visible; }
  .growth .stem { stroke: var(--moss); stroke-width: 1.25; fill: none; }
  .leaf { fill: var(--moss); stroke: var(--moss); stroke-width: 1; }
  .leaf--post { fill: var(--bg); }
  .growth .bud { fill: var(--bg); stroke: var(--moss); stroke-width: 1; }
  .record__axis {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    list-style: none;
    border-top: 1px solid var(--rule-strong);
    margin-top: calc(var(--space-2) * -1);
  }
  .record__axis li { display: flex; flex-direction: column; align-items: center; gap: 2px; padding-top: var(--space-2); position: relative; }
  .record__axis li::before { content: ""; position: absolute; top: -4px; left: 50%; width: 1px; height: 8px; background: var(--rule-strong); }
  .record__axis .data { color: var(--ink); }

  /* ═══ Patch bay: rack + writing share one coordinate space for patch lines ═══ */
  .patchbay { position: relative; }
  .patch { position: absolute; inset: 0; pointer-events: none; overflow: visible; z-index: 2; }
  .patch :global(path) { fill: none; stroke: var(--signal); stroke-width: 1.5; }
  .patch :global(circle) { fill: var(--signal); }

  /* Rack: modules of one height, widths in columns (flagships 4, others 3). */
  .sec--rack { padding-bottom: var(--space-12); }
  .rack {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 4fr 4fr 3fr 3fr;
    list-style: none;
    border: 1px solid var(--rule-strong);
    margin-top: var(--space-4);
  }
  .mod {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-6) var(--space-5) var(--space-6);
    background-color: var(--surface);
    border-right: 1px solid var(--rule-strong);
