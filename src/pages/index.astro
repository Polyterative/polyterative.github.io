---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const codeProjects = [
  {
    name: 'Poly Highlights',
    description: 'Luminance-corrected syntax highlighting theme for JetBrains IDEs. Carefully calibrated for readability across all token types — 10 stars and counting.',
    repo: 'https://github.com/polyterative/Poly-highlights',
    tags: ['JetBrains', 'Design', 'Tooling'],
  },
  {
    name: 'POLY_REACTIVE_VISUALS',
    description: 'Angular + Three.js + RxJS template for audio-reactive generative visuals. Includes OSC integration for live control from hardware synthesizers.',
    url: 'https://reactive-visuals.vercel.app',
    repo: 'https://github.com/polyterative/POLY_REACTIVE_VISUALS',
    tags: ['Three.js', 'RxJS', 'Creative Coding', 'OSC'],
  },
  {
    name: 'thear',
    description: 'Sonification of AI coding activity. Translates Claude Code hooks into OSC messages for real-time audio feedback in Ableton Live.',
    repo: 'https://github.com/polyterative/thear',
    tags: ['Python', 'Ableton', 'OSC', 'AI'],
  },
  {
    name: 'Angular Reactive p5.js',
    description: 'Clean setup for p5.js sketches inside an Angular + RxJS environment. Separation between sketch logic and application state.',
    url: 'https://reactive-p5.vercel.app',
    repo: 'https://github.com/polyterative/AngularReactiveP5',
    tags: ['p5.js', 'Angular', 'Creative Coding'],
  },
  {
    name: 'Poly Talon Scripts',
    description: 'Custom Talon Voice configuration for voice-driven coding on Mac, Windows, and Linux. My daily driver setup for hands-free development.',
    repo: 'https://github.com/polyterative/Poly-Talon-Scripts',
    tags: ['Voice Coding', 'Python', 'Productivity'],
  },
  {
    name: 'NodeMCU Sensor',
    description: 'Cheap ESP8266 as a temperature/humidity sensor — an early hardware project bridging physical computing and software.',
    repo: 'https://github.com/polyterative/nodemcu-sensor',
    tags: ['Arduino', 'IoT', 'C++'],
  },
  {
    name: 'Zulu',
    description: 'UI experiment exploring layout and interaction patterns. Built with Angular and TypeScript, deployed on Vercel.',
    url: 'https://zulu-3506inbrr-polyterative.vercel.app/',
    repo: 'https://github.com/polyterative/Zulu',
    tags: ['Angular', 'TypeScript', 'UI Experiment'],
  },
];

const soundProjects = [
  {
    name: 'Eurorack / Modular Synthesis',
    description: 'Semi-modular and fully modular synthesis rigs. Active member of Bologna Modulare and Eurorack Italy communities. Patches documented in Patcher.',
    tags: ['Eurorack', 'Modular Synthesis', 'Hardware'],
  },
  {
    name: 'Ableton Live Production',
    description: 'Electronic music production and live performance. Custom effect racks and templates shared openly, bridging software and hardware workflows.',
    repo: 'https://github.com/polyterative/poly-ableton-racks',
    tags: ['Ableton', 'Production', 'Live Performance'],
  },
  {
    name: 'OSC Audio-Visual Bridge',
    description: 'Live performance system connecting Eurorack modular gear to generative visuals via Open Sound Control. Physical knobs modulate on-screen parameters in real time.',
    tags: ['OSC', 'Live Performance', 'Audio-Visual'],
  },
];

const visualProjects = [
  {
    name: 'POLY_REACTIVE_VISUALS',
    description: 'Framework for audio-reactive generative art. Three.js scenes driven by RxJS streams and live OSC from hardware. Open source and forkable.',
    url: 'https://reactive-visuals.vercel.app',
    repo: 'https://github.com/polyterative/POLY_REACTIVE_VISUALS',
    tags: ['Three.js', 'Generative Art', 'Real-time'],
  },
  {
    name: 'Angular + p5.js',
    description: 'Reactive setup for p5.js sketches inside Angular + RxJS. Clean separation of concerns between sketch logic and app state.',
    url: 'https://reactive-p5.vercel.app',
    repo: 'https://github.com/polyterative/AngularReactiveP5',
    tags: ['p5.js', 'Angular', 'Creative Coding'],
  },
  {
    name: 'TouchDesigner',
    description: 'Node-based real-time visual compositions for live VJ sets and audio-reactive installations. Often driven by modular synth via OSC.',
    tags: ['TouchDesigner', 'VJ', 'Real-time'],
  },
];

---

<BaseLayout isHome={true}>
  <!-- Hero -->
  <section class="hero section">
    <div class="container">
      <div class="hero__inner">
        <p class="hero__label">Vlady Yakovenko &nbsp;·&nbsp; Bologna, Italy</p>
        <h1 class="hero__title">UX Engineer.<br />Visual Artist.<br />Electronic Musician.</h1>
        <p class="hero__bio">
          A medium-agnostic creative exploring the intersections of arts, design and code.
          I build software products, compose generative visuals, and perform with modular synthesizers —
          often all at once.
        </p>
        <ul class="hero__links">
          <li><a href="https://github.com/polyterative" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://polyterative.bandcamp.com" target="_blank" rel="noopener">Bandcamp</a></li>
          <li><a href="https://www.instagram.com/politerative/" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="/blog">Writing →</a></li>
          <li><a href="/about">About →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Featured: Patcher -->
  <section class="section" id="patcher">
    <div class="container">
      <div class="featured">
        <div class="featured__badge">
          <span class="tag">Featured Project</span>
          <span class="featured__status">
            <span class="status-dot"></span>
            Active · v5.3.7
          </span>
        </div>

        <div class="featured__body">
          <div class="featured__text">
            <h2 class="featured__title">
              <a href="https://patcher.xyz" target="_blank" rel="noopener">Patcher</a>
            </h2>
            <p class="featured__desc">
              The digital twin workspace for Eurorack musicians. Document patches, plan racks,
              track modules, and keep your real system in sync — all in a fast, clean workflow.
              A free and open-source community tool with a curated public hardware database that
              will always remain free.
            </p>
            <ul class="featured__highlights">
              <li>Patch editor with auto-save, instance-aware patching, and redesigned connection flow</li>
              <li>Rack planner with drag-and-drop placement and auto-scale to fit any viewport</li>
              <li>Live graph layout (FA2) for visualising signal routing complexity</li>
              <li>Module browser with tag filtering — community database, no account needed</li>
              <li>OAuth auth, full mobile support, changelog-driven development since 2021</li>
            </ul>
            <div class="featured__actions">
              <a class="btn" href="https://patcher.xyz" target="_blank" rel="noopener">Open patcher.xyz →</a>
              <a class="btn btn--ghost" href="https://github.com/polyterative/Patcher" target="_blank" rel="noopener">GitHub</a>
              <a class="btn btn--ghost" href="https://docs.patcher.xyz" target="_blank" rel="noopener">Docs</a>
              <a class="btn btn--ghost" href="https://discord.gg/N6Z32xJR" target="_blank" rel="noopener">Discord</a>
            </div>
          </div>

          <div class="featured__stats">
            <div class="stat">
              <span class="stat__number">35</span>
              <span class="stat__label">Stars</span>
            </div>
            <div class="stat">
              <span class="stat__number">3</span>
              <span class="stat__label">Forks</span>
            </div>
            <div class="stat">
              <span class="stat__number">5+</span>
              <span class="stat__label">Years active</span>
            </div>
            <div class="stat">
              <span class="stat__number">∞</span>
              <span class="stat__label">Free forever</span>
            </div>
          </div>
        </div>

        <ul class="featured__tags">
          {['Angular', 'TypeScript', 'Supabase', 'PostgreSQL', 'Eurorack'].map(t => (
            <li><span class="tag">{t}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Skills — compact, links to About for full detail -->
  <section class="section" id="skills">
    <div class="container">
      <header class="section-header">
        <span class="tag">Craft</span>
        <h2 class="section-title">Tools & Skills</h2>
      </header>
      <p class="skills-summary">
        Angular · RxJS · TypeScript · SCSS · Supabase · PostgreSQL
        · Three.js · p5.js · OSC · TouchDesigner
        · Figma · Illustrator · Photoshop
        · Ableton Live · Eurorack · Max for Live
        · Talon Voice · JetBrains IDEs
      </p>
      <a href="/about#tools" class="skills-more">Full tools & experience →</a>
    </div>
  </section>

  <hr class="divider" />

  <!-- Code -->
  <section class="section" id="work">
    <div class="container">
      <header class="section-header">
        <span class="tag">Code</span>
        <h2 class="section-title">Other Projects</h2>
        <p class="section-desc">Open-source tools, creative frameworks, and experiments.</p>
      </header>
      <ul class="project-grid">
        {codeProjects.map(p => (
          <li>
            <ProjectCard {...p} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="divider" />

  <!-- Sound -->
  <section class="section" id="sound">
    <div class="container">
      <header class="section-header">
        <span class="tag">Sound</span>
        <h2 class="section-title">Music & Synthesis</h2>
        <p class="section-desc">Electronic music through modular synthesis, Ableton Live production, and live audio-visual performance.</p>
      </header>
      <ul class="project-grid">
        {soundProjects.map(p => (
          <li>
            <ProjectCard {...p} />
          </li>
        ))}
      </ul>
      <div class="bandcamp-cta">
        <p>Listen to releases on Bandcamp.</p>
        <a class="btn btn--ghost" href="https://polyterative.bandcamp.com" target="_blank" rel="noopener">polyterative.bandcamp.com →</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Visuals -->
  <section class="section" id="visuals">
    <div class="container">
      <header class="section-header">
        <span class="tag">Visuals</span>
        <h2 class="section-title">Generative Art</h2>
        <p class="section-desc">Audio-reactive visuals and generative art built with Three.js, p5.js, and TouchDesigner.</p>
      </header>
      <ul class="project-grid">
        {visualProjects.map(p => (
          <li>
            <ProjectCard {...p} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="divider" />

  <!-- Talks -->
  <section class="section" id="talks">
    <div class="container">
      <header class="section-header">
        <span class="tag">Speaking</span>
        <h2 class="section-title">Public Talks</h2>
      </header>
      <div class="talk-list">
        <article class="talk card">
          <div class="talk__meta">
            <time>2022</time>
          </div>
          <div class="talk__body">
            <h3 class="talk__title">Angular Flex: Building with Style</h3>
            <p class="talk__desc">
              A presentation and workshop on design principles applied to user interfaces, and how to build
              them with Angular Flex Layout. Covered design as a living system — constraints, iteration,
              aesthetics — with a live UI build as the core demo.
            </p>
            <ul class="talk__tags">
              <li><span class="tag">Angular</span></li>
              <li><span class="tag">UI Design</span></li>
              <li><span class="tag">Workshop</span></li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Community -->
  <section class="section" id="community">
    <div class="container">
      <header class="section-header">
        <span class="tag">Community</span>
        <h2 class="section-title">Open & Collaborative</h2>
        <p class="section-desc">Most of what I make is free, open-source, and built in public.</p>
      </header>
      <ul class="community-list">
        <li class="community-item">
          <h3 class="community-item__title">
            <a href="https://discord.gg/N6Z32xJR" target="_blank" rel="noopener">Patcher Discord</a>
          </h3>
          <p class="community-item__desc">The home for Patcher users and Eurorack musicians. Bugs, features, patch discussions, and module questions.</p>
        </li>
        <li class="community-item">
          <h3 class="community-item__title">Bologna Modulare</h3>
          <p class="community-item__desc">Local meetup community for modular synthesis in Bologna. Events, jams, and gear exchange.</p>
        </li>
        <li class="community-item">
          <h3 class="community-item__title">
            <a href="https://www.facebook.com/groups/eurorack.italia" target="_blank" rel="noopener">Eurorack Italy</a>
          </h3>
          <p class="community-item__desc">Largest Italian-language Eurorack community. Module trading, help threads, and performance sharing.</p>
        </li>
        <li class="community-item">
          <h3 class="community-item__title">
            <a href="https://github.com/polyterative" target="_blank" rel="noopener">GitHub — Open Source</a>
          </h3>
          <p class="community-item__desc">All major projects are open source. Pull requests, issues, and forks welcome across all repos.</p>
        </li>
      </ul>
    </div>
  </section>

  <hr class="divider" />

  <!-- Recent Writing -->
  {posts.length > 0 && (
    <section class="section" id="writing">
      <div class="container">
        <header class="section-header">
          <span class="tag">Writing</span>
          <h2 class="section-title">Recent Posts</h2>
        </header>
        <div>
          {posts.map(post => (
            <PostRow
              title={post.data.title}
              date={post.data.date}
              slug={post.id}
              description={post.data.description}
              tags={post.data.tags}
            />
          ))}
        </div>
        <a href="/blog" class="all-posts-link">All posts →</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero { padding-block: var(--space-24); }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__bio {
    font-size: 1.125rem;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 52ch;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    margin-top: var(--space-2);
  }
  .hero__links a {
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    transition: border-color var(--transition);
  }
  .hero__links a:hover { border-color: var(--color-text); }

  /* ── Featured (Patcher) ── */
  .featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    background: var(--color-surface);
  }

  .featured__badge {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .featured__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .featured__body {
    display: flex;
    gap: var(--space-12);
    align-items: flex-start;
  }

  .featured__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .featured__title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
  }
  .featured__title a {
    text-decoration: none;
  }
  .featured__title a:hover { text-decoration: underline; }

  .featured__desc {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 58ch;
  }

  .featured__highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
  }
  .featured__highlights li {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .featured__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .featured__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
    min-width: 80px;
  }
  .stat__number {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stat__label {
    font-size: 0.7rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }

  @media (max-width: 640px) {
    .featured__body { flex-direction: column; }
    .featured__stats { grid-template-columns: repeat(4, 1fr); }
    .featured { padding: var(--space-6); }
  }

  /* ── Buttons ── */
  .btn {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .btn:hover {
    background: transparent;
    color: var(--color-text);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
  }
  .btn--ghost:hover {
    background: var(--color-accent-soft);
  }

  /* ── Skills ── */
  .skills-summary {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 2;
    max-width: none;
  }
  .skills-more {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .skills-more:hover { color: var(--color-text); }

  /* ── Section headers ── */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .section-title { font-size: clamp(1.5rem, 3vw, 2rem); }
  .section-desc {
    color: var(--color-muted);
    font-size: 0.95rem;
    max-width: 55ch;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
    list-style: none;
  }

  /* ── Bandcamp CTA ── */
  .bandcamp-cta {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .bandcamp-cta p {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  /* ── Talks ── */
  .talk-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .talk {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  .talk__meta {
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .talk__body { display: flex; flex-direction: column; gap: var(--space-3); }
  .talk__title { font-size: 1.1rem; }
  .talk__desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: none;
  }
  .talk__tags {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    flex-wrap: wrap;
  }
  @media (max-width: 480px) {
    .talk { grid-template-columns: 1fr; }
  }

  /* ── Writing ── */
  .all-posts-link {
    display: inline-block;
    margin-top: var(--space-6);
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .all-posts-link:hover { color: var(--color-text); }

  /* ── Community ── */
  .community-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }
  .community-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .community-item__title {
    font-size: 1rem;
    font-weight: 600;
  }
  .community-item__title a {
    text-decoration: none;
  }
  .community-item__title a:hover { text-decoration: underline; }
  .community-item__desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    max-width: none;
  }
</style>
