---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { apps } from '../data/apps';
import { releases } from '../data/releases';
import { pad, isoDots, sections, parseStatus, pillClass } from '../lib/datum';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
;

const featuredPostIds = [
  'the-loop-directing-a-swarm-of-agents',
  'impulse-webgpu-generative-visual-engine',
  'home-assistant-infrastructure',
];

const featuredPosts = featuredPostIds
  .map((id) => allPosts.find((post) => post.id === id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

// Post number in the archive (oldest = 001), so the index carries real position.
const postNumber = (id: string) => pad(allPosts.length - allPosts.findIndex((p) => p.id === id), 3);

// Home copy for the selected work. Order = rack order, left to right (flagships first).
const selectedProjects = [
  {
    name: 'Patcher',
    description: 'Founder-built product for Eurorack musicians: patch editor, rack planner, and community module database shaped around a real workflow pain point.',
    url: 'https://patcher.xyz',
    repo: 'https://github.com/polyterative/Patcher',
    details: '/apps/patcher',
    tags: ['Product', 'Angular', 'TypeScript', 'Supabase', 'Open Source'],
    image: '/projects/patcher.jpg',
    featured: true,
  },
  {
    name: 'Kinetip',
    description: 'A native macOS driver that makes a pen tablet a first-class pointing device — absolute positioning and context-aware inertial scrolling, built in Swift.',
    details: '/apps/kinetip',
    tags: ['macOS', 'Swift', 'Realtime', 'Accessibility'],
    featured: true,
  },
  {
    name: 'CostaMeno',
    description: 'Mobile-first utility that turns Italian fuel-price open data into a fast, trustworthy tool with no login, no ads, and no tracking.',
    url: 'https://costameno.vercel.app',
    details: '/apps/costameno',
    tags: ['Next.js', 'TypeScript', 'Open Data', 'Civic Tech'],
  },
  {
    name: 'Impulse',
    description: 'A node-based WebGPU visual engine for live AV performance, built as a transparent TypeScript alternative to opaque proprietary creative tools.',
    details: '/apps/impulse',
    tags: ['WebGPU', 'TypeScript', 'Creative Tooling', 'Systems Design'],
  },
];

// ── Rack modules: every value comes from src/data/apps.ts ──
const fact = (slug: string, label: string) =>
  apps.find((a) => a.slug === slug)?.facts.find((f) => f.label === label)?.value;

const modules = selectedProjects.map((p) => {
  const slug = p.details.replace('/apps/', '');
  const app = apps.find((a) => a.slug === slug)!;
  const status = parseStatus(app.status);
  const writeUp = app.links.find((l) => l.href.startsWith('/blog/'));
  return {
    ...p,
    slug,
    registry: pad(apps.indexOf(app) + 1),
    platform: app.platform,
    status,
    version: fact(slug, 'Current version'),
    since: fact(slug, 'First release'),
    writeUp: writeUp?.href,
    writeUpId: writeUp?.href.replace('/blog/', ''),
  };
});

// A post is patched to a module only when apps.ts links that app to that post.
const relatedApp = (postId: string) =>
  modules.find((m) => m.writeUpId === postId);

// ── Record (growth line): one node per year, one leaf per release or post ──
const chrono = [
  ...releases.map((r) => ({ kind: 'release' as const, date: r.date })),
  ...allPosts.map((p) => ({ kind: 'post' as const, date: p.data.date })),
].sort((a, b) => a.date.localeCompare(b.date));

const y0 = Number(chrono[0].date.slice(0, 4));
const y1 = Math.max(Number(chrono.at(-1)!.date.slice(0, 4)), new Date().getFullYear());
const years = Array.from({ length: y1 - y0 + 1 }, (_, i) => y0 + i);
const byYear = years.map((y) => ({
  year: y,
  items: chrono.filter((c) => Number(c.date.slice(0, 4)) === y),
}));

const GW = 1000;
const GH = 196;
const base = 184;
const r1 = (n: number) => Math.round(n * 10) / 10;
const cx = (i: number) => ((i + 0.5) / years.length) * GW;
const waveY = (x: number) => base - Math.sin((x / GW) * Math.PI * 3) * 4;
let trunk = `M0 ${r1(waveY(0))}`;
for (let i = 1; i <= 80; i++) {
  const x = (i / 80) * GW;
  trunk += ` L${r1(x)} ${r1(waveY(x))}`;
}
const STEP = 11;
const plants = byYear.map((y, i) => {
  const x = cx(i);
  const by = waveY(x);
  const n = y.items.length;
  if (n === 0) return { year: y.year, x: r1(x), y: r1(by), empty: true as const };
  const h = 16 + n * STEP;
  const lean = 7;
  const stem = `M${r1(x)} ${r1(by)} C ${r1(x)} ${r1(by - h * 0.5)}, ${r1(x + lean)} ${r1(by - h * 0.75)}, ${r1(x + lean)} ${r1(by - h)}`;
  const leaves = y.items.map((it, k) => {
    const t = (k + 1) / (n + 0.6);
    const ly = by - 10 - k * STEP;
    const lx = x + lean * t * t;
    const right = k % 2 === 0;
    const d = right
      ? `M${r1(lx)} ${r1(ly)} c 6 -1, 11 -6, 12 -13 c -7 1, -11 6, -12 13 z`
      : `M${r1(lx)} ${r1(ly)} c -6 -1, -11 -6, -12 -13 c 7 1, 11 6, 12 13 z`;
    return { d, kind: it.kind };
  });
  return { year: y.year, empty: false as const, stem, leaves };
});
const releaseCount = releases.length;
const postCount = allPosts.length;

// ── Cover marks ──
const serial = 'PLY-IDX';
const bits = [...serial].flatMap((ch) => [...ch.charCodeAt(0).toString(2).padStart(8, '0')]);
const latestPost = allPosts[0];
const record = [
  { label: 'Posts', value: pad(postCount) },
  { label: 'Apps', value: pad(apps.length) },
  { label: 'Releases', value: pad(releaseCount) },
  { label: 'Since', value: String(y0) },
];

const contents = sections.map((s, i) => ({ ...s, index: pad(i + 1) }));
---

<BaseLayout
  title="Vlady Yakovenko — Notes, work, and ongoing systems"
  description="A personal blog and work archive by Vlady Yakovenko, spanning software, tools, visuals, and technical notes."
  isHome={true}
  serial={serial}
>
  <div class="container container--wide">

    <!-- ── 00 · Cover ── -->
    <section class="cover" aria-labelledby="cover-title">
      <div class="field">
        <div class="field__top">
          <span class="lbl">Vlady Yakovenko · Personal archive</span>
          <span class="lbl">§00 Index · {serial}</span>
        </div>
        <h1 class="field__title" id="cover-title">Designer working across software, visuals, and sound.</h1>
        <dl class="field__rec">
          {record.map((r) => (
            <div>
              <dt class="lbl">{r.label}</dt>
              <dd class="plate">{r.value}</dd>
            </div>
          ))}
        </dl>
        <div class="field__word" aria-hidden="true"><span>Polyterative</span></div>
      </div>

      <figure class="slab plate-fig">
        <div class="plate-fig__hd">
          <span class="lbl">Fig. 01</span>
          <span class="lbl">Portrait</span>
        </div>
        <img
          src="/vlady.jpg"
          alt="Portrait of Vlady Yakovenko, Paris 2023"
          width="1200"
          height="1200"
          loading="eager"
          decoding="async"
        />
        <figcaption class="plate-fig__cap">
          <span class="data">Paris, 2023</span>
          <span class="lbl">Latest entry <time datetime={latestPost.data.date}>{isoDots(latestPost.data.date)}</time></span>
        </figcaption>
        <div class="plate-fig__strip" aria-hidden="true">
          {bits.map((b) => <i class:list={{ on: b === '1' }}></i>)}
        </div>
        <span class="lbl plate-fig__serial">{serial} · {bits.length} bits</span>
      </figure>
    </section>

    <!-- ── Intro: who, what, where to go ── -->
    <section class="intro" aria-label="Introduction">
      <aside class="intro__aside">
        <span class="lbl">Base</span>
        <span class="data">Bologna, Italy</span>
        <span class="lbl">Practice</span>
        <ul class="intro__facts">
          <li class="stat">design</li>
          <li class="stat">code</li>
          <li class="stat">sound</li>
        </ul>
      </aside>
      <div class="intro__bio">
        <p class="intro__lead">
          I work at the intersection of design and engineering: interfaces that hold up structurally and read clearly, built with the same care at the system level as at the pixel level.
        </p>
        <p class="intro__body">
          Years of making music, visuals, and interactive work taught me composition, timing, and systems thinking — and all of it feeds back into how I design software.
        </p>
      </div>
      <nav class="contents" aria-label="Sections">
        <span class="lbl contents__hd">Contents</span>
        <ol>
          {contents.map((s) => (
            <li><a href={s.href}><span class="lbl">{s.index}</span><span class="contents__t">{s.label}</span><Icon name="arrow-right" size={13} /></a></li>
          ))}
          <li><a href="mailto:polyterative@outlook.com"><span class="lbl">Mail</span><span class="contents__t">Email</span><Icon name="mail" size={13} /></a></li>
        </ol>
      </nav>

      <div class="record">
        <div class="record__hd">
          <span class="lbl">Record · {y0}–{y1}</span>
          <span class="data">{releaseCount} releases and {postCount} posts, one leaf each</span>
          <span class="record__key lbl" aria-hidden="true">
            <svg width="10" height="12" viewBox="0 0 12 14"><path class="leaf" d="M0 14 c 6 -1, 11 -6, 12 -13 c -7 1, -11 6, -12 13 z" /></svg>Release
            <svg width="10" height="12" viewBox="0 0 12 14"><path class="leaf leaf--post" d="M0 14 c 6 -1, 11 -6, 12 -13 c -7 1, -11 6, -12 13 z" /></svg>Post
          </span>
        </div>
        <svg class="growth" viewBox={`0 0 ${GW} ${GH}`} role="img" aria-labelledby="growth-desc">
          <desc id="growth-desc">Releases and posts per year, {y0} to {y1}: {byYear.map((y) => `${y.year}: ${y.items.length}`).join(', ')}.</desc>
          <path class="stem" d={trunk} vector-effect="non-scaling-stroke" />
          {plants.map((p) => p.empty
            ? <circle class="bud" cx={p.x} cy={p.y} r="3" vector-effect="non-scaling-stroke" />
            : <>
                <path class="stem" d={p.stem} vector-effect="non-scaling-stroke" />
                {p.leaves.map((l) => <path class:list={['leaf', { 'leaf--post': l.kind === 'post' }]} d={l.d} vector-effect="non-scaling-stroke" />)}
              </>
          )}
        </svg>
        <ol class="record__axis" style={`--n:${years.length}`}>
          {byYear.map((y) => (
            <li>
              <span class="lbl">{y.year}</span>
              <span class="data">{y.items.length}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="patchbay" data-patchbay>

      <!-- ── 01 · Selected work, as a rack ── -->
      <section class="sec sec--rack" id="work">
        <header class="sec__head">
          <span class="plate sec__idx">01</span>
          <h2 class="sec__title">A few things I've made</h2>
          <span class="lbl">{selectedProjects.length} of {apps.length} applications</span>
        </header>
        <div class="sec__body">
          <p class="sec__intro">
            Not a complete list. Just a few recurring artifacts — each with its full story in the applications gallery.
          </p>
        </div>

        <ul class="rack">
          {modules.map((m) => (
            <li class:list={['mod', { 'mod--wide': m.featured }]}>
              <i class="screw tl" aria-hidden="true"></i><i class="screw tr" aria-hidden="true"></i>
              <i class="screw bl" aria-hidden="true"></i><i class="screw br" aria-hidden="true"></i>

              <div class="mod__hd">
                <span class="mod__reg"><span class="plate">{m.registry}</span><span class="lbl">/{pad(apps.length)}</span></span>
                <span class={pillClass(m.status.tone)}>{m.status.head}</span>
              </div>

              <h3 class="mod__name"><a href={m.details}>{m.name}</a></h3>
              <p class="mod__desc">{m.description}</p>

              <dl class="mod__specs">
                <div><dt class="lbl">Platform</dt><dd class="data">{m.platform}</dd></div>
                {m.version && <div><dt class="lbl">Ver</dt><dd class="data">{m.version}</dd></div>}
                {m.since && <div><dt class="lbl">Since</dt><dd class="data">{m.since}</dd></div>}
                {m.status.rest && <div class="mod__state"><dt class="lbl">Stat</dt><dd class="data">{m.status.rest}</dd></div>}
              </dl>

              <ul class="taglist mod__tags">{m.tags.map((t) => <li>{t}</li>)}</ul>

              <div class="mod__jacks">
                {m.url && (
                  <a class="jack" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name}: open ${new URL(m.url).host} (new tab)`}>
                    <span class="lbl">Url</span><i aria-hidden="true"></i>
                  </a>
                )}
                {m.repo && (
                  <a class="jack" href={m.repo} target="_blank" rel="noopener" aria-label={`${m.name}: source on GitHub (new tab)`}>
                    <span class="lbl">Src</span><i aria-hidden="true"></i>
                  </a>
                )}
                {m.writeUp && (
                  <a class="jack" href={m.writeUp} aria-label={`${m.name}: read the write-up`}>
                    <span class="lbl">Doc</span><i aria-hidden="true" data-patch-from={m.writeUpId}></i>
                  </a>
                )}
                <a class="jack jack--out" href={m.details} aria-label={`${m.name}: full story`}>
                  <span class="inv">Out</span><i aria-hidden="true"></i>
                </a>
              </div>
            </li>
          ))}
        </ul>

        <div class="more sec__more">
          <a href="/apps" class="btn btn--primary">Browse the applications<Icon name="arrow-right" size={14} /></a>
          <a href="/projects" class="act">See the full archive<Icon name="arrow-right" size={13} /></a>
        </div>
      </section>

      <!-- ── 02 · Featured writing ── -->
      {featuredPosts.length > 0 && (
        <section class="sec" id="writing">
          <header class="sec__head">
            <span class="plate sec__idx">02</span>
            <h2 class="sec__title">Writing</h2>
            <span class="lbl">{featuredPosts.length} of {allPosts.length} posts</span>
          </header>
          <div class="sec__body">
            <p class="sec__intro">A few places to begin.</p>
            <ol class="entries">
              {featuredPosts.map((post) => {
                const rel = relatedApp(post.id);
                return (
                  <li class="entry">
                    <div class="entry__no">
                      <span class="lbl">No.</span>
                      <span class="plate">{postNumber(post.id)}</span>
                    </div>
                    <div class="entry__body">
                      <time class="data entry__date" datetime={post.data.date}>{isoDots(post.data.date)}</time>
                      <h3 class="entry__title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                      {post.data.description && <p class="entry__desc">{post.data.description}</p>}
                      {post.data.tags.length > 0 && <ul class="taglist">{post.data.tags.map((t) => <li>{t}</li>)}</ul>}
                    </div>
                    <div class="entry__rel">
                      {rel && (
                        <a class="jack jack--in" href={rel.details} aria-label={`Related app: ${rel.name}`}>
                          <span class="lbl">App · {rel.name}</span><i aria-hidden="true" data-patch-to={post.id}></i>
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
            <div class="more"><a href="/blog" class="act">All posts<Icon name="arrow-right" size={13} /></a></div>
          </div>
        </section>
      )}

      <svg class="patch" aria-hidden="true"></svg>
    </div>

  </div>
</BaseLayout>

<script>
  // Patch lines: one curved hairline per real app ↔ post link (apps.ts `links`),
  // drawn between the two jack rings. Recomputed on resize; hidden on narrow screens.
  function drawPatches() {
    const bay = document.querySelector<HTMLElement>('[data-patchbay]');
    const svg = bay?.querySelector<SVGSVGElement>('svg.patch');
    if (!bay || !svg) return;
    svg.innerHTML = '';
    if (!window.matchMedia('(min-width: 900px)').matches) return;
    const bb = bay.getBoundingClientRect();
    svg.setAttribute('width', String(bb.width));
    svg.setAttribute('height', String(bb.height));
    svg.setAttribute('viewBox', `0 0 ${bb.width} ${bb.height}`);
    const centre = (el: Element) => {
      const r = el.getBoundingClientRect();
      return [r.left - bb.left + r.width / 2, r.top - bb.top + r.height / 2];
    };
    const ns = 'http://www.w3.org/2000/svg';
    bay.querySelectorAll('[data-patch-from]').forEach((from) => {
      const key = from.getAttribute('data-patch-from');
      const to = bay.querySelector(`[data-patch-to="${key}"]`);
      if (!to) return;
      const [x1, y1] = centre(from);
      const [x2, y2] = centre(to);
      const dy = Math.max(60, (y2 - y1) * 0.55);
      const path = document.createElementNS(ns, 'path');
      path.setAttribute('d', `M${x1} ${y1} C ${x1} ${y1 + dy}, ${x2} ${y2 - dy}, ${x2} ${y2}`);
      svg.appendChild(path);
      for (const [x, y] of [[x1, y1], [x2, y2]]) {
        const dot = document.createElementNS(ns, 'circle');
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', String(y));
        dot.setAttribute('r', '3.5');
        svg.appendChild(dot);
      }
    });
  }
  drawPatches();
  window.addEventListener('resize', drawPatches);
  document.fonts?.ready.then(drawPatches);
  window.addEventListener('load', drawPatches);
</script>

<style>
  /* ═══ Cover ═══════════════════════════════════════════════════════════
     The one loud surface: a signal field with ink grain (DESIGN.md §14),
     butted against an ink slab. Nothing on the field gets another colour. */
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    margin-top: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 580px;
    padding: var(--space-3) var(--space-6) 0;
    overflow: hidden;
    container-type: inline-size;
    background-color: var(--signal);
    background-image: var(--ink-on-fill);
    background-size: 220px 220px;
    color: var(--on-signal);
  }
  .field .lbl { color: var(--on-signal); }

  .field__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--on-signal);
  }

  .field__title {
    margin-top: clamp(var(--space-8), 6cqw, var(--space-16));
    font-size: clamp(2.4rem, 10cqw, 6.6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.05em;
    max-width: 9.6em;
    text-wrap: balance;
  }

  .field__rec {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: auto;
    padding-top: var(--space-10);
  }
  .field__rec > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3) var(--space-3) var(--space-3);
    border-top: 1px solid var(--on-signal);
    border-left: 1px solid var(--on-signal);
  }
  .field__rec > div:first-child { border-left: 0; padding-left: 0; }
  .field__rec dd { font-size: clamp(28px, 5cqw, 44px); }

  /* Title card: the name set huge, cropped by the bottom edge of the field. */
  .field__word {
    margin-inline: calc(var(--space-6) * -1);
    padding-inline: var(--space-6);
    border-top: 1px solid var(--on-signal);
    height: 0.6em;
    font-size: 14.6cqw;
    overflow: hidden;
  }
  .field__word span {
    display: block;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.055em;
    line-height: 1;
    margin-top: -0.02em;
    margin-left: -0.05em;
    white-space: nowrap;
    animation: cut-in 180ms steps(4, end) 120ms both;
  }
  @keyframes cut-in {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  /* Ink slab: portrait plate. Text here is bg-coloured; secondary is a mix of the two. */
  .plate-fig {
    --slab-2: color-mix(in srgb, var(--bg) 64%, var(--ink));
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .plate-fig .lbl { color: var(--slab-2); }
  .plate-fig__hd { display: flex; justify-content: space-between; border-bottom: 1px solid var(--slab-2); padding-bottom: var(--space-2); }
  .plate-fig img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .plate-fig__cap { display: flex; flex-direction: column; gap: 2px; }
  .plate-fig__cap .data { color: var(--bg); font-size: 15px; }
  .plate-fig__strip {
    display: flex;
    height: 36px;
    margin-top: auto;
  }
  .plate-fig__strip i { flex: 1; }
  .plate-fig__strip i.on { flex: 2; background: var(--bg); }
  .plate-fig__serial { margin-top: calc(var(--space-1) * -1); }

  /* ═══ Intro ═══ */
  .intro {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr) 300px;
    gap: var(--space-8) var(--space-6);
    padding-block: var(--space-10) var(--space-16);
  }
  .intro__aside { display: flex; flex-direction: column; gap: var(--space-1); }
  .intro__aside .data { margin-bottom: var(--space-3); color: var(--ink); }
  .intro__facts { display: flex; gap: var(--space-2); list-style: none; flex-wrap: wrap; }

  .intro__bio { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  .intro__lead { font-size: var(--fs-lead); line-height: 1.4; letter-spacing: -0.012em; color: var(--ink); }
  .intro__body { font-size: var(--fs-body); color: var(--ink-2); padding-top: 3px; }

  .contents { display: flex; flex-direction: column; }
  .contents__hd { padding-bottom: var(--space-2); }
  .contents ol { list-style: none; border-top: 1px solid var(--ink); }
  .contents a {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    min-height: 40px;
    border-bottom: 1px solid var(--rule);
    font-weight: 500;
    font-size: var(--fs-control);
    color: var(--ink);
  }
