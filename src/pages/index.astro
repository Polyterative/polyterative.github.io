---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const projects = [
  {
    name: 'Poly Highlights',
    description: 'Luminance-corrected syntax highlighting for JetBrains IDEs.',
    repo: 'https://github.com/polyterative/Poly-highlights',
    tags: ['JetBrains', 'Design', 'Tooling'],
  },
  {
    name: 'POLY_REACTIVE_VISUALS',
    description: 'Angular + Three.js + RxJS scaffold for audio-reactive generative visuals with OSC support.',
    url: 'https://reactive-visuals.vercel.app',
    repo: 'https://github.com/polyterative/POLY_REACTIVE_VISUALS',
    tags: ['Three.js', 'RxJS', 'OSC'],
  },
  {
    name: 'thear',
    description: 'Translates Claude Code activity into real-time OSC messages for Ableton Live.',
    repo: 'https://github.com/polyterative/thear',
    tags: ['Python', 'OSC', 'AI'],
  },
  {
    name: 'Poly Talon Scripts',
    description: 'Talon Voice configuration for hands-free coding across JetBrains, terminal, and browser.',
    repo: 'https://github.com/polyterative/Poly-Talon-Scripts',
    tags: ['Voice Coding', 'Python', 'Talon'],
  },
];
---

<BaseLayout isHome={true}>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero__label">Vlady Yakovenko &nbsp;·&nbsp; Bologna, Italy</p>
      <h1 class="hero__title">UX Engineer.<br />Visual Artist.<br />Electronic Musician.</h1>
      <p class="hero__bio">
        Medium-agnostic creative at the intersection of software, generative art, and modular synthesis.
      </p>
      <ul class="hero__links">
        <li><a href="/projects">Projects →</a></li>
        <li><a href="/blog">Writing →</a></li>
        <li><a href="/about">About →</a></li>
      </ul>
    </div>
  </section>

  <hr class="divider" />

  <!-- Patcher -->
  <section class="section" id="patcher">
    <div class="container">
      <div class="featured">
        <div class="featured__header">
          <span class="tag">Featured project</span>
          <span class="featured__status">
            <span class="status-dot"></span>Active · v5.3.7
          </span>
        </div>

        <div class="featured__body">
          <div class="featured__text">
            <h2 class="featured__title">
              <a href="https://patcher.xyz" target="_blank" rel="noopener">Patcher</a>
            </h2>
            <p class="featured__desc">
              A free, open-source workspace for Eurorack musicians — patch editor, rack planner,
              and community module database in one place.
            </p>
            <ul class="featured__bullets">
              <li>Auto-save patch editor with instance-aware connection flow</li>
              <li>Drag-and-drop rack planner, FA2 signal graph, tag-filtered module browser</li>
              <li>Public database — no account needed to browse</li>
            </ul>
            <div class="featured__actions">
              <a class="btn" href="https://patcher.xyz" target="_blank" rel="noopener">Open app →</a>
              <a class="btn btn--ghost" href="https://github.com/polyterative/Patcher" target="_blank" rel="noopener">GitHub</a>
              <a class="btn btn--ghost" href="https://discord.gg/N6Z32xJR" target="_blank" rel="noopener">Discord</a>
            </div>
          </div>

          <div class="featured__stats">
            <div class="stat">
              <span class="stat__number">35</span>
              <span class="stat__label">Stars</span>
            </div>
            <div class="stat">
              <span class="stat__number">5+</span>
              <span class="stat__label">Years</span>
            </div>
            <div class="stat">
              <span class="stat__number">∞</span>
              <span class="stat__label">Free</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Other projects -->
  <section class="section" id="work">
    <div class="container">
      <header class="section-header">
        <span class="tag">Code</span>
        <h2>Other projects</h2>
      </header>
      <ul class="project-grid">
        {projects.map(p => <li><ProjectCard {...p} /></li>)}
      </ul>
      <a href="/projects" class="more-link">All projects →</a>
    </div>
  </section>

  <hr class="divider" />

  <!-- Recent writing -->
  {posts.length > 0 && (
    <section class="section" id="writing">
      <div class="container">
        <header class="section-header">
          <span class="tag">Writing</span>
          <h2>Recent posts</h2>
        </header>
        {posts.map(post => (
          <PostRow
            title={post.data.title}
            date={post.data.date}
            slug={post.id}
            description={post.data.description}
            tags={post.data.tags}
          />
        ))}
        <a href="/blog" class="more-link">All posts →</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-16);
  }
  .hero__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
  }
  .hero__bio {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 46ch;
    margin-bottom: var(--space-6);
  }
  .hero__links {
    display: flex;
    gap: var(--space-6);
    list-style: none;
  }
  .hero__links a {
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    transition: border-color var(--transition);
  }
  .hero__links a:hover { border-color: var(--color-text); }

  /* Section */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .section-header h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
  }

  /* Featured */
  .featured {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .featured__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .featured__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .featured__body {
    display: flex;
    gap: var(--space-12);
    align-items: flex-start;
  }
  .featured__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .featured__title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
  }
  .featured__title a { text-decoration: none; }
  .featured__title a:hover { text-decoration: underline; }
  .featured__desc {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 52ch;
  }
  .featured__bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
  }
  .featured__bullets li {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .featured__stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    min-width: 72px;
    text-align: center;
  }
  .stat__number {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .stat__label {
    font-size: 0.65rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: var(--space-1);
  }
  @media (max-width: 600px) {
    .featured { padding: var(--space-6); }
    .featured__body { flex-direction: column; }
    .featured__stats {
      flex-direction: row;
      gap: var(--space-3);
    }
  }

  /* Buttons */
  .btn {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
    transition: background var(--transition), color var(--transition);
  }
  .btn:hover { background: transparent; color: var(--color-text); }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
  }
  .btn--ghost:hover { background: var(--color-accent-soft); }

  /* Projects grid */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-4);
    list-style: none;
  }

  /* More link */
  .more-link {
    display: inline-block;
    margin-top: var(--space-6);
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .more-link:hover { color: var(--color-text); }
</style>
