---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Vlady Yakovenko"
  description="This page doesn't exist."
>
  <section class="section notfound">
    <div class="container">
      <p class="notfound__code">404</p>
      <h1 class="notfound__title">Page not found</h1>
      <p class="notfound__desc">This URL doesn't exist. Maybe it moved, or was never here.</p>
      <a href="/" class="notfound__link">← Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-24);
    display: flex;
    align-items: center;
  }
  .notfound__code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }
  .notfound__title {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }
  .notfound__desc {
    color: var(--color-muted);
    font-size: 1rem;
    margin-bottom: var(--space-8);
  }
  .notfound__link {
    font-size: 0.9rem;
    color: var(--color-muted);
    transition: color var(--transition);
  }
  .notfound__link:hover { color: var(--color-text); }
</style>
