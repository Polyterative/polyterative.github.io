---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Page not found — Vlady Yakovenko"
  description="This page doesn't exist."
>
  <div class="container">
    <section class="notfound">
      <p class="label">Error 404</p>
      <h1 class="notfound__title">Page not found</h1>
      <p class="notfound__desc">This URL doesn't exist. Maybe it moved, or was never here.</p>
      <a href="/" class="notfound__link iclink"><Icon name="arrow-left" size={13} />Back to home</a>
    </section>
  </div>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-24);
    min-height: 40vh;
    justify-content: center;
  }
  .notfound__title { font-size: clamp(2rem, 5vw, 3rem); }
  .notfound__desc { color: var(--color-muted); }
  .notfound__link {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
    margin-top: var(--space-2);
  }
  .notfound__link:hover { color: var(--color-text); }
  .notfound__link .icon { color: var(--color-faint); }
  .notfound__link:hover .icon { color: var(--color-accent); }
</style>
